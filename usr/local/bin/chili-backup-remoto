#!/usr/bin/env bash
# -*- coding: utf-8 -*-
# shellcheck shell=bash disable=SC1091,SC2039,SC2166,SC2034
#
#  chili-backup-remote
#  chili-backup-remoto.sh — Backup de servidor remoto/local via rsync + SSH
#  Uso: ./chili-backup-remoto.sh [opções] [ORIGEM [DESTINO]]
#
#  Created: sáb 22 ago 2026 08:03:36 -04
#  Updated: sáb 22 ago 2026 08:03:36 -04
