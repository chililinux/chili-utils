MNT_TMP="/mnt/$APP-$(date +'%H%M%S')"
HAS_UEFI=false
HAS_MBR=false
GRUB_FILE_EFI=""
CHANGE_GUID=false
IS_GUID_DUPLICADO=false
BOOTLOADER="grub"                              # grub | limine
LIMINE_EFI_SRC="/usr/share/limine/BOOTX64.EFI" # .efi instalado pelo pacote limine
LIMINE_FILE_EFI=""

