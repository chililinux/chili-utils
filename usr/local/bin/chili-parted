#sd=$1
#parted --script $sd -- 															\
#   mklabel gpt             													\
#   mkpart primary fat32      1MiB   100MiB set 1 bios on name 1 BIOS  \
#   mkpart primary fat32      100MiB 200MiB set 2 esp  on name 2 EFI   \
#   mkpart primary linux-swap 200MiB 2GB                  name 3 SWAP  \
#   mkpart primary ext4       2GB 100%                    name 4 ROOT  \
#   align-check optimal 1
#parted --script $sd -- print

#Partição 	Sistema de arquivo 	Tamanho 	Descrição
#/dev/sda1 	(bootloader) 	2M 	Partição de boot BIOS
#/dev/sda1 	ext2 (ou FAT32 se UEFI está sendo usada) 	128M 	Partição boot/Sistema EFI
#/dev/sda3 	(swap) 	512M ou maior 	Partição de swap
#/dev/sda4 	ext4 	Resto do disco 	Partição root

function sh_checkroot() {
	if [ "$(id -u)" != "0" ]; then
		printf "${red} $(gettext "erro: você não pode executar esta operação a menos que seja root!")\n"
		exit 1
	fi
}

function sh_oninterrupt() {
	printf "\n${red}$(gettext "Interrompido pelo usuário! O disco pode ter ficado em estado inconsistente.")${reset}\n"
	printf "${yellow}$(gettext "Verifique com 'fdisk -l' ou 'parted print' antes de prosseguir.")${reset}\n"
	exit 130
}
trap sh_oninterrupt INT TERM

sh_setvarcolors
sh_checkdeps || exit 1
if [[ $# -eq 0 ]]; then
	printf '%s\n' "${orange}${APP}$(gettext " - utilitario para particionar disco")${reset}"
	printf '%s\n' "${red}$(gettext "Uso:")${reset}"
	printf '\t%s\n' "${APP} ${yellow}/dev/sdX${reset}"
	printf '\t%s\n' "${APP} ${yellow}image.img${reset}"
	exit 1
fi

function sh_parted() {
	local error=false
	local sd="$1"

	if [[ -z "$sd" ]]; then
		printf "${red}$(gettext "Erro: nenhum dispositivo/imagem informado!")${reset}\n"
		return 1
	fi

	if ! fdisk -l "$sd" &>/dev/null; then
		printf "${red}$(gettext "Erro: dispositivo/arquivo '\$sd' não encontrado ou inválido!")${reset}\n"
		return 1
	fi

	# smartctl só faz sentido em dispositivo de bloco real, não em arquivo de imagem
	if [[ -b "$sd" ]]; then
		if ! smartctl -Hi "$sd"; then
			error=true
		fi
	fi

	fdisk -l "$sd"

	if $error; then
		echo "===========================================================================${reset}"
		printf "${cyan}$(gettext "AVISO! disco $sd NÃO PASSOU no teste de SMART!")${reset}\n"
		echo "===========================================================================${reset}"
	fi

	printf "${yellow}$(gettext "AVISO, CUIDADO, tudo será apagado!!")${reset}\n"
	printf "${red}$(gettext "Digite exatamente ${cyan}$sd${red} para confirmar a destruição dos dados: ")${reset}"
	read -r confirm_sd
	if [[ "$confirm_sd" != "$sd" ]]; then
		printf "${red}$(gettext "Confirmação não confere. Operação cancelada.")${reset}\n"
		return 1
	fi

	if conf "$(gettext "Continuar com o particionamento?")"; then
		if ! wipefs -a "$sd"; then
			printf "${red}$(gettext "Erro: falha ao limpar assinaturas de '$sd'")${reset}\n"
			return 1
		fi
		if ! sgdisk --zap-all "$sd"; then
			printf "${red}$(gettext "Erro: falha ao zerar a tabela de partições de '$sd'")${reset}\n"
			return 1
		fi
		if ! parted --align=opt --script "$sd" -- \
			mklabel gpt \
			mkpart primary 2MiB 4MiB \
			set 1 bios_grub on name 1 BIOS \
			mkpart primary fat32 4MiB 132MiB \
			set 2 esp on name 2 EFI \
			mkpart primary ext4 132MiB 100% \
			name 3 ROOT; then
			printf "${red}$(gettext "Erro: falha ao particionar '$sd'")${reset}\n"
			return 1
		fi
		parted --script "$sd" -- print
	fi
}

if [[ $# -gt 1 ]]; then
	printf "${red}$(gettext "Erro: argumentos demais. Informe apenas um dispositivo ou imagem.")${reset}\n"
	printf '\t%s\n' "${APP} ${yellow}/dev/sdX${reset}"
	exit 1
fi

sh_checkroot "$@"
sh_parted "$@"

