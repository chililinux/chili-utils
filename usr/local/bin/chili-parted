#export LANGUAGE=pt_BR
export TEXTDOMAINDIR=/usr/share/locale
export TEXTDOMAIN=chili-parted

#debug
export PS4='${red}${0##*/}${green}[$FUNCNAME]${pink}[$LINENO]${reset}'
#set -x
#set -e
shopt -s extglob

#system
declare APP="${0##*/}"
declare _VERSION_="1.6.06-20260806"
declare DEPENDENCIES=(losetup tput parted kpartx smartctl qemu-img sgdisk wipefs)
declare DEPPACKAGES=(util-linux ncurses parted multipath-tools smartmontools qemu-img gdisk)


# gettext.sh fornece as funções shell gettext/gettext/ngettext
if [[ ! -r /usr/bin/gettext.sh ]]; then
  # fallback: sem gettext.sh disponível, funções viram passthrough (sem tradução)
  function gettext() { printf '%s' "$1"; }
  function gettext() { eval "printf '%s' \"$1\""; }
fi

function conf() {
	read -r -p "$1 [Y/n] "
	[[ -z "$REPLY" ]] && return 0
	[[ "${REPLY^^}" == N* ]] && return 1 || return 0
}

function has_command() {
	command -v "$1" >/dev/null && return 0 || return 1
}

function sh_checkdeps() {
	local missing=()
	local i
	for i in "${!DEPENDENCIES[@]}"; do
		if ! has_command "${DEPENDENCIES[$i]}"; then
			missing+=("${DEPENDENCIES[$i]} (${DEPPACKAGES[$i]:-?})")
		fi
	done
	if ((${#missing[@]} > 0)); then
		printf '%s\n' "${red}$(gettext "Erro: dependências ausentes:")${reset}"
		local dep
		for dep in "${missing[@]}"; do
			printf '\t%s\n' "${yellow}${dep}${reset}"
		done
		return 1
	fi
	return 0
}

function sh_setvarcolors() {
	# does the terminal support true-color?
	if has_command "tput"; then
		#tput setaf 127 | cat -v  #capturar saida
		reset=$(tput sgr0)
		rst=$(tput sgr0)
		bold=$(tput bold)
		underline=$(tput smul)
		nounderline=$(tput rmul)
		reverse=$(tput rev)

		black=$(tput bold)$(tput setaf 0)
		red=$(tput bold)$(tput setaf 196)
		green=$(tput bold)$(tput setaf 2)
		yellow=$(tput bold)$(tput setaf 3)
		#       blue=$(tput setaf 4)
		blue=$(tput setaf 27)
		magenta=$(tput setaf 5)
		cyan=$(tput setaf 6)
		white=$(tput setaf 7)
		gray=$(tput setaf 8)
		light_red=$(tput setaf 9)
		light_green=$(tput setaf 10)
		light_yellow=$(tput setaf 11)
		light_blue=$(tput setaf 12)
		light_magenta=$(tput setaf 13)
		light_cyan=$(tput setaf 14)
		light_white=$(tput setaf 15)
		orange=$(tput setaf 202)
		purple=$(tput setaf 125)
		violet=$(tput setaf 61)
		pink=$(tput setaf 213)

		# Definir cores de fundo
		preto=$(tput setab 0)
		vermelho=$(tput setab 196)
		verde=$(tput setab 2)
		amarelo=$(tput setab 3)
		azul=$(tput setab 20)
		roxo=$(tput setab 5)
		ciano=$(tput setab 6)
		branca="${black}$(tput setab 7)"
		cinza=$(tput setab 8)
		laranja=$(tput setab 202)
		roxa=$(tput setab 125)
		violeta=$(tput setab 61)
	else
		bold=''
		reset="\e[0m"
		rst="\e[0m"
		underline="\e[4m"
		nounderline="\e[24m"
		reverse="\e[7m"

		blue="\e[1;34m"
		cyan="\e[1;36m"
		green="\e[1;32m"
		orange="\e[1;33m"
		red="\e[1;31m"
		white="\e[1;37m"
		yellow="\e[1;33m"
		pink="\033[35;1m"
		black="\e[1;30m"
		purple="\e[1;35m"
		violet="\e[1;35m"
		magenta="\e[1;35m"
		gray="\e[1;30m"
		light_red="\e[1;91m"
		light_green="\e[1;92m"
		light_yellow="\e[1;93m"
		light_blue="\e[1;94m"
		light_magenta="\e[1;95m"
		light_cyan="\e[1;96m"
		light_white="\e[1;97m"

		# Cores de fundo (sem tput)
		preto="\e[40m"
		vermelho="\e[41m"
		verde="\e[42m"
		amarelo="\e[43m"
		azul="\e[44m"
		roxo="\e[45m"
		ciano="\e[46m"
		branca="\e[1;30m\e[47m"
		cinza="\e[100m"
		laranja="\e[43m"
		roxa="\e[45m"
		violeta="\e[45m"
	fi
}

function chili-image() {
	# https://www.qemu.org/2021/08/22/fuse-blkexport/
	qemu-img create -f raw foo.img 20G
	parted -s foo.img \
		'mklabel msdos' \
		'mkpart primary ext4 2048s 100%'
	qemu-img convert -p -f raw -O qcow2 foo.img foo.qcow2 && rm foo.img
	file foo.qcow2
	kpartx -l foo.qcow2

	#	qemu-storage-daemon \
	#    --blockdev node-name=prot-node,driver=file,filename=foo.qcow2 \
	#    --blockdev node-name=fmt-node,driver=qcow2,file=prot-node \
	#    --export \
	#    type=fuse,id=exp0,node-name=fmt-node,mountpoint=foo.qcow2,writable=on \
	#    &

	qemu-storage-daemon \
		--blockdev node-name=prot-node,driver=file,filename=foo.qcow2 \
		--blockdev node-name=fmt-node,driver=qcow2,file=prot-node \
		--export \
		type=fuse,id=exp0,node-name=fmt-node,mountpoint=mount-point,writable=on

	file foo.qcow2
	sudo kpartx -av foo.qcow2
	fdisk -l foo.qcow2
	cfdisk foo.qcow2
}

