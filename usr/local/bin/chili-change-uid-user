# remapeia UID/GID de um usuário com segurança
# Uso: fix-uid.sh -u USUARIO -n NOVO_UID [-g NOVO_GID] [-y] [-n-color]
# Testado para funcionar em sh/bash
#
# Substitui a sequência manual:
#   pkill -u USUARIO
#   usermod -u NOVO_UID USUARIO
#   groupmod -g NOVO_GID grupo
#   chown -R --from=UID_ANTIGO:GID_ANTIGO NOVO_UID:NOVO_GID /home/USUARIO
