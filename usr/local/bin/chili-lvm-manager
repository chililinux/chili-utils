export TEXTDOMAINDIR=/usr/share/locale
export TEXTDOMAIN=chili-lvm-manager

#debug
export PS4='${red}${0##*/}${green}[$FUNCNAME]${pink}[$LINENO]${reset}'
#set -x
shopt -s extglob
set -o pipefail

#system
declare APP="${0##*/}"
declare _VERSION_="0.04.00-20260826"
declare APPDESC="Gerenciador de VMs em LVM thin provisioning"


# ===================================================================
# Framework (cores, log, root, dependências)
# ===================================================================

sh_check_terminal() { [ ! -t 1 ] && use_color=false; }

set_varcolors() {
	sh_check_terminal
	if [[ -n "$(command -v "tput")" ]]; then
		: "${black=$(tput bold)$(tput setaf 0)}"
		: "${red=$(tput bold)$(tput setaf 196)}"
		: "${green=$(tput bold)$(tput setaf 2)}"
		: "${yellow=$(tput bold)$(tput setaf 3)}"
		: "${blue=$(tput setaf 27)}"
		: "${pink=$(tput setaf 5)}"
		: "${magenta=$(tput setaf 5)}"
		: "${cyan=$(tput setaf 6)}"
		: "${white=$(tput setaf 7)}"
		: "${gray=$(tput setaf 8)}"
		: "${orange=$(tput setaf 202)}"
		: "${purple=$(tput setaf 125)}"

		: "${reset=$(tput sgr0)}"
		: "${rst=$(tput sgr0)}"
		: "${bold=$(tput bold)}"
		: "${underline=$(tput smul)}"
		: "${nounderline=$(tput rmul)}"
		: "${reverse=$(tput rev)}"

		: "${clrkey=${white}}"
		: "${TICK="${clrkey}[${green}✓✓✓${clrkey}]${rst}"}"
		: "${CROSS="${clrkey}[${red}✗✗✗${clrkey}]${rst}"}"
		: "${MID="${clrkey}[${red}✗✗${green}✓${clrkey}]${rst}"}"
		: "${WARN="${clrkey}[${yellow}⚠  ${clrkey}]${yellow}"}"
		: "${INFO="${clrkey}[${yellow}➡  ${clrkey}]${rst}"}"
	else
		unset_varcolors
	fi
}

unset_varcolors() {
	unset reset rst bold underline nounderline reverse
	unset black red green yellow blue magenta cyan white gray orange purple
	TICK="[✓]"
	CROSS="[x]"
	MID="[±]"
	WARN="[!]"
	INFO="[i]"
}

replicate() {
	local char="${1:-#}"
	local nsize="${2:-$(tput cols 2>/dev/null || echo 80)}"
	local _line
	printf -v _line "%*s" "$nsize" ""
	printf '%b\n' "${blue}${_line// /$char}${reset}"
}

readconf() {
	local msg="$1"
	local color="${2:-${yellow}}"
	local REPLY

	echo -n -e "$color"
	read -r -p "$msg [S/n] :" REPLY
	echo -n -e "$reset"
	case "${REPLY^}" in
	[Ss]) return 0 ;;
	"") return 0 ;;
	*) return 1 ;;
	esac
}

# Pede que o usuário digite exatamente $1 para confirmar uma operação
# irreversível. Muito mais seguro que um simples [S/n] para wipefs/pvremove/
# lvremove/vgreduce, onde um erro de dedo custa dados.
confirm_destructive() {
	local target="$1"
	local input

	echo -e "${red}${bold}Esta operação é destrutiva e IRREVERSÍVEL.${reset}"
	echo -e "${yellow}Digite exatamente '${bold}${target}${reset}${yellow}' para confirmar (qualquer outra coisa cancela):${reset}"
	read -r input
	[[ "$input" == "$target" ]]
}

msg() { echo -e "${INFO} ${*}${reset}"; }
log_ok() { echo -e "${TICK} ${*}${reset}"; }
log_err() { echo -e "${CROSS} ${*}${reset}"; }
log_mid() { echo -e "${MID} ${*}${reset}"; }
log_warn() { echo -e "${WARN} ${*}${reset}"; }
msg_tab() { echo -e "  ${INFO} ${*}${reset}"; }
log_ok_tab() { echo -e "  ${TICK} ${*}${reset}"; }
log_err_tab() { echo -e "  ${CROSS} ${*}${reset}"; }
log_mid_tab() { echo -e "  ${MID} ${*}${reset}"; }
log_warn_tab() { echo -e "  ${WARN} ${*}${reset}"; }
die() {
	echo -e "${CROSS} ${red}${*}${reset}"
	exit 1
}

MostraErro() { echo -e "${CROSS} erro: ${red}$1${reset} => comando: ${cyan}'$2'${reset} => result=${yellow}$3${reset}"; }

sh_checkroot() {
	((EUID != 0)) && elevate_to_root "$@" || return 0
}

elevate_to_root() {
	msg "This script must be run as root. Elevating privileges..."
	if command -v sudo >/dev/null 2>&1; then
		exec sudo bash "$0" "$@"
	fi
	# Se sudo falhar, tenta su (quoting seguro via printf %q, evita quebra com
	# espaços/caracteres especiais nos argumentos)
	if command -v su >/dev/null 2>&1; then
		exec su -c "$(printf '%q ' "$0" "$@")"
	fi
	die "Error: Unable to elevate privileges. Run manually as root."
}

detect_distro() {
	local id=""
	if [[ -r /etc/os-release ]]; then
		id=$(grep -E '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"')
	elif [[ -r /usr/lib/os-release ]]; then
		id=$(grep -E '^ID=' /usr/lib/os-release | cut -d= -f2 | tr -d '"')
	else
		echo "unknown"
		return
	fi
	echo "$id"
}

# Depende de PACKAGEDEP (mapa: comando->pacote), DISTRO_MGR e DISTRO_PKGS
# (mapas: distro->comando de instalação / lista de pacotes), definidos abaixo.
sh_checkDependencies() {
	local DISTRO
	DISTRO="$(detect_distro)"
	local d pkg errorFound=false
	local -a missing=()
	local cmsgNot cmsgPkg
	cmsgNot="$(gettext "Não foi possível encontrar o comando")"
	cmsgPkg="$(gettext "instalar pacote")"

	for d in "${!PACKAGEDEP[@]}"; do
		if ! command -v "$d" &>/dev/null; then
			pkg="${PACKAGEDEP[$d]}"
			log_err "${red}Error${rst}: ${cmsgNot} $(printf "${cyan}%-15s${rst}" "$d") -> ${cmsgPkg} ${cyan}${pkg}${rst}"
			missing+=("${pkg}")
			errorFound=true
		fi
	done

	if $errorFound; then
		replicate '='
		echo "${yellow}             $(gettext "IMPOSSÍVEL CONTINUAR")"
		echo "${black}$(gettext "Este script precisa dos comandos listados acima")"
		echo "${black}$(gettext "Instale-os e/ou verifique se eles estão em seu") ${red}\$PATH${reset}"
		replicate '='

		local cmd="${DISTRO_MGR[$DISTRO]:-}"
		# shellcheck disable=SC2206 # split intencional: $cmd vem de um mapa de config, não de entrada externa
		local -a cmd_arr=($cmd)
		local -a pkgs_arr=("${missing[@]}")

		if [[ -z "$cmd" ]]; then
			die "$(gettext "Distro não suportada para instalação automática:") $DISTRO"
		fi

		msg "Distro detectada: ${cyan}$DISTRO${rst}"
		if readconf "$(gettext "Instalar dependências base agora?")"; then
			echo -e "${blue}::${rst} $(gettext "Preparando ambiente para") ${green}${DISTRO}${reset}..."
			if ! "${cmd_arr[@]}" "${pkgs_arr[@]}"; then
				echo
				echo -e "${red}$(gettext "Erro Crítico:")${rst} $(gettext "A instalação dos pacotes básicos falhou.")"
				exit 1
			fi
			echo
			echo -e "${green}$(gettext "Sucesso:")${reset} $(gettext "Dependências instaladas.")"
		else
			die "$(gettext "Dependências ausentes; abortando.")"
		fi
	fi
}

declare -A PACKAGEDEP=(
	[gettext]=gettext
	[tput]=ncurses
	[lvs]=lvm2
	[pvs]=lvm2
	[vgs]=lvm2
	[lvcreate]=lvm2
	[lvremove]=lvm2
	[lvextend]=lvm2
	[vgextend]=lvm2
	[vgreduce]=lvm2
	[vgchange]=lvm2
	[pvcreate]=lvm2
	[pvremove]=lvm2
	[wipefs]=util-linux
	[lsblk]=util-linux
)
# Mapa: [distro]="lista de pacotes"
declare -A DISTRO_PKGS=(
	["void"]="gettext rsync parted curl xz lvm2"
	["void-live"]="gettext rsync parted curl xz lvm2"
	["voidlinux"]="gettext rsync parted curl xz lvm2"
	["chili"]="gettext rsync parted curl xz lvm2"
	["chililinux"]="gettext rsync parted curl xz lvm2"
	["arch"]="gettext rsync parted curl xz lvm2"
	["biglinux"]="gettext rsync parted curl xz lvm2"
	["manjaro"]="gettext rsync parted curl xz lvm2"
	["debian"]="gettext-base rsync parted curl xz-utils lvm2"
)
# Mapa: [distro]="comando de instalação"
declare -A DISTRO_MGR=(
	["void"]="xbps-install -Syf"
	["void-live"]="xbps-install -Syf"
	["voidlinux"]="xbps-install -Syf"
	["chili"]="pacman -Sy --needed --noconfirm"
	["chililinux"]="pacman -Sy --needed --noconfirm"
	["arch"]="pacman -Sy --needed --noconfirm"
	["biglinux"]="pacman -Sy --needed --noconfirm"
	["manjaro"]="pacman -Sy --needed --noconfirm"
	["debian"]="apt-get install -y"
)

trap 'echo; log_warn "Interrompido pelo usuário."; exit 130' INT

sh_copyright() {
	cat <<-EOF-COPY
		${bold}${cyan}${APP} v${_VERSION_}${rst}
		${bold}${cyan}${APPDESC}${rst}
		${bold}${orange}Copyright (c) 2019-2026, ${reset}ChiliLinux Development Team <https://chililinux.com> <https://github.com/chililinux>
		${bold}${orange}Copyright (c) 2019-2026, ${reset}Vilmar Catafesta <vcatafesta@gmail.com>${black}
	EOF-COPY
}

sh_version() { sh_copyright; }

usage() {
	cat <<-EOF
		${APP} v${_VERSION_} - ${APPDESC}

		Uso: ${APP} [opções] [comando [args]]

		Comandos:
		  list-vms                            Lista VMs (thin volumes)
		  list-pvs                            Lista PVs
		  list-vgs                            Lista VGs
		  list-lvs                            Lista LVs
		  pool-status                         Status do thin pool
		  add-disk <disco>                    Adiciona disco ao VG (ex: /dev/sdb)
		  remove-disk <disco>                 Remove disco do VG
		  create-vm <vmid> <tamanho> [idx]    Cria VM thin (ex: 100 50G 0 -> vm-100-disk-0)
		  remove-vm <nome>                    Remove VM/volume lógico
		  activate                            vgchange -ay && lvscan

		Opções:
		  --dry-run          Mostra os comandos sem executar
		  --vg <nome>        Volume Group (padrão: variável VG ou 'pve')
		  --pool <nome>      Thin pool (padrão: variável POOL ou 'data')
		  --units <unidade>  Unidade para lvs/pvs/vgs (padrão: g). Ex: g, m, t
		  -h, --help         Mostra esta ajuda
		  -v, --version      Mostra a versão

		Sem comando, abre o menu interativo.
		Operações destrutivas (add-disk, remove-disk, remove-vm) sempre pedem
		confirmação digitada, mesmo em modo --dry-run e via CLI.
	EOF
}

# ===================================================================
# Funções puras / testáveis (sem I/O de terminal, fáceis de testar com bats)
# ===================================================================

# validate_vmid ID -> 0 se ID é um inteiro positivo
validate_vmid() {
	[[ "$1" =~ ^[0-9]+$ ]]
}

# validate_size TAMANHO -> 0 se está no formato aceito por lvcreate -V (ex: 50G, 512M, 1.5T)
validate_size() {
	[[ "$1" =~ ^[0-9]+(\.[0-9]+)?[KkMmGgTt]$ ]]
}

# build_lv_name VMID [INDEX] -> nome do volume no padrão Proxmox-like (vm-<id>-disk-<n>)
build_lv_name() {
	local vmid="$1" idx="${2:-0}"
	echo "vm-${vmid}-disk-${idx}"
}

# to_bytes TAMANHO -> tamanho em bytes (inteiro), assume unidades binárias (1024^n)
to_bytes() {
	local size="$1" num unit
	[[ "$size" =~ ^([0-9]+(\.[0-9]+)?)([KkMmGgTt])$ ]] || return 1
	num="${BASH_REMATCH[1]}"
	unit="${BASH_REMATCH[3],,}"
	case "$unit" in
	k) awk -v n="$num" 'BEGIN{printf "%.0f", n*1024}' ;;
	m) awk -v n="$num" 'BEGIN{printf "%.0f", n*1024*1024}' ;;
	g) awk -v n="$num" 'BEGIN{printf "%.0f", n*1024*1024*1024}' ;;
	t) awk -v n="$num" 'BEGIN{printf "%.0f", n*1024*1024*1024*1024}' ;;
	esac
}

# pool_free_bytes TOTAL_BYTES PERCENT_USADO -> bytes livres estimados no pool
pool_free_bytes() {
	local total="$1" percent="$2"
	awk -v t="$total" -v p="$percent" 'BEGIN{printf "%.0f", t*(100-p)/100}'
}

# disk_is_pv DISCO_REAL LISTA_PV -> 0 se DISCO_REAL (caminho já resolvido por
# readlink -f) está entre os PVs listados em LISTA_PV (um por linha, podem
# ser symlinks). Extraída do padrão frágil original (exit dentro de while em
# subshell de pipe) para uma função simples e testável.
disk_is_pv() {
	local target="$1" pv_list="$2"
	local pv real
	while IFS= read -r pv; do
		[[ -z "$pv" ]] && continue
		real=$(readlink -f "$pv" 2>/dev/null) || continue
		[[ "$real" == "$target" ]] && return 0
	done <<<"$pv_list"
	return 1
}

# ===================================================================
# Execução de comandos com suporte a dry-run (substitui o antigo run_cmd
# baseado em eval, que era arriscado e não era usado em lugar nenhum)
# ===================================================================
declare -i DRYRUN=0

run_cmd() {
	if ((DRYRUN)); then
		echo -e "  ${cyan}[DRY-RUN]${rst} $*"
		return 0
	fi
	echo -e "  ${cyan}[exec]${rst} $*"
	"$@"
}

# preview_cmds "cmd1 arg..." "cmd2 arg..." ... -> mostra o plano de execução
preview_cmds() {
	echo -e "${yellow}Isto vai executar:${reset}"
	local c
	for c in "$@"; do
		echo "  ${cyan}\$${reset} ${c}"
	done
}

# ===================================================================
# Configuração e funções de UI
# ===================================================================
VG="${VG:-pve}"
POOL="${POOL:-data}"
LVM_UNITS="${LVM_UNITS:-g}"

confirm() {
	readconf "Confirmar operação?"
}

pause() {
	echo
	read -rp "${red}Tecle algo para continuar...${rst}"
}

list_vms() {
	replicate '-'
	echo -e "${cyan}VMs (thin volumes):${reset}"
	lvs --units "$LVM_UNITS" "$VG" || log_err_tab "Falha ao listar VMs em '${VG}' (o VG existe?)"
	replicate '-'
}

list_pvs() {
	echo -e "${cyan}PVS (listar discos físicos):${reset}"
	pvs --units "$LVM_UNITS" || log_err_tab "Falha ao listar PVs."
}

list_vgs() {
	echo -e "${cyan}VGS (listar volume groups):${reset}"
	vgs --units "$LVM_UNITS" || log_err_tab "Falha ao listar VGs."
}

list_lvs() {
	echo -e "${cyan}LVS (listar volumes lógicos):${reset}"
	lvs --units "$LVM_UNITS" -a || log_err_tab "Falha ao listar LVs."
}

pool_status() {
	echo -e "${cyan}Status do thin pool:${reset}"
	lvs --units "$LVM_UNITS" -o+data_percent,metadata_percent || log_err_tab "Falha ao consultar status do pool."
}

# add_disk [DISCO] -- se DISCO não for passado, pergunta interativamente
add_disk() {
	local DISK="${1:-}" REAL_DISK PV_LIST

	if [[ -z "$DISK" ]]; then
		echo -e "${cyan}Discos disponíveis:${reset}"
		lsblk -d -o NAME,SIZE,MODEL
		echo -e "${blue}Digite o disco (exemplo: /dev/sdb):${reset}"
		read -r DISK
	fi

	[ -b "$DISK" ] || {
		echo -e "${red}Disco inválido: '${DISK}' não é um block device.${reset}"
		return 1
	}

	REAL_DISK=$(readlink -f "$DISK")
	PV_LIST=$(pvs --noheadings -o pv_name 2>/dev/null)

	if disk_is_pv "$REAL_DISK" "$PV_LIST"; then
		replicate '-'
		echo "$PV_LIST" | while IFS= read -r pv; do
			lsblk -dn -o TYPE,NAME,PATH,SIZE,TRAN,MODEL,LABEL,SERIAL,PTTYPE "$(readlink -f "$pv")"
		done
		replicate '-'
		echo -e "${green}Disco já é PV. Nada a fazer.${reset}"
		return 0
	fi

	echo -e "${yellow}Adicionar ${DISK} ao VG ${VG}${reset}"
	preview_cmds \
		"wipefs -a $DISK" \
		"pvcreate $DISK" \
		"vgextend $VG $DISK" \
		"lvextend -l +100%FREE $VG/$POOL"

	if ! confirm_destructive "$DISK"; then
		echo -e "${red}Operação cancelada.${reset}"
		return 1
	fi

	run_cmd wipefs -a "$DISK" || { log_err_tab "Falha em wipefs em ${DISK}."; return 1; }
	run_cmd pvcreate "$DISK" || { log_err_tab "Falha em pvcreate em ${DISK}."; return 1; }
	if ! run_cmd vgextend "$VG" "$DISK"; then
		log_err_tab "Falha ao estender VG '${VG}' com ${DISK}."
		log_warn_tab "${DISK} ficou marcado como PV mas fora do VG '${VG}'. Rode 'pvremove ${DISK}' se quiser desfazer."
		return 1
	fi
	run_cmd lvextend -l +100%FREE "$VG/$POOL" || { log_err_tab "Falha ao estender pool '${VG}/${POOL}'."; return 1; }
	echo -e "${green}Disco adicionado ao pool.${reset}"
}

# remove_disk [DISCO]
remove_disk() {
	local DISK="${1:-}" REAL_DISK

	if [[ -z "$DISK" ]]; then
		echo -e "${cyan}PVs atuais:${reset}"
		pvs --units "$LVM_UNITS"
		echo -e "${blue}Digite o disco para remover (exemplo: /dev/sdb):${reset}"
		read -r DISK
	fi

	[ -b "$DISK" ] || {
		echo -e "${red}Disco inválido: '${DISK}' não é um block device.${reset}"
		return 1
	}

	REAL_DISK=$(readlink -f "$DISK")
	if ! disk_is_pv "$REAL_DISK" "$(pvs --noheadings -o pv_name 2>/dev/null)"; then
		echo -e "${red}'${DISK}' não é um PV do VG '${VG}'. Nada a fazer.${reset}"
		return 1
	fi

	echo -e "${yellow}Remover ${DISK} do VG ${VG}${reset}"
	preview_cmds "vgreduce $VG $DISK" "pvremove $DISK"

	if ! confirm_destructive "$DISK"; then
		echo -e "${red}Operação cancelada.${reset}"
		return 1
	fi

	run_cmd vgreduce "$VG" "$DISK" || { log_err_tab "Falha ao remover ${DISK} do VG '${VG}'."; return 1; }
	run_cmd pvremove "$DISK" || { log_err_tab "Falha em pvremove em ${DISK}."; return 1; }
	echo -e "${green}Disco removido.${reset}"
}

# check_pool_space TAMANHO_PEDIDO -- avisa (não bloqueia; thin pools permitem
# overcommit de propósito) se o espaço livre estimado do pool é menor que o
# solicitado.
check_pool_space() {
	local requested="$1" line total_b percent free_b requested_b
	line=$(lvs --noheadings --units b --nosuffix -o lv_size,data_percent "$VG/$POOL" 2>/dev/null) || return 0
	total_b=$(awk '{print $1}' <<<"$line")
	percent=$(awk '{print $2}' <<<"$line")
	[[ -z "$total_b" || -z "$percent" ]] && return 0

	free_b=$(pool_free_bytes "$total_b" "$percent")
	requested_b=$(to_bytes "$requested") || return 0

	if ((requested_b > free_b)); then
		log_warn_tab "Pedido (${requested}) é maior que o espaço livre estimado do pool ($(awk -v b="$free_b" 'BEGIN{printf "%.1fG", b/1024/1024/1024}'))."
		log_warn_tab "Thin pools permitem overcommit, mas monitore o uso com a opção 5 (Thin Pool) para não estourar o disco físico."
	fi
}

# create_vm [VMID] [TAMANHO] [INDEX]
create_vm() {
	local VMID="${1:-}" SIZE="${2:-}" IDX="${3:-0}" NAME

	if [[ -z "$VMID" ]]; then
		echo -e "${cyan}Exemplo: VMID=100 cria vm-100-disk-0${reset}"
		echo -e "${blue}ID da VM (ex: 100):${reset}"
		read -r VMID
	fi
	if ! validate_vmid "$VMID"; then
		echo -e "${red}ID inválido: '${VMID}' precisa ser numérico.${reset}"
		return 1
	fi

	if [[ -z "$SIZE" ]]; then
		echo -e "${blue}Tamanho do disco (ex: 50G):${reset}"
		read -r SIZE
	fi
	if ! validate_size "$SIZE"; then
		echo -e "${red}Tamanho inválido: '${SIZE}' (use algo como 50G, 512M).${reset}"
		return 1
	fi

	NAME="$(build_lv_name "$VMID" "$IDX")"

	if lvs "$VG/$NAME" &>/dev/null; then
		echo -e "${red}Já existe um volume '${NAME}' em '${VG}'.${reset}"
		return 1
	fi

	check_pool_space "$SIZE"

	echo -e "${yellow}Criar volume ${NAME} com ${SIZE}${reset}"
	preview_cmds "lvcreate -V $SIZE -T $VG/$POOL -n $NAME"

	if ! confirm; then
		echo -e "${red}Operação cancelada.${reset}"
		return 1
	fi

	run_cmd lvcreate -V "$SIZE" -T "$VG/$POOL" -n "$NAME" || { log_err_tab "Falha ao criar o volume '${NAME}'."; return 1; }
	echo -e "${green}VM criada com sucesso.${reset}"
	list_vms
}

# remove_vm [NOME]
remove_vm() {
	local NAME="${1:-}"

	if [[ -z "$NAME" ]]; then
		echo -e "${cyan}VMs existentes:${reset}"
		lvs --units "$LVM_UNITS" "$VG"
		echo -e "${blue}Digite o nome da VM (ex: vm-100-disk-0):${reset}"
		read -r NAME
	fi

	if ! lvs "$VG/$NAME" &>/dev/null; then
		echo -e "${red}Volume '${NAME}' não existe em '${VG}'.${reset}"
		return 1
	fi

	echo -e "${yellow}${bold}Remover ${NAME} (irreversível)${reset}"
	preview_cmds "lvremove -f $VG/$NAME"

	if ! confirm_destructive "$NAME"; then
		echo -e "${red}Operação cancelada.${reset}"
		return 1
	fi

	run_cmd lvremove -f "$VG/$NAME" || { log_err_tab "Falha ao remover '${NAME}'."; return 1; }
	echo -e "${green}VM removida.${reset}"
}

activate_volumes() {
	run_cmd vgchange -ay || log_err_tab "Falha ao ativar volumes (vgchange -ay)."
	run_cmd lvscan || log_err_tab "Falha ao executar lvscan."
}

# ===================================================================
# Menu interativo
# ===================================================================
interactive_menu() {
	while true; do
		clear
		replicate '-'
		echo -e "${cyan}========= $APP - GERENCIADOR LVM THIN =========${reset}"
		replicate '-'
		echo -e "${green}1${reset}  - Listar VMs (thin volumes)"
		echo -e "${green}2${reset}  - PVS (listar discos físicos)"
		echo -e "${green}3${reset}  - VGS (listar volume groups)"
		echo -e "${green}4${reset}  - LVS (listar volumes lógicos)"
		echo -e "${green}5${reset}  - Thin Pool (uso do pool)"
		echo
		echo -e "${green}6${reset}  - Acrescentar disco (pvcreate + vgextend)"
		echo -e "${green}7${reset}  - Remover disco (vgreduce + pvremove)"
		echo
		echo -e "${green}8${reset}  - Criar VM (lvcreate thin)"
		echo -e "${green}9${reset}  - Remover VM (lvremove)"
		echo -e "${green}10${reset} - Ativar Volumes LVM (vgchange -ay)"
		echo
		if ((DRYRUN)); then
			echo -e "${yellow}[modo --dry-run ativo: nenhum comando será executado de verdade]${reset}"
			echo
		fi
		echo -e "${red}0${reset}  - Sair"
		echo
		read -rp "Escolha: " opt

		case "$opt" in
		1) list_vms; pause ;;
		2) list_pvs; pause ;;
		3) list_vgs; pause ;;
		4) list_lvs; pause ;;
		5) pool_status; pause ;;
		6) add_disk; pause ;;
		7) remove_disk; pause ;;
		8) create_vm; pause ;;
		9) remove_vm; pause ;;
		10) activate_volumes; pause ;;
		0) exit 0 ;;
		*)
			echo -e "${red}Opção inválida${reset}"
			pause
			;;
		esac
	done
}

# ===================================================================
# CLI
# ===================================================================
main() {
	local cmd=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--dry-run)
			DRYRUN=1
			shift
			;;
		--vg)
			VG="$2"
			shift 2
			;;
		--pool)
			POOL="$2"
			shift 2
			;;
		--units)
			LVM_UNITS="$2"
			shift 2
			;;
		-h | --help)
			usage
			exit 0
			;;
		-v | --version)
			sh_version
			exit 0
			;;
		list-vms | list-pvs | list-vgs | list-lvs | pool-status | add-disk | remove-disk | create-vm | remove-vm | activate)
			cmd="$1"
			shift
			break
			;;
		*)
			echo -e "${red}Opção/comando desconhecido: $1${reset}" >&2
			usage
			exit 1
			;;
		esac
	done

	set_varcolors
	sh_checkroot "$@"
	sh_checkDependencies

	case "$cmd" in
	list-vms) list_vms ;;
	list-pvs) list_pvs ;;
	list-vgs) list_vgs ;;
	list-lvs) list_lvs ;;
	pool-status) pool_status ;;
	add-disk) add_disk "$@" ;;
	remove-disk) remove_disk "$@" ;;
	create-vm) create_vm "$@" ;;
	remove-vm) remove_vm "$@" ;;
	activate) activate_volumes ;;
	"") interactive_menu ;;
	esac
}

# Só executa main quando o script é chamado diretamente — permite sourcear
# este arquivo (ex.: em testes bats) sem disparar checagem de root, menu, etc.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
