die() {
	printf "%b %b%b\n" "$CROSS" "$*" "$reset" >&2
	exit 1
}

replicate() {
	local char=${1:-'#'}
	local nsize=${2:-$(tput cols)}
	local ccolor=${3:-$green}
	local line
	printf -v line "%*s" "$nsize" && echo -e "${ccolor}${line// /$char}${rst}"
}

maxcol() {
	COLUMNS=$(stty size)
	COLUMNS=${COLUMNS##* }
	((COLUMNS <= 0)) && COLUMNS=80
	echo "$COLUMNS"
}

readconf() {
	local msg="$1"
	local color="${2:-${red}}"

	echo -n -e "$color"
	read -r -p "$msg [S/n]"
	echo -n -e "$reset"
	case "${REPLY^}" in
	[SY]) return 0 ;;
	"") return 0 ;;
	*) return 1 ;;
	esac
}

sh_checkDependencies() {
	local DISTRO="$(detect_distro)"
	local aBlock_files=()
	local d
	local pkg
	local errorFound=false
	declare -a missing
	local cmsgNot="$(gettext "Não foi possível encontrar o comando")"
	local cmsgPkg="$(gettext "instalar pacote")"

	for d in "${!PACKAGEDEP[@]}"; do
		if ! has_command "$d"; then
			pkg="${PACKAGEDEP[$d]}"
			log_err "${red}Error${rst}: ${cmsgNot} $(printf "${cyan}%-15s${rst}\n" "$d") -> ${cmsgPkg} ${cyan}${pkg}${rst}"
			missing+=("${pkg}")
			errorFound=true
		else
			#log_msg "Check: ${cyan}$d"
			:
		fi
	done

	if $errorFound; then
		replicate '='
		echo "${yellow}             $(gettext "IMPOSSÍVEL CONTINUAR")"
		echo "${black}$(gettext "Este script precisa dos comandos listados acima")"
		echo "${black}$(gettext "Instale-os e/ou verifique se eles estão em seu") ${red}\$PATH${reset}"
		replicate '='

		local cmd="${DISTRO_MGR[$DISTRO]:-}"
		#local pkgs="${DISTRO_PKGS[$DISTRO]}"
		local pkgs="${missing[*]}"

		msg_info "Distro detectada: ${cyan}$DISTRO${rst}"
		if [[ -z "$cmd" ]]; then
			msg_err "$(gettext 'Distro sem gerenciador mapeado:') ${cyan}${DISTRO}${rst} - $(gettext 'instale manualmente:') ${yellow}${pkgs}${rst}"
			exit 1
		fi
		if readconf "$(gettext "Instalar dependências base agora?")"; then
			echo -e "${blue}::${rst} $(gettext "Preparando ambiente para") ${green}${DISTRO}${reset}..."
			# Execução dinâmica: $cmd (gerenciador) + $pkgs (lista de pacotes)
			if ! cmd_sudo $cmd $pkgs; then
				echo
				echo -e "${red}$(gettext "Erro Crítico:")${rst} $(gettext "A instalação dos pacotes básicos falhou.")"
				exit 1
			fi
			echo
			echo -e "${green}$(gettext "Sucesso:")${reset} $(gettext "Dependências instaladas.")"
		else
			echo -e "${red}$(gettext "Ignorando: instalação de dependências recusada pelo usuário.")"
			replicate '-'
		fi
	fi
}

sh_checkOVMFFiles() {
	local DISTRO=$(detect_distro)
	local d
	local errorFound=false
	local missing=()
	local aBlock_files+=('/usr/share/edk2/x64/OVMF_CODE.4m.fd' '/usr/share/edk2/x64/OVMF_VARS.4m.fd')

	for d in "${aBlock_files[@]}"; do
		if ! has_file "$d"; then
			#			log_err "Check: ${red}ERROR${rst}: $(gettext 'Não foi possível encontrar o arquivo') ${cyan}'$d'${yellow} -> $(gettext 'instalar pacote') ${cyan}edk2-ovmf${reset}"
			errorFound=true
			break
		else
			true
			log_msg "Check UEFI: ${cyan}$d"
			:
		fi
	done

	if $errorFound; then
		replicate '='
		echo "${yellow}             FALHA DO CHECK LIST OVMF FILES"
		log_err "Check: ${red}ERROR${rst}: $(gettext 'Não foi possível encontrar o arquivo') ${cyan}'$d'${yellow} -> $(gettext 'instalar pacote') ${cyan}edk2-ovmf${reset}"
		echo "${black}Este script precisa dos arquivos para UEFI listados acima"
		echo "${black}Instale-os e/ou verifique se eles estão em ${yellow}/usr/share/edk2/x64/${rst}"
		echo "${black}Ao decidir não instalar, o UEFI poderá não funcionar corretamente.${rst}"
		replicate '='

		msg_info "Distro detectada: ${cyan}$DISTRO${rst}"
		if readconf "Deseja instalar o pacote e suprir arquivos necessários ?"; then
			local cmd="${DISTRO_MGR[$DISTRO]:-}"
			local pkgs="edk2-ovmf"
			if [[ -z "$cmd" ]]; then
				msg_err "$(gettext 'Distro sem gerenciador mapeado:') ${cyan}${DISTRO}${rst}"
				return 1
			fi
			if ! cmd_sudo $cmd $pkgs; then
				echo
				echo -e "${red}$(gettext "Erro Crítico:")${rst} $(gettext "A instalação dos pacotes básicos falhou.")"
				exit 1
			fi
			echo
			echo -e "${green}$(gettext "Sucesso:")${reset} $(gettext "Dependências instaladas.")"
			sh_checkOVMFFiles
		fi
	fi
}

sh_checkVdiskFiles() {
	local aBlock_files=()
	local missing=()
	local d

	aBlock_files+=($HOME_DIR/vdisk/sda.img)
	aBlock_files+=($HOME_DIR/vdisk/sdb.img)
	aBlock_files+=($HOME_DIR/vdisk/sdc.img)
	aBlock_files+=($HOME_DIR/vdisk/sdd.img)
	aBlock_files+=($HOME_DIR/vdisk/vda.qcow2)
	aBlock_files+=($HOME_DIR/vdisk/vdb.qcow2)
	aBlock_files+=($HOME_DIR/vdisk/vdc.qcow2)
	aBlock_files+=($HOME_DIR/vdisk/vdd.qcow2)

	for d in "${aBlock_files[@]}"; do
		if ! has_file "$d"; then
			sh_createVdiskFiles
			break
		fi
	done
}

# Função para verificar se a interface TAP já existe e retornar o próximo número disponível
get_next_free_tap() {
	local next_tap=1
	while ip link show "tap$next_tap" &>/dev/null; do
		next_tap=$((next_tap + 1))
	done
	echo "tap$next_tap"
}

# Função para verificar se a bridge existe e retornar o próximo nome disponível
get_next_free_bridge() {
	local base_bridge="virbr"
	local next_bridge=1
	while ip link show "$base_bridge$next_bridge" &>/dev/null; do
		next_bridge=$((next_bridge + 1))
	done
	echo "$base_bridge$next_bridge"
}

# Match EXATO de bridge (evita '-b br' casar com 'br0' e $2 vazio casar com tudo)
bridge_exists() {
	local b="$1" x
	[[ -z "$b" ]] && return 1
	while read -r x; do
		[[ "$x" == "$b" ]] && return 0
	done < <(get_bridge_interfaces)
	return 1
}

# ---------------------------
# cmd_sudo wrapper
# ---------------------------
cmd_sudo() {
	if ((EUID == 0)); then
		"$@"
	else
		sudo -- "$@"
	fi
}

ensure_qemu_bridge_allowed() {
	local br="$1"
	local conf="/etc/qemu/bridge.conf"

	# se arquivo não existe — cria
	if [[ ! -f "$conf" ]]; then
		# Garantir que /etc/qemu existe
		cmd_sudo mkdir -p /etc/qemu &>/dev/null
		cmd_sudo sh -c "echo 'allow ${br}' > '$conf'"
		return 0
	fi

	# verifica se já está presente (ignora espaços e duplicidades)
	if cmd_sudo grep -Eq "^[[:space:]]*allow[[:space:]]+${br}[[:space:]]*$" "$conf"; then
		msg_ok "Bridge ${cyan}'${br}'${rst} já está permitida no $conf"
		return 0
	fi

	# adicionar no final do arquivo
	msg_info "$(gettext 'Adicionando') 'allow ${br}' $(gettext 'em') $conf"
	cmd_sudo sh -c "echo 'allow ${br}' >> '$conf'"
	return 0
}

######################################################################################################
#  BRIDGE REAL (tipo VirtualBox) – sem NAT
######################################################################################################
create_real_bridge() {
	local bridge_name="$1"
	local iface_phys
	local old_con
	local kernel_master
	local use_dhcp=false
	local bridge_ip
	local bridge_gw

	[[ -z "$bridge_name" ]] && {
		msg_err "$(gettext 'Uso correto'): --create_real_bridge br0"
		return 1
	}

	msg_info "$(gettext 'Verificando se a bridge') '$bridge_name' $(gettext 'já existe')"
	if ip link show "$bridge_name" &>/dev/null; then
		msg_warning "$(gettext 'Ponte') '${bridge_name}' $(gettext 'já existe — nada a fazer.')"
		cmd_sudo nmcli connection show
		return 0
	fi

	# DETECTAR INTERFACES FÍSICAS (ETHERNET)
	###########################################################################
	msg_info "$(gettext 'Detectando interfaces físicas (ethernet)')"
	local -a eth_list
	mapfile -t eth_list < <(
		nmcli -t -f DEVICE,TYPE device | awk -F: '$2=="ethernet"{print $1}'
	)

	if [[ ${#eth_list[@]} -eq 0 ]]; then
		msg_err "$(gettext 'Nenhuma interface ethernet disponível. WLAN não suporta bridge real.')"
		return 1
		#  elif [[ ${#eth_list[@]} -eq 1 ]]; then
		#    iface_phys="${eth_list[0]}"
		#    msg_info "Apenas uma interface física encontrada: $iface_phys"
	else
		msg_info "$(gettext 'Múltiplas interfaces encontradas — exibindo menu de seleção')"
		create_menu_with_array "$(gettext 'Escolha a interface física para a bridge:')" eth_list[@]
		iface_phys="$MENU_RESULT"
		if [[ "$iface_phys" == "$(gettext 'Encerrar')" ]]; then
			msg_info "$(gettext 'Operação cancelada pelo usuário.')"
			return 1
		fi
		msg_info "$(gettext 'Interface selecionada:') $iface_phys"
	fi

	# PROTEÇÃO — INTERFACE NÃO PODE SER WLAN
	###########################################################################
	if nmcli -t -f DEVICE,TYPE device | grep -q "^${iface_phys}:wifi$"; then
		msg_err "$(gettext 'A interface') '$iface_phys' $(gettext 'é Wi-Fi. Bridge real não funciona com WLAN.')"
		return 1
	fi

	# VERIFICAR SE INTERFACE JÁ É SLAVE
	###########################################################################
	msg_info "$(gettext 'Verificando se') '$iface_phys' $(gettext 'já pertence a outra bridge')"
	kernel_master=$(ip -o link show "$iface_phys" | sed -n 's/.*master \([^ ]*\).*/\1/p' || true)
	if [[ -n "$kernel_master" ]]; then
		msg_err "$(gettext 'Interface') '$iface_phys' $(gettext 'já pertence à bridge') '$kernel_master'."
		msg_warning "$(gettext 'Remova primeiro:') chili-fr -r $kernel_master"
		return 1
	fi

	# MENU VLAN
	###########################################################################
	msg_info "$(gettext 'Configuração de VLAN')"
	local -a vlan_options=(
		"$(gettext 'Sem VLAN (rede normal)')"
		"VLAN Tagged ($(gettext 'criar') ${iface_phys}.<id> $(gettext 'e usar como slave'))"
		"VLAN Trunk (bridge vlan-filtering $(gettext 'habilitado'))"
	)
	# chaves paralelas a vlan_options[] - comparar por indice evita depender
	# do texto traduzido (fonte do bug anterior)
	local -a vlan_keys=(none tagged trunk)
	create_menu_with_array "$(gettext 'Selecione o modo VLAN:')" vlan_options[@]

	local vlan_choice='' i
	for i in "${!vlan_options[@]}"; do
		if [[ "$MENU_RESULT" == "${vlan_options[$i]}" ]]; then
			vlan_choice="${vlan_keys[$i]}"
			break
		fi
	done
	if [[ -z "$vlan_choice" ]]; then
		msg_err "$(gettext 'Erro inesperado no menu VLAN')"
		return 1
	fi
	msg_info "$(gettext 'Modo VLAN selecionado:') ${cyan}$vlan_choice${rst}"

	local vlan_id="" slave_iface="" want_vlan_trunk=false
	if [[ "$vlan_choice" == "tagged" ]]; then
		while true; do
			get 0 0 "$(gettext 'Digite o VLAN ID') (1–4094): " vlan_id ""
			if [[ "$vlan_id" =~ ^[0-9]+$ && "$vlan_id" -ge 1 && "$vlan_id" -le 4094 ]]; then
				slave_iface="${iface_phys}.${vlan_id}"
				msg_info "$(gettext 'Subinterface VLAN definida:') $slave_iface"
				break
			fi
			msg_err "$(gettext 'VLAN inválida: informe um número entre 1 e 4094')."
		done

	elif [[ "$vlan_choice" == "trunk" ]]; then
		want_vlan_trunk=true
		msg_info "$(gettext 'Bridge atuará como trunk') (vlan-filtering)."

		local vlan_list_raw
		while true; do
			get 0 0 "$(gettext 'Informe VLANs permitidas separadas por vírgula') (ex: 10,20,30): " vlan_list_raw ""
			vlan_list_raw="${vlan_list_raw// /}"
			IFS=',' read -r -a trunk_vlans <<<"$vlan_list_raw"
			local ok=true
			declare -A _seen=()
			for v in "${trunk_vlans[@]}"; do
				if ! [[ "$v" =~ ^[0-9]+$ && "$v" -ge 1 && "$v" -le 4094 ]]; then
					msg_err "$(gettext 'VLAN inválida:') $v"
					ok=false
					break
				fi
				if [[ -n "${_seen[$v]}" ]]; then
					msg_err "$(gettext 'VLAN duplicada:') $v"
					ok=false
					break
				fi
				_seen[$v]=1
			done
			[[ "$ok" == true ]] && break
		done
	fi

	# CAPTURAR IP/GW
	###########################################################################
	if [[ -n "$slave_iface" ]]; then
		msg_info "$(gettext 'Detectando IP na subinterface VLAN') '$slave_iface'"
		bridge_ip=$(nmcli -g IP4.ADDRESS device show "$slave_iface" 2>/dev/null | head -n1 || true)
		bridge_gw=$(nmcli -g IP4.GATEWAY device show "$slave_iface" 2>/dev/null | head -n1 || true)
		if [[ -z "$bridge_ip" ]]; then
			msg_info "$(gettext 'Usando IP da interface física') '$iface_phys'"
			bridge_ip=$(nmcli -g IP4.ADDRESS device show "$iface_phys" | head -n1)
			bridge_gw=$(nmcli -g IP4.GATEWAY device show "$iface_phys")
		fi
	else
		msg_info "$(gettext 'Obtendo IP atual da interface') ${cyan}'$iface_phys'${rst}"
		bridge_ip=$(nmcli -g IP4.ADDRESS device show "$iface_phys" | head -n1)
		bridge_gw=$(nmcli -g IP4.GATEWAY device show "$iface_phys")
	fi

	if [[ -z "$bridge_ip" ]]; then msg_warning "$(gettext 'Nenhum IP detectado automaticamente.')"; fi
	if [[ -z "$bridge_gw" ]]; then msg_warning "$(gettext 'Nenhum gateway detectado.')"; fi

	local original_ip_pure="${bridge_ip%%/*}"

	# SOLICITAR E VALIDAR IP
	###########################################################################
	msg_info "$(gettext 'Configurando IP da bridge') ${cyan}'$bridge_name'${rst}"

	if readconf "Usar DHCP?"; then
		use_dhcp=true
	else
		while true; do
			get 0 0 "IP (ex 192.168.2.70/24): " tmp_ip "$bridge_ip"
			bridge_ip="${tmp_ip:-$bridge_ip}"

			if [[ ! "$bridge_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]]; then
				msg_err "$(gettext 'Formato inválido.')"
				continue
			fi

			local candidate_ip="${bridge_ip%%/*}"
			if [[ "$candidate_ip" == "$original_ip_pure" ]]; then
				msg_info "$(gettext 'IP igual ao atual — pulando teste.')"
				break
			fi

			msg_info "$(gettext 'Validando se IP está em uso...')"
			if command -v arping >/dev/null 2>&1; then
				if cmd_sudo arping -c2 -w1 -I "$iface_phys" "$candidate_ip" >/dev/null 2>&1; then
					msg_err "$(gettext 'Conflito ARP detectado.')"
					continue
				else
					break
				fi
			fi
			break
		done

		while true; do
			get 0 0 "Gateway (ex 192.168.2.1): " tmp_gw "$bridge_gw"
			bridge_gw="${tmp_gw:-$bridge_gw}"
			if [[ ! "$bridge_gw" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
				msg_err "$(gettext 'Gateway inválido')."
				continue
			fi
			if ! ping -c1 -W1 "$bridge_gw" >/dev/null; then
				msg_warning "$(gettext 'Gateway não respondeu.')"
				readconf "$(gettext 'Continuar?')" && break || continue
			fi
			break
		done
	fi

	# CRIAR BRIDGE E SLAVE
	###########################################################################
	msg_info "$(gettext 'Criando ponte') ${cyan}'$bridge_name'${rst}"
	cmd_sudo nmcli connection add type bridge ifname "$bridge_name" con-name "$bridge_name" \
		stp no ipv6.method ignore autoconnect yes >/dev/null || {
		msg_err "$(gettext 'Falha ao criar ponte')"
		return 1
	}

	local slave_to_use
	if [[ -n "$slave_iface" ]]; then
		if ! ip link show "$slave_iface" &>/dev/null; then
			msg_info "$(gettext 'Criando subinterface') VLAN $slave_iface"
			cmd_sudo nmcli connection add type vlan ifname "$slave_iface" dev "$iface_phys" id "$vlan_id" \
				con-name "vlan-${iface_phys}.${vlan_id}" ipv4.method disabled ipv6.method ignore >/dev/null || {
				msg_err "$(gettext 'Falha ao criar VLAN')"
				return 1
			}
			sleep 1
		fi
		slave_to_use="$slave_iface"
	else
		slave_to_use="$iface_phys"
	fi

	# criar slave da bridge apontando para slave_to_use
	msg_info "$(gettext 'Criando conexão slave para') ${cyan}'$slave_to_use'${rst}"
	local slave_name="${bridge_name}-${slave_to_use}-$(uuidgen | cut -c1-8)"

	cmd_sudo nmcli connection add type bridge-slave ifname "$slave_to_use" con-name "$slave_name" \
		master "$bridge_name" autoconnect yes >/dev/null || {
		msg_err "$(gettext 'Falha ao criar slave') '$slave_name'"
		return 1
	}

	# VLAN TRUNK
	###########################################################################
	if [[ "$vlan_choice" == "trunk" ]]; then
		msg_info "$(gettext 'Ativando') vlan-filtering"
		cmd_sudo nmcli connection modify "$bridge_name" bridge.vlan-filtering yes

		for v in "${trunk_vlans[@]}"; do
			msg_info "$(gettext 'Adicionando') VLAN $v $(gettext 'ao') trunk"
			cmd_sudo bridge vlan add dev "$iface_phys" vid "$v" master "$bridge_name" 2>/dev/null ||
				msg_warning "$(gettext 'Falha ao adicionar') VLAN $v"
		done
	fi

	# DESATIVAR CONEXÃO ANTIGA
	###########################################################################
	msg_info "$(gettext 'Desativando conexão antiga da interface física')"
	old_con=$(nmcli -t -f NAME,DEVICE connection show | grep ":$iface_phys$" | cut -d: -f1 || true)
	if [[ -n "$old_con" ]]; then
		cmd_sudo nmcli connection down "$old_con" &>/dev/null
		cmd_sudo nmcli connection modify "$old_con" connection.autoconnect no
	fi

	# CONFIGURAR IP NA BRIDGE
	###########################################################################
	if [[ "$use_dhcp" == true ]]; then
		msg_info "$(gettext 'Ativando DHCP na ponte') ${cyan}'$bridge_name'${rst}"
		cmd_sudo nmcli connection modify "$bridge_name" ipv4.method auto ipv4.never-default no >/dev/null
	else
		msg_info "$(gettext 'Aplicando IP manual')"
		cmd_sudo nmcli connection modify "$bridge_name" \
			ipv4.method manual \
			ipv4.addresses "$bridge_ip" \
			ipv4.gateway "$bridge_gw" \
			ipv4.dns-search "" \
			ipv6.method ignore >/dev/null
	fi

	# ATIVAR A BRIDGE
	###########################################################################
	msg_info "$(gettext 'Ativando ponte') ${cyan}'$bridge_name'${rst}"
	cmd_sudo nmcli connection up "$bridge_name" >/dev/null

	# RESUMO
	###########################################################################
	msg_info_tab "${green}---------- $(gettext 'RESUMO') ----------${rst}"
	msg_info_tab "$(gettext 'Ponte')            : ${green}$bridge_name${rst}"
	msg_info_tab "$(gettext 'Interface física') : ${green}$iface_phys${rst}"
	msg_info_tab "Slave            : ${green}$slave_to_use${rst}"
	msg_info_tab "$(gettext 'Conexão') slave    : ${green}$slave_name${rst}"

	case "$vlan_choice" in
	none) msg_info_tab "VLAN             : ${green}$(gettext 'nenhuma')${rst}" ;;
	tagged) msg_info_tab "VLAN Tagged      : ${green}$vlan_id${rst}" ;;
	trunk) msg_info_tab "Trunk            : ${green}VLANs ${trunk_vlans[*]}${rst}" ;;
	esac

	if [[ "$use_dhcp" == true ]]; then
		msg_info_tab "IP               : ${green}DHCP${rst}"
	else
		msg_info_tab "IP $(gettext 'aplicado')      : ${green}$bridge_ip${rst}"
		msg_info_tab "Gateway          : ${green}$bridge_gw${rst}"
	fi

	msg_info_tab "${green}-----------------------------${rst}"
	ensure_qemu_bridge_allowed "$bridge_name"
	msg_ok "$(gettext 'Ponte') ${cyan}'$bridge_name'${rst} $(gettext 'criada e configurada com sucesso.')"
	return 0
}

remove_real_bridge() {
	local bridge_name="$1"
	local iface_phys
	local slave_con
	local bridge_ip
	local bridge_gw

	[[ -z "$bridge_name" ]] && {
		msg_err "Uso: chili-fr -r br0"
		return 1
	}

	# DETECTAR INTERFACE FÍSICA SLAVE
	###########################################################################
	msg_info "$(gettext 'Removendo') bridge '$bridge_name' $(gettext 'com segurança (sem derrubar SSH)')"
	iface_phys=$(ip -o link show | grep -w "master $bridge_name" | awk -F: '{print $2}' | awk '{print $1}')
	#   iface_phys=$(
	#     ip -o link show \
	#     | awk -v br="$bridge_name" '
	#         $0 ~ ("master " br) {
	#           split($2, a, ":");
	#           print a[1];
	#           exit;
	#         }
	#       '
	#   )

	if [[ -z "$iface_phys" ]]; then
		msg_err "$(gettext 'Não foi possível detectar interface física slave.')"
		return 1
	fi

	msg_info "$(gettext 'Interface física slave detectada:') ${cyan}$iface_phys${rst}"

	# ACHAR PERFIL SLAVE (fácil)
	###########################################################################
	slave_con=$(
		nmcli -t -f NAME,TYPE connection show 2>/dev/null |
			grep -m1 "^${bridge_name}-${iface_phys}.*802-3-ethernet" |
			cut -d: -f1
	)

	if [[ -z "$slave_con" ]]; then
		msg_warning "$(gettext 'Nenhum perfil slave encontrado — talvez já removido.')"
	else
		msg_info "$(gettext 'Perfil slave encontrado:') ${cyan}$slave_con${rst}"
	fi

	###########################################################################
	# PEGAR IP E GATEWAY ATUAIS DA BRIDGE
	###########################################################################
	bridge_ip=$(nmcli -g IP4.ADDRESS device show "$bridge_name" | head -n1)
	bridge_gw=$(nmcli -g IP4.GATEWAY device show "$bridge_name" | head -n1)

	msg_info "$(gettext 'IP atual na') bridge: ${cyan}${bridge_ip:-nenhum}${rst}"
	msg_info "Gateway: ${cyan}${bridge_gw:-nenhum}${rst}"

	# IDENTIFICAR PERFIL FÍSICO CORRETO  (teu método definitivo)
	###########################################################################
	local phys_con
	phys_con=$(
		nmcli -t -f NAME,DEVICE,TYPE,SLAVE connection show |
			awk -F: -v dev="$iface_phys" '
        $3 ~ /802-3-ethernet/ && ($2 == dev || $2 == "") && $4 != "bridge" {print $1; exit}
    '
	)

	if [[ -z "$phys_con" ]]; then
		msg_err "$(gettext 'Não foi possível localizar o perfil físico verdadeiro para') '$iface_phys'."
		return 1
	fi
	msg_info "$(gettext 'Perfil físico real:') ${cyan}$phys_con${rst}"

	# RESTAURAR AUTOCONNECT + IP NA FÍSICA (ANTES DE REMOVER A BRIDGE)
	###########################################################################
	msg_info_tab "$(gettext 'Restaurando autoconnect da interface física')"
	cmd_sudo nmcli connection modify "$phys_con" connection.autoconnect yes

	if [[ -n "$bridge_ip" ]]; then
		msg_info_tab "$(gettext 'Aplicando') IP ($bridge_ip) $(gettext 'de volta na interface física')"
		cmd_sudo nmcli connection modify "$phys_con" ipv4.method manual
		cmd_sudo nmcli connection modify "$phys_con" ipv4.addresses "$bridge_ip"
		[[ -n "$bridge_gw" ]] && cmd_sudo nmcli connection modify "$phys_con" ipv4.gateway "$bridge_gw"
	else
		msg_info_tab "$(gettext 'Sem IP detectado — configurando interface física para DHCP')"
		cmd_sudo nmcli connection modify "$phys_con" ipv4.method auto
	fi

	# SUBIR INTERFACE FÍSICA AGORA (ANTES DE REMOVER A BRIDGE)
	###########################################################################
	msg_info_tab "$(gettext 'Subindo interface física ANTES de remover a bridge')"
	echo -n "$green"
	cmd_sudo nmcli connection up "$phys_con" || msg_warning "$(gettext 'Falha ao subir interface física — pode ser esperado via SSH')"
	echo -n "$rst"

	# REMOVER PERFIL SLAVE
	###########################################################################
	if [[ -n "$slave_con" ]]; then
		msg_info_tab "$(gettext 'Removendo conexão slave') '$slave_con'"
		echo -n "$green"
		cmd_sudo nmcli connection delete "$slave_con"
		echo -n "$rst"
	fi

	# REMOVER A BRIDGE
	###########################################################################
	msg_info_tab "$(gettext 'Desativando') bridge '$bridge_name'"
	echo -n "$green"
	cmd_sudo nmcli connection down "$bridge_name" 2>/dev/null
	echo -n "$rst"

	msg_info_tab "$(gettext 'Removendo perfil da') bridge"
	echo -n "$green"
	cmd_sudo nmcli connection delete "$bridge_name" 2>/dev/null
	echo -n "$rst"

	msg_ok "Bridge '$bridge_name' $(gettext 'removida com sucesso e interface') '$iface_phys' $(gettext 'restaurada.')"
}

create_bridge_virbr() {
	local bridge_name="$1"

	if sudo virsh -c qemu:///system net-list --all &>/dev/null; then
		msg_info "virsh $(gettext 'está funcionando e conseguiu listar as redes.')"
	else
		msg_warning "virsh $(gettext 'não conseguiu se conectar ao libvirt.')"
		msg_warning "$(gettext 'Verifique se o serviço libvirtd está ativo com os comandos abaixo:')\n\
sudo systemctl status libvirtd.service
sudo systemctl status libvirtd.socket"
		msg_warning "$(gettext 'DICA: Tente ativar com os comandos abaixo:')\n\
sudo systemctl enable --now libvirtd virtqemud
sudo systemctl restart libvirtd.service"
		die "$(gettext 'Erro fatal')"
	fi

	if [[ -z "$bridge_name" ]]; then
		# Obter o próximo nome de bridge disponível
		bridge_name=$(get_next_free_bridge)
	fi

	# Criar a rede virsh correspondente à nova bridge
	if sudo virsh net-list --all 1>/dev/null; then
		if ! sudo virsh net-list --all | grep -q "$bridge_name" 1>/dev/null; then
			msg_info "$(gettext 'Criando a rede') $bridge_name..."

			# Calcular a faixa de IP com base no nome da bridge
			# O número da bridge será extraído (ex: virbr1 -> 1, virbr2 -> 2, etc.)
			bridge_number=$(echo "$bridge_name" | grep -o '[0-9]*')
			base_ip="172.$((30 + bridge_number)).255.1"
			GATEWAY="$base_ip"
			subnet="255.255.255.0"
			dhcp_range_start="172.$((30 + bridge_number)).255.2"
			dhcp_range_end="172.$((30 + bridge_number)).255.200"

			# Criando o arquivo de configuração temporário para a rede
			tmp_net_config=$(mktemp)

			cat <<EOF >"$tmp_net_config"
<!--
WARNING: THIS IS AN AUTO-GENERATED FILE. CHANGES TO IT ARE LIKELY TO BE
OVERWRITTEN AND LOST. Changes to this xml configuration should be made using:
  virsh net-edit $bridge_name
or other application using the libvirt API.
-->

<network>
  <name>$bridge_name</name>
  <uuid>$(uuidgen)</uuid>
  <forward mode='nat'/>
  <bridge name='$bridge_name' stp='on' delay='0'/>
  <ip address='$base_ip' netmask='$subnet'>
    <dhcp>
      <range start='$dhcp_range_start' end='$dhcp_range_end'/>
    </dhcp>
  </ip>
</network>
EOF
			# Definir a rede usando o arquivo temporário
			sudo virsh net-define "$tmp_net_config" 1>/dev/null
			# Remover o arquivo de configuração temporário após a definição
			sudo rm -f "$tmp_net_config"
		fi
	else
		die "$(gettext 'erro fatal!')"
	fi

	# Tornar a nova bridge persistente
	msg_info "$(gettext 'Tornando') $bridge_name $(gettext 'persistente...')"
	msg_info "$(gettext 'Iniciando a rede') $bridge_name..."
	sudo virsh net-autostart "$bridge_name" 1>/dev/null

	if ! sudo virsh net-start "$bridge_name" 1>/dev/null; then
		msg_err "$(gettext 'Falha ao iniciar a rede') $bridge_name. $(gettext 'Tentando novamente.')"
		sudo virsh net-destroy "$bridge_name" 1>/dev/null
		sudo virsh net-start "$bridge_name" 1>/dev/null
	fi

	# Obter o próximo nome de interface TAP disponível
	#tap_name=$(get_next_free_tap)-"$bridge_name"
	tap_name="tap-$bridge_name"

	# Criar a interface TAP (ex: tap0, tap1, tap2...)
	msg_info "$(gettext 'Criando a interface') TAP $tap_name..."
	sudo ip tuntap add dev "$tap_name" mode tap 1>/dev/null

	# Colocar a interface TAP para up
	msg_info "$(gettext 'Ativando a interface') TAP $tap_name..."
	sudo ip link set "$tap_name" up 1>/dev/null

	# Adicionar a interface TAP à bridge recém-criada
	msg_info "$(gettext 'Adicionando') $tap_name $(gettext 'à') bridge $bridge_name..."
	sudo brctl addif "$bridge_name" "$tap_name" 1>/dev/null

	# Verificar se a bridge e o TAP foram configurados corretamente
	msg_info "$(gettext 'Verificando a associação de interfaces à') bridge $bridge_name..."
	brctl show "$bridge_name" 1>/dev/null

	# Exibir as interfaces para verificar se tudo está funcionando
	msg_info "$(gettext 'Verificando as interfaces de rede...')"
	ip addr show "$bridge_name" 1>/dev/null
	ip addr show "$tap_name" 1>/dev/null

	sudo virsh net-info "$bridge_name"
	msg_info "$(gettext 'Configuração concluída!')"
	exit
}

remove_virbr_bridge_and_tap() {
	local bridge_name="$1"
	local tap_name

	#tap_name="tap$(echo "$bridge_name" | sed 's/[^0-9]*//g')" # Ajuste para pegar o número correto do tap
	tap_name="tap-$bridge_name"

	# Remover a bridge
	msg_info "$(gettext 'Removendo') bridge $bridge_name..."
	sudo ip link set "$bridge_name" down 1>/dev/null
	sudo brctl delbr "$bridge_name" 1>/dev/null

	# Remover a interface TAP associada
	if ip link show "$tap_name" &>/dev/null; then
		msg_info "$(gettext 'Removendo') interface TAP $tap_name..."
		sudo ip link set "$tap_name" down 1>/dev/null
		sudo ip tuntap del dev "$tap_name" mode tap 1>/dev/null
	else
		msg_err "$(gettext 'A interface') TAP $tap_name $(gettext 'não existe.')"
	fi

	# Remover a rede do libvirt
	msg_info "$(gettext 'Removendo a rede do') libvirt..."
	sudo virsh net-destroy "$bridge_name" 1>/dev/null
	sudo virsh net-autostart --disable "$bridge_name" 1>/dev/null
	sudo virsh net-undefine "$bridge_name" 1>/dev/null
	sudo ip link delete "$bridge_name" 1>/dev/null
	sudo systemctl restart libvirtd 1>/dev/null

	# Remover a configuração da rede do libvirt, caso fique residuos
	local network_config="/etc/libvirt/qemu/networks/${bridge_name}.xml"
	local network_config_autostart="/etc/libvirt/qemu/networks/autostart/${bridge_name}.xml"
	msg_info "$(gettext 'Removendo o arquivo de configuração da rede') $bridge_name..."
	sudo rm -fv "$network_config" 1>/dev/null
	sudo rm -fv "$network_config_autostart" 1>/dev/null

	sudo virsh net-info "$bridge_name" 1>/dev/null
	msg_ok "Bridge $bridge_name e TAP $tap_name removidos com sucesso."
	exit 0
}

######################################################################################################

# Função para obter as interfaces do tipo bridge
get_bridge_interfaces() {
	#  brctl show | awk 'NR > 1 {printf "%s ", $1}'
	#	brctl show | awk 'NR > 1 {printf "%s ", $1}' | sed 's/ $//'
	ip -o link show type bridge | awk -F': ' '{print $2}'
}

list_bridges_detailed() {
	ip -o link show type bridge |
		awk '
   {
     name=$2; sub(":", "", name)
     state=""; mac=""

     # captura STATE e MAC
     for (i=1; i<=NF; i++) {
       if ($i=="state") state=$(i+1)
       if ($i=="link/ether") mac=$(i+1)
     }

     # pegar IP usando getline e analisando "line" (o certo!)
     ip=""
     cmd = "ip -o -4 addr show dev " name " 2>/dev/null"
     while ((cmd | getline line) > 0) {
       split(line, f, " ")
       for (k=1; k<=length(f); k++) {
         if (f[k] == "inet") {
           ip = f[k+1]
         }
       }
     }
     close(cmd)

     printf "  %-20s %-8s %-20s %-18s\n", name, state, mac, ip
   }'
}

# Função para obter os arquivos RAW no diretório $HOME_DIR/vdisk/
get_raw_images() {
	local dir="${HOME_DIR:-$HOME}/vdisk"
	# Lista os arquivos com extensão .img, removendo o caminho e separando por espaço
	#  find "$dir" -maxdepth 1 -type f -name "*.img" -exec basename {} \; | tr '\n' ' ' | sed 's/ $//'
	find -L "$dir/" -maxdepth 1 -type f \( -name "*.img" -o -name "*.qcow2" \) -exec basename {} \; | tr '\n' ' ' | sed 's/ $//'
}

supports_uefi() {
	fdisk -l "$1" 2>/dev/null | grep -q "EFI"
}

detect_audio_server() {
	if pgrep -x pipewire >/dev/null; then
		echo "pipewire"
	elif pgrep -x pulseaudio >/dev/null; then
		echo "pa"
	elif pgrep -x jackd >/dev/null; then
		echo "jack"
	else
		echo "none"
	fi
}

detect_audio_serverOLD() {
	for s in pipewire pulseaudio jackd; do
		pgrep -x "$s" &>/dev/null && {
			echo "$s"
			return
		}
	done
	echo "none"
}

#----------------------------------------------------------------------------
# Perfis de máquina (-M|--machine)
# Um perfil (.conf, formato chave="valor") define a identidade SMBIOS/DMI
# (fabricante, modelo, BIOS, placa, chassi) e o hardware da VM (cpu, núcleos,
# memória, vídeo, rede, barramento de disco, UEFI), para simular a instalação
# do sistema em uma máquina específica.
#----------------------------------------------------------------------------
readonly -a MACHINE_KEYS=(
	desc
	vendor product version family sku serial uuid
	board_vendor board_product board_version board_serial board_asset
	bios_vendor bios_version bios_date
	chassis_type chassis_vendor chassis_version chassis_serial chassis_asset chassis_sku
	cpu cpu_name smp mem video net disk_bus uefi
)

# tipos de chassi SMBIOS (DMTF DSP0134 - System Enclosure Type)
declare -A CHASSIS_TYPES=(
	[other]=1 [desktop]=3 [lowprofile]=4 [minitower]=6 [tower]=7
	[portable]=8 [laptop]=9 [notebook]=10 [handheld]=11 [allinone]=13
	[subnotebook]=14 [spacesaving]=15 [tablet]=30 [convertible]=31
	[detachable]=32 [minipc]=35 [stickpc]=36
)

chassis_type_num() {
	local t="${1,,}"
	t="${t//[-_ ]/}"
	[[ -z "$t" ]] && return 1
	if [[ -n "${CHASSIS_TYPES[$t]}" ]]; then
		echo "${CHASSIS_TYPES[$t]}"
		return 0
	fi
	if [[ "$t" =~ ^[0-9]+$ ]] && ((t >= 1 && t <= 36)); then
		echo "$t"
		return 0
	fi
	return 1
}

machine_find() {
	local name="$1" f
	local -a candidates=("$MACHINES_USER_DIR/$name.conf" "$MACHINES_SYS_DIR/$name.conf")
	# caminho explícito para um arquivo de perfil
	[[ "$name" == */* || "$name" == *.conf ]] && candidates=("$name")
	for f in "${candidates[@]}"; do
		if [[ -f "$f" ]]; then
			echo "$f"
			return 0
		fi
	done
	return 1
}

machine_load() {
	local file="$1" line key value
	machine=()
	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line#"${line%%[![:space:]]*}"}"
		[[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
		key="${line%%=*}"
		key="${key%"${key##*[![:space:]]}"}"
		value="${line#*=}"
		value="${value#"${value%%[![:space:]]*}"}"
		if [[ "$value" =~ ^\"([^\"]*)\" ]] || [[ "$value" =~ ^\'([^\']*)\' ]]; then
			value="${BASH_REMATCH[1]}"
		else
			value="${value%%#*}"
			value="${value%"${value##*[![:space:]]}"}"
		fi
		if [[ " ${MACHINE_KEYS[*]} " == *" $key "* ]]; then
			machine[$key]="$value"
		else
			msg_warn "$(gettext 'perfil') ${cyan}${file##*/}${rst}: $(gettext 'chave desconhecida') ${yellow}${key}${rst} ($(gettext 'ignorada'))"
		fi
	done <"$file"
}

sh_list_machines() {
	local dir f n found=false
	for dir in "$MACHINES_USER_DIR" "$MACHINES_SYS_DIR"; do
		[[ -d "$dir" ]] || continue
		msg_info "${cyan}${dir}${rst}"
		for f in "$dir"/*.conf; do
			[[ -f "$f" ]] || continue
			found=true
			n="${f##*/}"
			n="${n%.conf}"
			machine_load "$f"
			printf "  %s%-30s%s %s\n" "$yellow" "$n" "$rst" "${machine[desc]:-${machine[vendor]} ${machine[product]}}"
		done
	done
	machine=()
	$found || msg_warn "$(gettext 'Nenhum perfil de máquina encontrado.') $(gettext 'Crie um com') ${cyan}$APP --machine-from-host${rst}"
}

dmi_read() {
	# lê um campo DMI sem aspas e sem espaços nas pontas (alguns BIOS, como os
	# da ASUS, preenchem os textos com espaços: "1.0       ")
	local f="/sys/class/dmi/id/$1" v
	[[ -r "$f" ]] || return 0
	v=$(tr -d '\n"' <"$f" 2>/dev/null)
	v="${v#"${v%%[![:space:]]*}"}"
	v="${v%"${v##*[![:space:]]}"}"
	printf '%s' "$v"
}

dmi_is_generic() {
	# texto de fábrica que o BIOS deixa sem preencher - não serve para descrição
	local v="${1,,}"
	v="${v#"${v%%[![:space:]]*}"}"
	v="${v%"${v##*[![:space:]]}"}"
	case "$v" in
	'' | tbd | none | n/a | na | '*' | 'not specified' | 'not applicable' | 'not available' | 'not defined' | \
		'to be filled by o.e.m.' | 'default string' | 'system version' | 'system product name' | \
		'type1productconfigid' | 'chassis version' | 'base board version' | 'x.x' | 'revision mp')
		return 0
		;;
	esac
	return 1
}

cpu_model_from_flags() {
	# cpu_model_from_flags <vendor_id> <flags>
	# Escolhe o modelo de CPU do QEMU mais novo cujas instruções a CPU real possui,
	# para a VM não oferecer instruções que a máquina não tem (ex: AES nos Core i3
	# antigos). AMD, CPU mais nova que Skylake ou desconhecida -> host.
	local vendor="$1" flags=" $2 " model extra=''
	_has() {
		local x
		for x; do [[ "$flags" == *" $x "* ]] || return 1; done
	}

	if [[ "$vendor" != GenuineIntel ]] || _has avx512f || _has sha_ni || _has gfni; then
		echo host
		return
	fi
	_has lm ssse3 || { echo qemu64; return; }

	# nível pela geração (sem AES/PCLMUL, que a Intel cortou de vários i3/Pentium/Celeron)
	model=Conroe
	if _has sse4_1; then model=Penryn; fi
	if [[ $model == Penryn ]] && _has sse4_2 popcnt; then model=Nehalem; fi
	if [[ $model == Nehalem ]] && _has avx xsave; then model=SandyBridge; fi
	if [[ $model == SandyBridge ]] && _has f16c; then model=IvyBridge; fi
	if [[ $model == IvyBridge ]] && _has avx2 fma bmi1 bmi2 movbe; then model=Haswell-noTSX; fi
	if [[ $model == Haswell-noTSX ]] && _has adx rdseed; then model=Broadwell-noTSX; fi
	if [[ $model == Broadwell-noTSX ]] && _has clflushopt xsavec; then model=Skylake-Client-noTSX-IBRS; fi

	case "$model" in
	Conroe | Penryn) ;;
	Nehalem)
		_has aes pclmulqdq && model=Westmere
		;;
	*)
		_has aes || extra+=',-aes'
		_has pclmulqdq || extra+=',-pclmulqdq'
		[[ $model != SandyBridge ]] && ! _has rdrand && extra+=',-rdrand'
		;;
	esac
	echo "${model}${extra}"
}

sh_machine_from_host() {
	local name="$1" out key val bus efi memgb cpu_name cpu_model
	local -a pairs

	[[ -d /sys/class/dmi/id ]] || die "$(gettext 'DMI não disponível neste host') (/sys/class/dmi/id)"

	[[ -z "$name" ]] && name="$(dmi_read sys_vendor)-$(dmi_read product_name)"
	name="${name,,}"
	name="${name//[^a-z0-9._-]/-}"
	while [[ "$name" == *--* ]]; do name="${name//--/-}"; done
	name="${name#-}"
	name="${name%-}"
	[[ -z "$name" ]] && name='host'

	local config_existia=true
	[[ -d "$REAL_HOME/.config" ]] || config_existia=false
	mkdir -p "$MACHINES_USER_DIR"
	out="$MACHINES_USER_DIR/$name.conf"
	if has_file "$out" && ! readconf "$(gettext 'Perfil já existe, sobrescrever?') ${out}"; then
		exit 1
	fi

	cpu_name=$(awk -F': ' '/^model name/{print $2; exit}' /proc/cpuinfo)
	cpu_name="${cpu_name//\"/}"
	cpu_model=$(cpu_model_from_flags \
		"$(awk -F': ' '/^vendor_id/{print $2; exit}' /proc/cpuinfo)" \
		"$(awk -F': ' '/^flags/{print $2; exit}' /proc/cpuinfo)")
	if compgen -G '/sys/block/nvme*' >/dev/null; then bus='nvme'; else bus='sata'; fi
	[[ -d /sys/firmware/efi ]] && efi=true || efi=false
	memgb=$(awk '/^MemTotal/{printf "%d", ($2/1048576)+0.999}' /proc/meminfo)

	pairs=(
		"desc=$(dmi_read sys_vendor) $(dmi_read product_name)"
		"vendor=$(dmi_read sys_vendor)"
		"product=$(dmi_read product_name)"
		"version=$(dmi_read product_version)"
		"family=$(dmi_read product_family)"
		"sku=$(dmi_read product_sku)"
		"serial=$(dmi_read product_serial)"
		"uuid=$(dmi_read product_uuid)"
		"board_vendor=$(dmi_read board_vendor)"
		"board_product=$(dmi_read board_name)"
		"board_version=$(dmi_read board_version)"
		"board_serial=$(dmi_read board_serial)"
		"board_asset=$(dmi_read board_asset_tag)"
		"bios_vendor=$(dmi_read bios_vendor)"
		"bios_version=$(dmi_read bios_version)"
		"bios_date=$(dmi_read bios_date)"
		"chassis_type=$(dmi_read chassis_type)"
		"chassis_vendor=$(dmi_read chassis_vendor)"
		"chassis_version=$(dmi_read chassis_version)"
		"chassis_serial=$(dmi_read chassis_serial)"
		"chassis_asset=$(dmi_read chassis_asset_tag)"
		"cpu=$cpu_model"
		"cpu_name=$cpu_name"
		"smp=$(nproc)"
		"disk_bus=$bus"
		"uefi=$efi"
	)
	# product_version costuma trazer o nome comercial (ex: Lenovo: "ThinkPad T14 Gen 2i")
	# (ignora textos de fábrica como "TBD", "Not Specified", "To be filled by O.E.M.")
	val=$(dmi_read product_version)
	dmi_is_generic "$val" || pairs[0]+=" - $val"

	{
		echo "# perfil de máquina gerado por $APP --machine-from-host em $(date '+%d/%m/%Y %H:%M')"
		echo "# serial/uuid só são lidos quando executado como root"
		echo "# cpu: modelo do QEMU escolhido pelas instruções (flags) da CPU real"
		for val in "${pairs[@]}"; do
			key="${val%%=*}"
			val="${val#*=}"
			[[ -z "$val" ]] && continue
			printf '%s="%s"\n' "$key" "$val"
		done
		echo "#mem=\"${memgb}G\"  # RAM real do host - descomente com cuidado"
		echo "#video=\"virtio-vga-gl\""
		echo "#net=\"e1000e\""
	} >"$out"

	# rodando com sudo/doas: devolve a posse ao usuário real
	if [[ -n "$REAL_USER" ]]; then
		chown -R "$REAL_USER": "$REAL_HOME/.config/chili-fr" 2>/dev/null
		$config_existia || chown "$REAL_USER": "$REAL_HOME/.config" 2>/dev/null
	fi

	msg_ok "$(gettext 'Perfil criado:') ${cyan}${out}${rst}"
	cat "$out"
	msg_ex_tab "$APP ${cyan}-M $name${rst} file.iso"
	exit 0
}

smbios_escape() {
	# no parser de opções do qemu a vírgula é escapada como ',,'
	printf '%s' "${1//,/,,}"
}

smbios_add() {
	# smbios_add <type> campo=valor ... (ignora campos vazios)
	local type="$1" pair key val args
	local -i n=0
	shift
	args="type=$type"
	for pair in "$@"; do
		key="${pair%%=*}"
		val="${pair#*=}"
		[[ -z "$val" ]] && continue
		args+=",$key=$(smbios_escape "$val")"
		((++n))
	done
	((n)) && qemu_options+=(-smbios "$args")
}

smbios_write_type3() {
	# Gera a tabela SMBIOS type 3 (chassi) em binário, pois o '-smbios type=3'
	# do qemu não permite definir o tipo do chassi (notebook, desktop, etc).
	# smbios_write_type3 <arquivo> <tipo> <fabricante> <versao> <serial> <asset> <sku>
	local out="$1" ctype="$2" s strs='' hdr i
	local -i idx=0
	local -a ref=(0 0 0 0 0)
	local -a vals=("$3" "$4" "$5" "$6" "$7")

	for i in "${!vals[@]}"; do
		s="${vals[i]}"
		[[ -z "$s" ]] && continue
		((++idx))
		ref[i]=$idx
		strs+="${s//\\/\\\\}\\x00"
	done
	[[ -z "$strs" ]] && strs='\x00'

	# type=3, length=0x16, handle=0x0300 (o mesmo que o qemu referencia no type 2)
	# boot-up/power/thermal state=safe(3), security=none(3), altura=0, 1 cabo de força,
	# 0 elementos contidos, sku por último
	printf -v hdr '\\x03\\x16\\x00\\x03\\x%02x\\x%02x\\x%02x\\x%02x\\x%02x\\x03\\x03\\x03\\x03\\x00\\x00\\x00\\x00\\x00\\x01\\x00\\x00\\x%02x' \
		"${ref[0]}" "$ctype" "${ref[1]}" "${ref[2]}" "${ref[3]}" "${ref[4]}"
	printf '%b%b\x00' "$hdr" "$strs" >"$out"
}

disk_device() {
	# disk_device <drive_id> <bootindex> - anexa o disco no barramento do perfil
	case "$disk_bus" in
	sata)
		qemu_options+=(-device ide-hd,drive="$1",bootindex="$2")
		;;
	nvme)
		local serial
		((++disk_serial))
		printf -v serial 'CHILIFR%04d' "$disk_serial"
		qemu_options+=(-device nvme,drive="$1",serial="$serial",bootindex="$2")
		;;
	*)
		qemu_options+=(-device virtio-blk,drive="$1",bootindex="$2")
		;;
	esac
}

main::apply_machine_profile() {
	[[ -z "$machine_name" ]] && return
	local v

	if ! machine_file=$(machine_find "$machine_name"); then
		sh_list_machines
		die "$(gettext 'Perfil de máquina não encontrado:') ${yellow}${machine_name}"
	fi
	machine_load "$machine_file"
	msg_tick "$(gettext 'Perfil de máquina:') ${bcyan}${machine[desc]:-$machine_name}${rst} (${machine_file})"

	if [[ -n "${machine[mem]}" ]] && ! $LPARAM_MEM; then
		[[ "${machine[mem]}" =~ ^[0-9]+[MGmg]$ ]] || die "$(gettext 'perfil: valor inválido para') mem: ${machine[mem]}"
		xmem="${machine[mem]}"
	fi
	if [[ -n "${machine[video]}" ]] && ! $LPARAM_VIDEO; then
		[[ " ${avideodevice[*]} " == *" ${machine[video]} "* ]] || die "$(gettext 'perfil: valor inválido para') video: ${machine[video]}"
		videodevice="${machine[video]}"
	fi
	if [[ -n "${machine[net]}" ]] && ! $netchoosedriver; then
		netdevice="${machine[net]}"
	fi
	if [[ -n "${machine[uefi]}" ]] && ! $LPARAM_UEFI; then
		case "${machine[uefi],,}" in
		true | yes | sim | on | 1) uefi=true ;;
		false | no | nao | não | off | 0) uefi=false ;;
		*) die "$(gettext 'perfil: valor inválido para') uefi: ${machine[uefi]}" ;;
		esac
	fi
	if [[ -n "${machine[disk_bus]}" ]]; then
		[[ "${machine[disk_bus]}" =~ ^(virtio|sata|nvme)$ ]] || die "$(gettext 'perfil: valor inválido para') disk_bus: ${machine[disk_bus]} (virtio|sata|nvme)"
		disk_bus="${machine[disk_bus]}"
	fi
	if [[ -n "${machine[smp]}" && ! "${machine[smp]}" =~ ^[0-9]+$ ]]; then
		die "$(gettext 'perfil: valor inválido para') smp: ${machine[smp]}"
	fi
	if [[ -n "${machine[chassis_type]}" ]]; then
		v=$(chassis_type_num "${machine[chassis_type]}") || die "$(gettext 'perfil: valor inválido para') chassis_type: ${machine[chassis_type]}"
		machine[chassis_type]="$v"
	fi
}

main::configure_smbios() {
	[[ -z "$machine_name" ]] && return
	local t3bin base

	smbios_add 0 \
		"vendor=${machine[bios_vendor]}" \
		"version=${machine[bios_version]}" \
		"date=${machine[bios_date]}" \
		"uefi=$($uefi && echo on)"
	smbios_add 1 \
		"manufacturer=${machine[vendor]}" \
		"product=${machine[product]}" \
		"version=${machine[version]}" \
		"serial=${machine[serial]}" \
		"uuid=${machine[uuid]}" \
		"sku=${machine[sku]}" \
		"family=${machine[family]}"
	smbios_add 2 \
		"manufacturer=${machine[board_vendor]}" \
		"product=${machine[board_product]}" \
		"version=${machine[board_version]}" \
		"serial=${machine[board_serial]}" \
		"asset=${machine[board_asset]}"

	if [[ -n "${machine[chassis_type]}" ]]; then
		base="${machine_file##*/}"
		base="${base%.conf}"
		mkdir -p "$HOME_DIR/smbios"
		t3bin="$HOME_DIR/smbios/${base}-type3.bin"
		smbios_write_type3 "$t3bin" "${machine[chassis_type]}" \
			"${machine[chassis_vendor]:-${machine[vendor]}}" \
			"${machine[chassis_version]}" \
			"${machine[chassis_serial]}" \
			"${machine[chassis_asset]}" \
			"${machine[chassis_sku]}"
		qemu_options+=(-smbios file="$t3bin")
	else
		smbios_add 3 \
			"manufacturer=${machine[chassis_vendor]}" \
			"version=${machine[chassis_version]}" \
			"serial=${machine[chassis_serial]}" \
			"asset=${machine[chassis_asset]}" \
			"sku=${machine[chassis_sku]}"
	fi
	msg_info "$(gettext 'SMBIOS:') ${cyan}${machine[vendor]} ${machine[product]}${rst} - chassi ${yellow}${machine[chassis_type]:-default}${rst} - disco ${yellow}${disk_bus}${rst}"
}

sh_version() {
	cat <<-EOF
		${bold}${cyan}${0##*/} v${VERSION}${rst}
		${APPDESC}
		${VERSION}
		${bold}${black}Copyright (C) 2019-2025 ChiliLinux Development Team${black}
		${bold}${black}Copyright (C) 2019-2025 Vilmar Catafesta${black}

		  $(gettext 'Este é um software livre: você é livre para alterá-lo e redistribuí-lo.')
		  $(gettext 'O') ${APP} $(gettext 'é disponibilizado para você sob a') ${yellow}$(gettext 'Licença MIT')${black}, e
		  $(gettext 'inclui software de código aberto sob uma variedade de outras licenças.')
		  $(gettext 'Você pode ler instruções sobre como baixar e criar para você mesmo')
		  $(gettext 'o código fonte específico usado para criar esta cópia.')
		  ${red}$(gettext 'Este programa vem com absolutamente NENHUMA garantia.')
		  ${rst}
	EOF
	exit 0
}

sh_usage() {
	cat <<EOF
$(gettext 'uso:') ${orange}$APP${reset} [$(gettext 'Opções')]
${cyan}$(gettext 'Opções:')${reset}
    ${rst}-b|--bridge ${orange}<name>                     ${cyan}# $(gettext 'inicia rede em modo') bridge - ex: -b br0 - (default: ${yellow}NAT${rst})
    ${rst}-c|--create_real_bridge ${orange}<name>         ${cyan}# $(gettext 'criar real') bridge - ex: -c br0
    ${rst}-r|--remove_real_bridge ${orange}<name>         ${cyan}# $(gettext 'remover real') bridge - ex: -r br0
    ${rst}   --create_virbr_bridge ${orange}<name>        ${cyan}# $(gettext 'criar') virbr bridge - ex: --create_virbr_bridge br0
    ${rst}   --remove_virbr_bridge ${orange}<name>        ${cyan}# $(gettext 'remover') virbr bridge - ex: --remove_virbr_bridge br0
    ${rst}-d|--drive ${orange}<device>                    ${cyan}# $(gettext 'anexa disco externo') - ex: -d /dev/sdX - (default: ${yellow}none${rst})
    ${rst}-m|--memory ${orange}<mem>                      ${cyan}# $(gettext 'memória inicial de convidado') - ex: -m 16G (default: ${yellow}8GB${rst})
${red}new ${rst}-M|--machine ${orange}<perfil>                  ${cyan}# $(gettext 'simula uma máquina (fabricante/modelo/chassi/hardware)') - ex: -M dell-latitude-5420
${red}new ${rst}   --list-machines                     ${cyan}# $(gettext 'lista os perfis de máquina disponíveis')
${red}new ${rst}   --machine-from-host${orange}[=nome]          ${cyan}# $(gettext 'cria um perfil a partir desta máquina') (${yellow}sudo${cyan}: $(gettext 'inclui serial/uuid')${cyan})
    ${rst}-v|--vdisk ${orange}<filename.img|qcow2>        ${cyan}# $(gettext 'usa um disco virtual interno') - (default: ${yellow}none${rst})
    ${rst}   --cvdisk ${orange}<filename>                 ${cyan}# $(gettext 'cria um disco virtual para uso interno')
    ${rst}   --rvdisk ${orange}<filename>                 ${cyan}# $(gettext 'remove um disco virtual')
    ${rst}-g|--video ${orange}<video_driver>              ${cyan}# virtio-vga,virtio-gpu-pci,qxl-vga,VGA,cirrus-vga,ati-vga,virtio-gpu-pci,bochs-display - (default: ${yellow}virtio-vga-gl${rst})
${red}new ${rst}   --display ${orange}<display_backend>         ${cyan}# gtk,sdl,egl-headless,curses,spice-app,dbus,none - (default: ${yellow}gtk${rst})
${red}new ${rst}-C|--cache ${orange}<mode>                      ${cyan}# none,writeback,writethrough,directsync,unsafe - (default: ${yellow}none${rst})
    ${rst}-N|--network ${orange}<net_driver>              ${cyan}# virtio-net-pci,e1000,rtl8139,vmxnet3 - (default: ${yellow}virtio-pc${rst})
    ${rst}-n|--nocolor                           ${cyan}# $(gettext 'remover cores da saída') - (default: ${yellow}color${rst})
    ${rst}-s|--spice                             ${cyan}# $(gettext 'ativar o') spice - (default: ${yellow}$(gettext 'desligado')${rst})
    ${rst}-t|--tty                               ${cyan}# $(gettext 'ativar modo') tty only - (default: ${yellow}$(gettext 'desligado')${rst})
    ${rst}-l|--list                              ${cyan}# $(gettext 'listar discos virtuais')
    ${rst}-u|--uefi                              ${cyan}# $(gettext 'inicialização em') UEFI - (default: ${yellow}BIOS${rst})
    ${rst}-V|--version                           ${cyan}# $(gettext 'exibe a versão do aplicativo')
    ${rst}-o|--output                            ${cyan}# $(gettext 'exibe a saída gerada pelo comando e sai')
    ${rst}-a|--audio ${orange}<pipewire|pa|jack>          ${cyan}# $(gettext 'audio server') - (default: ${yellow}auto${rst})
    ${rst}   --share                             ${cyan}# $(gettext 'compartilha pasta local na VM - (ex: --share /home/user/Imagens)')
    ${rst}-h|-H|--help                           ${cyan}# $(gettext 'imprime este ajuda')
  ${cyan}$(gettext 'Exemplos:')${rst}
    $ ${orange}$APP${reset} -u -b br0 file.iso          ${cyan}#$(gettext 'Execute uma imagem, em ponte, usando') UEFI ${rst}
    $ ${orange}$APP${reset} -u -s -b br0 file.iso       ${cyan}#$(gettext 'Execute uma imagem, em ponte, usando spice, usando UEFI') ${rst}
    $ ${orange}$APP${reset} -u file.img                 ${cyan}#$(gettext 'Execute uma imagem, em NAT, usando UEFI') ${rst}
    $ ${orange}$APP${reset} -b br0 /dev/sdX             ${cyan}#$(gettext 'Execute uma device, em ponte, usando UEFI') ${rst}
    $ ${orange}$APP${reset} -u -m 16G -b br0 /dev/sdX   ${cyan}#$(gettext 'Execute uma device, em ponte, 16Gb memória, usando UEFI') ${rst}
    $ ${orange}$APP${reset} -a pipewire /dev/sdX        ${cyan}#$(gettext 'Execute uma device, em NAT, usando audio pipewire') ${rst}
    $ ${orange}$APP${reset} file.iso                    ${cyan}#$(gettext 'Execute uma imagem usando BIOS')${rst}
    $ ${orange}$APP${reset} -b file.img                 ${cyan}#$(gettext 'Execute uma imagem, em ponte, usando BIOS')${rst}
    $ ${orange}$APP${reset} -m 16G /dev/sdX             ${cyan}#$(gettext 'Execute uma device, 16GB memória, usando BIOS') ${rst}
    $ ${orange}$APP${reset} -M dell-latitude-5420 file.iso sda.img  ${cyan}#$(gettext 'Simula a instalação num notebook Dell Latitude 5420') ${rst}
  ${bold}${cyan}$(gettext 'Uso mais comum:')${rst}
    $ ${orange}$APP${reset} [-u] /dev/sdX ${rst}
    $ ${orange}$APP${reset} [-u] filename.iso sda.img ${rst}
    $ ${orange}$APP${reset} $HOME_DIR/vdisk/sda.img ${rst}
    $ ${orange}$APP${reset} $HOME_DIR/vdisk/vda.qcow2 ${rst}
    $ ${orange}$APP${reset} -u --video VGA --display sdl $HOME_DIR/downloads/filename.iso ${rst}
    $ ${orange}$APP${reset} -u --video virtio-vga-gl --display gtk $HOME_DIR/downloads/filename.iso ${rst}
EOF
	exit 0
}

sh_createVdiskFiles() {
	local aBlockDisk=(sda.img sdb.img sdc.img sdd.img)
	local aBlockDiskQcow2=(vda.qcow2 vdb.qcow2 vdc.qcow2 vdd.qcow2)
	local file

	if [[ ! -d "$HOME_DIR/vdisk/" ]]; then
		msg_info "$(gettext 'Criando diretórios de trabalho')"
		mkdir -p "$HOME_DIR/vdisk/" &>/dev/null
	fi

	msg_info "$(gettext 'Setando permissões no diretórios de trabalho')"
	sudo chmod 1777 "$HOME_DIR/" &>/dev/null

	for file in "${aBlockDisk[@]}"; do
		if ! has_file "$HOME_DIR/vdisk/$file"; then
			msg_info "$(gettext 'Criando disco virtual') '$file' $(gettext 'no diretórios de trabalho')"
			qemu-img create $HOME_DIR/vdisk/$file -f raw 32G &>/dev/null
		fi
	done
	for file in "${aBlockDiskQcow2[@]}"; do
		if ! has_file "$HOME_DIR/vdisk/$file"; then
			msg_info "$(gettext 'Criando disco virtual') '$file' $(gettext 'no diretórios de trabalho')"
			qemu-img create -f qcow2 $HOME_DIR/vdisk/$file 32G &>/dev/null
		fi
	done
}

sh_setup() {
	local DISTRO=$(detect_distro)
	msg_info "$(gettext 'Instalando necessários pacotes'): $DISTRO"

	case "$DISTRO" in
	void*)
		msg_ex "$(gettext 'Rodando no') VOID"
		if ! cmd_sudo xbps-install -Sy \
			qemu \
			edk2-ovmf \
			ncurses \
			spice-vdagent \
			virt-viewer \
			python \
			libvirt \
			findutils \
			gawk \
			bridge-utils \
			seabios \
			1>/dev/null 2>&1; then
			die "$(gettext '[ERRO] Falha ao instalar pacotes.')"
		fi
		;;
	chililinux | arch)
		msg_ex "$(gettext 'Rodando no') ${DISTRO^^}"
		cmd_sudo pacman -S --needed --quiet --noconfirm \
			qemu-full \
			edk2-ovmf \
			ncurses \
			spice-vdagent \
			virt-viewer \
			python \
			libvirt \
			findutils \
			gawk \
			bridge-utils \
			seabios 1>/dev/null
		;;
	manjaro) : ;;
	debian) : ;;
	ubuntu) : ;;
	fedora) : ;;
	endeavouros) : ;;
	*)
		echo "$(gettext 'Outra distro:') $DISTRO"
		;;
	esac

	sh_createVdiskFiles
	sh_start_vdagentd "$DISTRO"
}

sh_create_vdisk_file() {
	msg_info "$(gettext 'Criando diretórios de trabalho')"
	mkdir -p "$HOME_DIR/vdisk" &>/dev/null
	msg_info "$(gettext 'Setando permissões no diretórios de trabalho')"
	sudo chmod 1777 "$HOME_DIR/" &>/dev/null
	sudo chown $USER:$USER "$HOME_DIR/" -R &>/dev/null

	while true; do
		sh_list_vdisks
		get 10 10 "$(gettext 'Entre com o nome do disco (sem extensão)') - ex vda  : " cvdisk_name
		get 11 10 "$(gettext 'Entre com o tamanho do disco virtual em GB') - ex 32 : " cvdisk_size

		if test -e $HOME_DIR/vdisk/$cvdisk_name.img &>/dev/null; then
			if readconf "$(gettext 'Disco virtual já existe, escolha outro nome. Tentar novamente?')"; then
				continue
			fi
		else
			if qemu-img create $HOME_DIR/vdisk/$cvdisk_name.img -f raw "$cvdisk_size"G &>/dev/null; then
				msg_ok "$(gettext 'Disco virtual '$HOME_DIR/vdisk/$cvdisk_name.img' criado com sucesso')"
				echo -n $green
				ls -lh $HOME_DIR/vdisk
				echo -n $rst
				replicate '='
			else
				die "$(gettext 'Falha na criação do disco virtual') $HOME_DIR/vdisk/$cvdisk_name.img"
			fi
		fi
		break
	done
}

tilde_path() {
	# /home/fulano/x -> ~/x (só para exibição)
	local p="$1"
	if [[ "$p" == "$HOME" ]]; then
		p='~'
	elif [[ "$p" == "$HOME"/* ]]; then
		p="~/${p#"$HOME"/}"
	fi
	printf '%s' "$p"
}

file_row() {
	# file_row <arquivo> <largura do nome> [nome exibido] : nome, tamanho, data e "(vazio)"
	local f="$1" w="$2" disp="${3:-$(tilde_path "$1")}" size epoch hsize hdate empty=''
	read -r size epoch < <(stat -L -c '%s %Y' "$f" 2>/dev/null) || return
	hsize=$(numfmt --to=iec --suffix= "$size" 2>/dev/null || echo "$size")
	hdate=$(date -d "@$epoch" '+%d %b %Y %H:%M' 2>/dev/null)
	# qcow2 recém-criado ocupa ~200K: nunca recebeu instalação
	[[ "$f" == *.qcow2 ]] && ((size < 1048576)) && empty="  ${yellow}($(gettext 'vazio'))${rst}"
	printf "    %-*s %8s   %s%b\n" "$w" "$disp" "$hsize" "$hdate" "$empty"
}

sh_list_vdisks() {
	# discos virtuais e ISOs de ~/.chili-fr/vdisk, em ordem alfabética
	local dir="$HOME_DIR/vdisk" f w=4
	local -a files=()
	while IFS= read -r f; do files+=("$f"); done < <(
		find -L "$dir/" -maxdepth 1 -type f \( -name '*.qcow2' -o -name '*.img' -o -name '*.raw' -o -name '*.iso' \) 2>/dev/null | LC_ALL=C sort -f
	)
	echo
	msg_info "$(gettext 'Discos virtuais em') ${cyan}$(tilde_path "$dir")${rst}"
	if ((${#files[@]} == 0)); then
		msg_info_tab "$(gettext 'nenhum disco encontrado - crie um com') ${cyan}$APP --cvdisk${rst}"
		return
	fi
	for f in "${files[@]}"; do ((${#f} - ${#dir} - 1 > w)) && w=$((${#f} - ${#dir} - 1)); done
	printf "    ${bold}%-*s %8s   %s${rst}\n" "$w" "$(gettext 'NOME')" "$(gettext 'TAMANHO')" "$(gettext 'MODIFICADO')"
	for f in "${files[@]}"; do
		file_row "$f" "$w" "${f##*/}"
	done
}

iso_search_dirs() {
	# onde procurar arquivos parecidos: pasta atual, Downloads, vdisk e raiz do $HOME
	local d dl="$HOME/Downloads" line
	if [[ -r "$HOME/.config/user-dirs.dirs" ]]; then
		line=$(grep -m1 '^XDG_DOWNLOAD_DIR=' "$HOME/.config/user-dirs.dirs")
		line="${line#*=}"
		line="${line//\"/}"
		[[ -n "$line" ]] && dl="${line/\$HOME/$HOME}"
	fi
	for d in "$PWD" "$dl" "$HOME/Downloads" "$HOME_DIR/vdisk" "$HOME"; do
		[[ -d "$d" ]] && printf '%s\n' "$d"
	done | awk '!seen[$0]++'
}

suggest_files() {
	# suggest_files <nome digitado> : até 5 arquivos parecidos, mais recentes primeiro
	local base="${1##*/}" stem ext pat key d
	ext="${base##*.}"
	[[ "$ext" == "$base" ]] && ext=''
	stem="${base%.*}"
	stem="${stem,,}"
	case "${ext,,}" in
	iso) pat='*.iso' ;;
	qcow2 | img | raw) pat='*.@(qcow2|img|raw)' ;;
	*) pat='*.@(iso|qcow2|img|raw)' ;;
	esac
	# tenta o nome inteiro (sem extensão) e, se nada casar, só a primeira parte
	for key in "$stem" "${stem%%[-_.]*}"; do
		[[ -z "$key" ]] && continue
		local -a hits=()
		while IFS= read -r d; do
			local f
			shopt -s nullglob extglob nocaseglob
			for f in "$d"/$pat; do
				[[ -f "$f" ]] || continue
				local n="${f##*/}"
				[[ "${n,,}" == *"$key"* ]] && hits+=("$f")
			done
			shopt -u nullglob nocaseglob
		done < <(iso_search_dirs)
		if ((${#hits[@]})); then
			printf '%s\n' "${hits[@]}" | awk '!seen[$0]++' | while IFS= read -r f; do
				printf '%s\t%s\n' "$(stat -L -c %Y "$f")" "$f"
			done | sort -rn | cut -f2 | head -5
			return
		fi
	done
}

list_isos() {
	# até 10 ISOs dos lugares de busca, mais recentes primeiro
	local d f
	while IFS= read -r d; do
		shopt -s nullglob nocaseglob
		for f in "$d"/*.iso; do
			[[ -f "$f" ]] && printf '%s\t%s\n' "$(stat -L -c %Y "$f")" "$f"
		done
		shopt -u nullglob nocaseglob
	done < <(iso_search_dirs) | awk -F'\t' '!seen[$2]++' | sort -rn | cut -f2 | head -10
}

sh_not_found() {
	# sh_not_found <arquivo> [arquivo...] : relata tudo o que faltou de uma vez.
	# Mostra só o que é relativo a cada um: ISO -> ISOs, disco -> discos.
	local img f w arg kind where_txt
	local show_isos=false show_disks=false all_suggested=true
	local -a sugs=() cmd=() where=() isos=()
	local -A first=()

	while IFS= read -r f; do where+=("$(tilde_path "$f")"); done < <(iso_search_dirs)
	where_txt="$(IFS=,; printf '%s' "${where[*]}" | sed 's/,/, /g')"

	echo
	for img in "$@"; do
		log_msg false "${red}${img}${rst} $(gettext 'não encontrado')"
	done
	msg_info_tab "$(gettext 'procurado em:') ${cyan}$(tilde_path "$PWD")${rst} ($(gettext 'pasta atual')) $(gettext 'e') ${cyan}$(tilde_path "$HOME_DIR/vdisk")${rst}"

	for img in "$@"; do
		case "${img,,}" in
		*.iso) kind=iso ;;
		*.qcow2 | *.img | *.raw) kind=disk ;;
		*) kind=all ;;
		esac
		[[ $kind != iso ]] && show_disks=true

		sugs=()
		while IFS= read -r f; do sugs+=("$f"); done < <(suggest_files "$img")
		echo
		if ((${#sugs[@]})); then
			msg_info "${cyan}${img}${rst}: $(gettext 'você quis dizer?')"
			w=4
			for f in "${sugs[@]}"; do
				f="$(tilde_path "$f")"
				((${#f} > w)) && w=${#f}
			done
			for f in "${sugs[@]}"; do file_row "$f" "$w"; done
			first[$img]="${sugs[0]}"
		else
			msg_info "${cyan}${img}${rst}: $(gettext 'nenhum arquivo parecido em:') ${cyan}${where_txt}${rst}"
			all_suggested=false
			[[ $kind != disk ]] && show_isos=true
		fi
	done

	# sem nome parecido para uma ISO: mostra as ISOs que existem
	if $show_isos; then
		while IFS= read -r f; do isos+=("$f"); done < <(list_isos)
		if ((${#isos[@]})); then
			echo
			msg_info "$(gettext 'ISOs disponíveis')"
			w=4
			for f in "${isos[@]}"; do
				f="$(tilde_path "$f")"
				((${#f} > w)) && w=${#f}
			done
			for f in "${isos[@]}"; do file_row "$f" "$w"; done
		fi
	fi

	$show_disks && sh_list_vdisks

	# comando pronto só quando há sugestão para todos os que faltaram
	if $all_suggested; then
		for arg in "${orig_args[@]}"; do
			if [[ -n "${first[$arg]:-}" ]]; then
				# no vdisk basta o nome: o chili-fr já procura lá
				if [[ "${first[$arg]%/*}" -ef "$HOME_DIR/vdisk" ]]; then
					arg="${first[$arg]##*/}"
				else
					arg="$(tilde_path "${first[$arg]}")"
				fi
			fi
			cmd+=("$arg")
		done
		echo
		msg_info "$(gettext 'Para usar os arquivos sugeridos:')"
		printf '    %s$%s %s %s\n' "$green" "$rst" "$APP" "${cmd[*]}"
	fi
	echo
	exit 1
}

sh_remove_vdisk_file() {
	msg_info "$(gettext 'Criando diretórios de trabalho')"
	mkdir -p "$HOME_DIR/vdisk" &>/dev/null
	msg_info "$(gettext 'Setando permissões no diretórios de trabalho')"
	sudo chmod 1777 "$HOME_DIR/" &>/dev/null
	sudo chown $USER:$USER "$HOME_DIR/" -R &>/dev/null

	sh_list_vdisks
	get 10 10 "$(gettext 'Entre com o nome do disco para remover') - ex vda.img : " cvdisk_name

	if test -e $HOME_DIR/vdisk/$cvdisk_name &>/dev/null; then
		if readconf "$(gettext 'PERGUNTA: Deseja realmente excluir o disco virtual ?')"; then
			if rm -f $HOME_DIR/vdisk/$cvdisk_name &>/dev/null; then
				msg_ok "$(gettext 'Disco virtual') '$HOME_DIR/vdisk/$cvdisk_name' $(gettext 'foi removido com sucesso')"
				exit 0
			fi
		fi
		exit $?
	else
		die "$(gettext 'Disco virtual digitado não existe!')"
	fi
}

sh_start_vdagentd() {
	local DISTRO=$(detect_distro)

	if ! pgrep spice-vdagentd; then
		msg_info "$(gettext 'Ativando serviço') spice-vdaagentd $(gettext 'na distro:') ${cyan}${DISTRO^^}"
		case "$DISTRO" in
		void*)
			cmd_sudo ln -sf /etc/sv/spice-vdagentd /var/service/ &>/dev/null
			;;
		chililinux | arch)
			cmd_sudo systemctl enable -now spice-vdagentd &>/dev/null
			;;
		*)
			msg_info_tab "$(gettext 'Outra distro:') $DISTRO"
			;;
		esac
	fi
}

# saber se o sistema está num TTY puro ou num ambiente gráfico
is_graphical() {
	# Wayland ou X11
	[[ "$XDG_SESSION_TYPE" == "x11" || "$XDG_SESSION_TYPE" == "wayland" ]] && return 0
	[[ -n "$DISPLAY" || -n "$WAYLAND_DISPLAY" ]] && return 0
	return 1
}

sh_copyright() {
	echo -n $orange
	echo "$APP - v${VERSION} - ${APPDESC}"
	echo 'Copyright (c) 2019-2026, ChiliLinux Development Team <https://chililinux.com> <https://github.com/chililinux>'
	echo 'Copyright (c) 2019-2026, Vilmar Catafesta <vcatafesta@gmail.com>'
	echo $rst
}

print_avaiable_bridges() {
	local bridges
	#	bridges=($(get_bridge_interfaces))
	mapfile -t bridges < <(list_bridges_detailed)

	echo -e "${cyan}$(gettext 'Pontes disponíveis:')${rst}"
	if [[ ${#bridges[@]} -eq 0 ]]; then
		echo -e "  ${yellow}($(gettext 'nenhuma ponte disponível'))${rst}"
	else
		for b in "${bridges[@]}"; do
			echo -e "  ${yellow}${b}${rst}"
		done
	fi
}

add_smb_share() {
	local share_dir="$HOME/share" # opcional, por padrão $HOME/share
	local cCmd=''

	# se tiver smbd, cria share e adiciona a opção (OBS: smb só funciona no modo -net user)
	if command -v smbd &>/dev/null; then
		mkdir -p "$share_dir" &>/dev/null
		cCmd=",smb=${share_dir}"
	fi
	echo $cCmd
}

print_summary_access_vm() {
	if $bridge; then
		msg_info "$(gettext 'Parametro') ${yellow}--bridge${rst} $(gettext 'informado. Iniciando VM em modo') ${yellow}BRIDGE${rst} (IP via DHCP)"
	else
		msg_warn "$(gettext 'Parametro') ${cyan}--bridge${rst} $(gettext 'não informado. Iniciando VM em modo') ${yellow}NAT${rst} (hostfwd ativo)"
	fi

	msg_info "$(gettext 'Acesso a VM via') ${yellow}ssh:"
	msg_info_tab "$(printf "%-45s ${cyan}%s\n" "\$ ssh root@vsock/$GUEST_CID" "# $(gettext 'via vsock (se habilitado no guest)')")"
	msg_info_tab "$(printf "%-45s ${cyan}%s\n" "\$ ssh $USER@vsock/$GUEST_CID" "# $(gettext 'via vsock (se habilitado no guest)')")"

	if ! $bridge; then
		msg_info_tab "$(printf "%-45s ${cyan}%s\n" "\$ ssh root@127.0.0.1 -p $HOST_FWD" "# $(gettext 'via redirecionamento NAT')")"
		msg_info_tab "$(printf "%-45s ${cyan}%s\n" "\$ ssh $USER@127.0.0.1 -p $HOST_FWD" "# $(gettext 'via redirecionamento NAT')")"
		msg_info_tab "$(printf "%-45s ${cyan}%s\n" "\$ ssh live@127.0.0.1 -p $HOST_FWD" "# $(gettext 'via redirecionamento NAT')")"
		msg_info_tab "$(printf "%-45s ${cyan}%s\n" "\$ ssh anon@127.0.0.1 -p $HOST_FWD" "# $(gettext 'via redirecionamento NAT')")"
		msg_info_tab "$(printf "%-45s ${cyan}%s\n" "\$ ssh $HOST_FWD" "# $(gettext 'via ssh config')")"
	else
		bloco_br=$(ip -4 route show dev "$iface_bridge" | awk '$1 ~ "/" {print $1; exit}')
		msg_info_tab "$(printf "%-45s ${cyan}%s\n" "\$ ssh <IP-da-VM>         " "# $(gettext 'IP atribuído na VM via DHCP') ($bloco_br")"
	fi

	CFG="$HOME/.ssh/config"
	mkdir -p "$HOME/.ssh"
	chmod 700 "$HOME/.ssh" 2>/dev/null
	touch "$CFG"

	# Remove eventual entrada antiga do known_hosts
	ssh-keygen -R "[127.0.0.1]:$HOST_FWD" >/dev/null 2>&1 || :

	# Bloco gerenciado: reescrito a cada execução para o config não crescer
	# indefinidamente com uma entrada por porta sorteada.
	local tmp_cfg
	tmp_cfg=$(mktemp) || return 0
	awk '
		/^# BEGIN chili-fr$/ { skip=1; next }
		/^# END chili-fr$/   { skip=0; next }
		!skip                { print }
	' "$CFG" >"$tmp_cfg"

	{
		cat "$tmp_cfg"
		cat <<EOF
# BEGIN chili-fr
Host chili-vm $HOST_FWD
    HostName 127.0.0.1
    Port $HOST_FWD
    User $USER
    IdentityFile ~/.ssh/id_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
# END chili-fr
EOF
	} >"$CFG"
	rm -f "$tmp_cfg"
	chmod 600 "$CFG" 2>/dev/null
	msg_info_tab "$(gettext 'Alias ssh atualizado:') ${cyan}chili-vm${rst} ($(gettext 'porta') $HOST_FWD)"
}

sh_start_with_spice() {
	sh_start_vdagentd

	# Informar as portas usadas
	msg_info_tab "SPICE running on port : ${cyan}$random_spice_port${rst}"
	msg_info_tab "$(gettext 'Cliente') SPICE (GUI)   : ${cyan}remote-viewer spice://localhost:$random_spice_port${rst}"

	# Configurar SPICE
	#qemu_options+=(-chardev spicevmc,id=vdagent,debug=0,name=vdagent)
	#qemu_options+=(-device virtserialport,chardev=vdagent,name=com.redhat.spice.0)
	qemu_options+=(
		-spice port=$random_spice_port,disable-ticketing=on
		-monitor tcp:localhost:$random_port,server,nowait
		-chardev spicevmc,id=charchannel0,name=vdagent
		-device virtserialport,chardev=charchannel0,name=com.redhat.spice.0
		-display none
	)

	if $output; then
		cat <<EOF
${cyan}
sudo env XDG_RUNTIME_DIR=/run/user/\$(id -u) qemu-system-x86_64 ${qemu_options[@]} &
qemu_pid=\$!
remote-viewer spice://localhost:$random_spice_port &
viewer_pid=\$!
wait \$viewer_pid
kill \$qemu_pid &>/dev/null
${reset}
EOF
		exit 0
	fi

	# Executar o QEMU
	sudo env XDG_RUNTIME_DIR=/run/user/$(id -u) qemu-system-x86_64 "${qemu_options[@]}" &
	qemu_pid=$!
	remote-viewer spice://localhost:$random_spice_port &
	viewer_pid=$!
	# Aguardar o remote-viewer e encerrar o QEMU quando ele fechar
	wait $viewer_pid
	kill "$qemu_pid" &>/dev/null
}

main::init_main() {
	# imagens vindas de -i/--image entram antes dos argumentos posicionais
	params=("${aimages[@]}" "$@")

	random_port="$(shuf -i 4444-45000 -n 1)"
	random_spice_port="$(shuf -i 5900-5910 -n 1)"

	bootindex=1
	media_type=""
	count=1

	devices=()
}

main::process_devices() {
	local -a missing=()

	# confere todos os arquivos antes, para relatar de uma vez tudo o que faltou
	for img in "${params[@]}"; do
		[[ -z "$img" ]] && {
			sh_list_vdisks
			die "Erro: vdisk/iso/device #${count} não especificada!"
		}
		has_file "$img" || has_file "$HOME_DIR/vdisk/$img" || missing+=("$img")
	done
	((${#missing[@]})) && sh_not_found "${missing[@]}"

	for img in "${params[@]}"; do
		has_file "$img" || img="$HOME_DIR/vdisk/$img"

		devices+=("$img")

		if ((count == 1)); then
			log_msg true "Boot source ${yellow}#${count}: ${cyan}$img"
		else
			log_msg true "Data source ${yellow}#${count}: ${cyan}$img"
		fi

		((++count))
	done
}

main::configure_uefi() {
	local DISTRO=$(detect_distro)

	if $uefi; then
		sh_checkOVMFFiles
		msg_info "$(gettext 'Forçando inicialização UEFI...')"
		case "$DISTRO" in
		void*)
			ovmf_dir="/usr/share/edk2/x64"
			;;
		*)
			ovmf_dir="/usr/share/edk2-ovmf/x64"
			;;
		esac
		[ -f "$HOME_DIR/OVMF_VARS.4m.fd" ] || cp -f "$ovmf_dir/OVMF_VARS.4m.fd" "$HOME_DIR/"
		qemu_options+=(-drive if=pflash,format=raw,readonly=on,file="$ovmf_dir/OVMF_CODE.4m.fd")
		qemu_options+=(-drive if=pflash,format=raw,file="$HOME_DIR/OVMF_VARS.4m.fd")
	fi
}

main::build_base_qemu() {
	local cpu="${machine[cpu]:-host}"
	[[ -n "${machine[cpu_name]}" ]] && cpu+=",model-id=$(smbios_escape "${machine[cpu_name]}")"

	qemu_options+=(-no-fd-bootchk)
	qemu_options+=(-cpu "$cpu")
	qemu_options+=(-smp "${machine[smp]:-$(nproc)}")
	qemu_options+=(-m "${xmem}")
	qemu_options+=(-k pt-br)
}

main::attach_primary_devices() {
	for img in "${devices[@]}"; do
		vm_disks+=("${img##*/}") # para o titulo da janela
		media_type=$(file -b --mime-type "${img}")

		if [[ "$img" == *.iso ]]; then
			msg_info "$(gettext 'Anexando iso') ${yellow}#${bootindex}: ${bold}${cyan}${img}"
			qemu_options+=(-drive file="${img}",if=none,id=cdrom${bootindex},media=cdrom)
			qemu_options+=(-device ide-cd,drive=cdrom${bootindex},bootindex=${bootindex})

		elif [[ "$img" == *.qcow2 ]]; then
			msg_info "$(gettext 'Anexando vdisk') ${yellow}#${bootindex}: ${bold}${cyan}${img}"
			qemu_options+=(-drive file="${img}",if=none,id=disk${bootindex},format=qcow2,cache=${cache_type})
			disk_device "disk${bootindex}" "${bootindex}"

		elif [[ -b "$img" ]]; then
			msg_info "$(gettext 'Anexando device') ${yellow}#${bootindex}: ${bold}${cyan}${img} (cache=${cache_type})"
			qemu_options+=(
				#				-drive file="${img}",if=none,id=disk${bootindex},format=raw,media=disk,cache=none,aio=native
				#				-drive file="${img}",if=none,id=disk${bootindex},format=raw,media=disk,cache=unsafe,aio=io_uring
				#				-drive file="${img}",if=none,id=disk${bootindex},format=raw,media=disk,cache=writeback,aio=io_uring
				#       -drive file="${img}",if=none,id=disk${bootindex},format=raw,media=disk,cache=writethrough,aio=io_uring
				#       -drive file="${img}",if=none,id=disk${bootindex},format=raw,media=disk,cache=directsync,aio=io_uring
				-drive file="${img}",if=none,id=disk${bootindex},format=raw,media=disk,cache=${cache_type},aio=io_uring
			)
			disk_device "disk${bootindex}" "${bootindex}"

		else
			msg_info "$(gettext 'Anexando vdisk') ${yellow}#${bootindex}: ${bold}${cyan}${img} (raw)"
			qemu_options+=(-drive file="${img}",if=none,id=disk${bootindex},format=raw,cache=${cache_type})
			disk_device "disk${bootindex}" "${bootindex}"
		fi

		((bootindex++))
	done
}

main::attach_extra_vdisks() {
	$vdisk || return

	for vdsk in "${avdisk_names[@]}"; do
		! has_file "$vdsk" && vdsk="$HOME_DIR/vdisk/$vdsk"
		! has_file "$vdsk" && continue

		if [[ "$vdsk" == *.img ]]; then
			msg_info "$(gettext 'Anexando vdisk') #${bootindex}: ${yellow}${vdsk}"
			qemu_options+=(-drive file="${vdsk}",if=none,id=disk${bootindex},format=raw,cache=${cache_type})

		elif [[ "$vdsk" == *.qcow2 ]]; then
			msg_info "Anexando vdisk #${bootindex}: ${yellow}${vdsk}"
			qemu_options+=(-drive file="${vdsk}",if=none,id=disk${bootindex},format=qcow2,cache=${cache_type})
		fi

		vm_disks+=("${vdsk##*/}") # para o titulo da janela
		disk_device "disk${bootindex}" "${bootindex}"
		((bootindex++))
	done
}

main::configure_name() {
	local vmname="chili-fr"
	[[ -n "$machine_file" ]] && vmname+=" [$(basename "$machine_file" .conf)]"
	# Firmware (UEFI ou BIOS), discos anexados (#1 e o de boot), MAC da
	# primeira placa e porta do ssh (NAT) no titulo da janela: com varias VMs
	# abertas, da para saber qual e qual.
	local i
	if $uefi; then
		vmname+=" | UEFI"
	else
		vmname+=" | BIOS"
	fi
	for i in "${!vm_disks[@]}"; do
		vmname+=" | #$((i + 1)) ${vm_disks[i]}"
	done
	vmname+=" | MAC $(vm_mac "$boot_img" 1)"
	$bridge || vmname+=" | ssh $HOST_FWD"
	# virgula e separador de opcoes do QEMU; no valor, vai dobrada
	qemu_options+=(-name "${vmname//,/,,}")
}

main::configure_display_and_audio() {
	if $only_tty; then
		# -machine e obrigatorio tambem no TTY: sem accel=kvm o '-cpu host'
		# faz o QEMU abortar ("host CPU model requires KVM or HVF")
		qemu_options+=(-machine type=q35,smm=on,accel=kvm,usb=on)
		qemu_options+=(-rtc base=localtime,clock=host)
		qemu_options+=(-global ICH9-LPC.disable_s3=1)
		qemu_options+=(-vga std -display curses)

		if $lshare; then
			qemu_options+=(-fsdev local,id=fsdev0,path="${cshare}",security_model=passthrough)
			qemu_options+=(-device virtio-9p-pci,fsdev=fsdev0,mount_tag=vmshare)
		fi
		return
	fi

	audio="${audioserver:-$(detect_audio_server)}"

	qemu_options+=(-audiodev "$audio",id=snd0)
	qemu_options+=(-rtc base=localtime,clock=host)
	qemu_options+=(-device ich9-intel-hda)
	qemu_options+=(-device hda-duplex,audiodev=snd0)
	qemu_options+=(-global ICH9-LPC.disable_s3=1)
	qemu_options+=(-machine type=q35,smm=on,accel=kvm,usb=on,pcspk-audiodev=snd0)

	if $lshare; then
		qemu_options+=(-fsdev local,id=fsdev0,path="${cshare}",security_model=passthrough)
		qemu_options+=(-device virtio-9p-pci,fsdev=fsdev0,mount_tag=vmshare)
	fi
}

main::handle_spice_or_display() {
	if $spice; then
		qemu_options+=(-device "$videodevice" -device virtio-serial)
		sh_start_with_spice
		exit 0
	fi

	if $only_tty; then
		# display/vga ja definidos em configure_display_and_audio (curses)
		if $output; then
			cat <<EOF
${cyan}
sudo env SDL_VIDEODRIVER=x11 XDG_RUNTIME_DIR=/run/user/\$(id -u) qemu-system-x86_64 ${qemu_options[@]}
${reset}
EOF
			exit 0
		fi

		cmd_sudo env SDL_VIDEODRIVER=x11 XDG_RUNTIME_DIR=/run/user/$(id -u) qemu-system-x86_64 "${qemu_options[@]}"
		exit 0
	fi

	qemu_options+=(-device "$videodevice" -display ${displaydevice},gl=on)

	cmd=(
		sudo -E setsid env
		SDL_VIDEODRIVER=x11
		XDG_RUNTIME_DIR="/run/user/$(id -u)"
		qemu-system-x86_64 "${qemu_options[@]}"
	)

	if $output; then
		cat <<EOF
${cyan}
${cmd[*]} &
disown
${reset}
EOF
		exit 0
	fi

	run_qemu
}

main() {
	main::init_main "$@"
	main::process_devices
	main::configure_uefi
	main::build_base_qemu
	main::configure_smbios
	main::attach_primary_devices
	main::attach_extra_vdisks
	main::configure_name
	main::configure_display_and_audio
	main::handle_spice_or_display
}

run_qemu() {
	# 1. Lança o comando em background
	# O stderr e stdout vão direto para o terminal, sem filtros.
	"${cmd[@]}" &

	# 2. Desvincula o processo para que ele não morra ao fechar o terminal
	disown

	# 3. Sai com sucesso.
	# Se o comando lá em cima falhar ANTES do exit, o seu trap cleanup cuida do resto.
	exit 0
}

params="${@}"
declare -a orig_args=("$@") # argumentos como digitados (comando pronto em sh_not_found)
sh_setvarcolors
#sh_copyright

# Display usage information if no arguments are passed
if [[ $# -eq 0 || $1 == @(-h|-H|--help) ]]; then
	sh_usage
fi
if [[ $1 == @(-V|--version) ]]; then
	sh_version
fi

sh_checkDependencies
sh_checkVdiskFiles

OPTIONS=:a:m:M:ub:Vnhd:stg:v:i:N:c:r:loqC:
LONGOPTIONS=:audio:,memory:,machine:,list-machines,machine-from-host::,uefi,bridge:,version,nocolor,help,drive:,spice,tty,video:,image:,network:,create_virbr_bridge:,remove_virbr_bridge:,create_real_bridge:,remove_real_bridge:,cvdisk,rvdisk,vdisk:,list,output,quiet,share:,display:,cache:
opts=($(getopt --options="$OPTIONS" --longoptions="$LONGOPTIONS" --name "$0" -- "$@"))
#eval set -- "${opts[*]}"
eval set -- "${opts[@]}"

#while test ${#opts[*]} -gt 0; do
while [ $# -gt 0 ]; do
	case $1 in
	-n | --nocolor)
		sh_unsetvarcolors
		;;
	-u | --uefi)
		msg_info "$(gettext 'Parametro') ${yellow}--uefi${rst} $(gettext 'detectado: usando uefi') ${rst}"
		uefi=true
		LPARAM_UEFI=true
		;;
	-M | --machine)
		if [[ -z "$2" || "$2" == "--" ]]; then
			die "$(gettext 'Argumento inválido para') ${1}, $(gettext 'falta o nome do perfil') - $(gettext 'use') ${cyan}--list-machines${rst}" >&2
		fi
		machine_name="$2"
		msg_info "$(gettext 'Parametro') ${yellow}--machine${rst} $(gettext 'detectado: usando perfil') ${cyan}'$2'${rst}"
		shift
		;;
	--list-machines)
		sh_list_machines
		exit 0
		;;
	--machine-from-host)
		sh_machine_from_host "$2"
		exit $?
		;;
	-i | --image)
		if [[ -z "$2" || "$2" == "--" ]]; then
			die "$(gettext 'Argumento inválido para') ${1}, $(gettext 'falta parâmetro de imagem/disco/device')" >&2
		else
			aimages+=("$2")
			shift
		fi
		;;
	-c | --create_real_bridge)
		if [[ -z "$2" ]]; then
			echo -e "${red}Erro:${rst} $(gettext 'Argumento inválido para') ${cyan}${1}${rst}" >&2
			msg_ex_tab "$APP ${cyan}--create_real_bridge br0${rst}"
			exit 0
		else
			create_real_bridge "$2"
			exit 0
		fi
		;;
	-r | --remove_real_bridge)
		if bridge_exists "$2"; then
			bridge_name="$2"
			remove_real_bridge "$bridge_name"
			exit 0
		else
			echo -e "${red}Error:${rst} $(gettext 'Argumento inválido para') ${cyan} ${1} ${rst}" >&2
			print_avaiable_bridges
			exit 1
		fi
		;;
	--create_virbr_bridge)
		if [[ -z "$2" ]]; then
			die "$(gettext 'Argumento inválido para') --create_virbr_bridge, $(gettext 'falta nome para ponte') \nEx.: --create_virbr_bridge br0" >&2
		else
			if bridge_exists "$2"; then
				die "$(gettext 'Argumento inválido para') ${cyan}--create_virbr_bridge${red}. BRIDGE ${cyan}$2 ${red}$(gettext 'já existe')" >&2
			else
				bridge_name="$2"
				create_bridge_virbr "$bridge_name"
				shift
			fi
		fi
		;;
	--remove_virbr_bridge)
		if bridge_exists "$2"; then
			bridge_name="$2"
			remove_virbr_bridge_and_tap "$bridge_name"
			shift
		else
			echo -e "${red}Erro:${rst} $(gettext 'Argumento inválido para') ${cyan}${1}${rst}" >&2
			print_avaiable_bridges
			exit 1
		fi
		;;
	-q | --quiet)
		quiet=true
		;;
	-a | --audio)
		next_arg="${2:-}"
		next_arg="${next_arg,,}"
		if [[ "$next_arg" =~ ^(pipewire|pa|jack|none)$ ]]; then
			audioserver="$next_arg"
			msg_info "$(gettext 'Parametro') ${yellow}--audio${rst} $(gettext 'detectado: usando') ${cyan}'$next_arg'${rst}"
			LPARAM_AUDIO=true
			shift
		else
			echo -e "${red}Erro:${rst} $(gettext 'Argumento inválido para') ${cyan}${1}${rst} - válidos: ${yellow}pipewire pa jack none"
			exit 1
		fi
		;;
	-b | --bridge)
		if bridge_exists "$2"; then
			iface_bridge="$2"
			msg_info "$(gettext 'Parametro') ${yellow}--bridge${rst} $(gettext 'detectado: usando ponte') ${cyan}'$iface_bridge'${rst}"
			bridge=true
			shift
		else
			echo -e "${red}Erro:${rst} $(gettext 'Argumento inválido para') ${cyan}${1}${rst}" >&2
			print_avaiable_bridges
			exit 1
		fi
		;;
	--share)
		lshare=true
		cshare="$2"
		msg "$(gettext 'Parametro') ${yellow}--share ${rst}$(gettext 'detectado: usando share') ${cyan}${cshare}"
		msg_tab "montar share na vm (mount): ${cyan}$ sudo mount vmshare -t 9p -o rw,relatime,cache=0xf,access=client,msize=262144,trans=virtio /mnt/"
		msg_tab "montar share na vm (fstab): ${cyan}vmshare  /mnt  9p nofail,trans=virtio,version=9p2000.L,msize=262144,cache=loose  0  0"
		shift
		;;
	-s | --spice)
		spice=true
		log_msg "$(gettext 'Parametro') ${bcyan}--spice${rst} $(gettext 'detectado, usando spice')"
		;;
	-t | --tty)
		spice=false
		log_msg "$(gettext 'Parametro') ${bcyan}--tty${rst} $(gettext 'detectado: ativando') tty only"
		only_tty=true
		;;
	-g | --video)
		if [[ " ${avideodevice[*]} " =~ [[:space:]]${2}[[:space:]] ]]; then
			videodevice="$2"
			LPARAM_VIDEO=true
			shift
		else
			die "${red}$(gettext 'Argumento inválido para') ${yellow}-g|--video${rst} $(gettext 'Use:') ${cyan}${avideodevice[@]}${rst}" >&2
		fi
		;;
	--display)
		if [[ " ${adisplaydevice[*]} " =~ [[:space:]]${2}[[:space:]] ]]; then
			displaydevice="$2"
			shift
		else
			die "${red}$(gettext 'Argumento inválido para') ${yellow}--display${rst} $(gettext 'Use:') ${cyan}${adisplaydevice[@]}${rst}" >&2
		fi
		;;
	-C | --cache)
		if [[ " ${acachemode[*]} " =~ [[:space:]]${2}[[:space:]] ]]; then
			cache_type="$2"
			LPARAM_CACHE=true
			[[ "$2" == "unsafe" ]] &&
				msg_warn "${yellow}cache=unsafe${rst}: $(gettext 'ignora flush do guest - risco de perda de dados se o host travar')"
			shift
		else
			die "${red}$(gettext 'Argumento inválido para') ${yellow}-C|--cache${rst} $(gettext 'Use:') ${cyan}${acachemode[@]}${rst}" >&2
		fi
		;;
	-l | --list)
		sh_list_vdisks
		exit 0
		:
		;;
	-v | --vdisk)
		if [[ " $(get_raw_images) " =~ " $2 " || -e "$2" ]]; then
			vdisk_name="$2"
			avdisk_names+=("$vdisk_name")
			vdisk=true
			shift
		else
			sh_list_vdisks
			die "$(gettext 'Argumento inválido para') ${cyan}--vdisk ${rst}$(gettext 'Válidos são:') ${yellow}$(get_raw_images)${rst}" >&2
		fi
		;;
	--cvdisk)
		sh_create_vdisk_file
		exit $?
		;;
	--rvdisk)
		sh_remove_vdisk_file
		exit $?
		;;
	-N | --network)
		if [[ $2 =~ ^(virtio-net-pci|e1000|rtl8139|vmxnet3|ne2k_pci|ne2k_isa|pcnet|smc91c111|i82551|i82557b|i82559er)$ ]]; then
			netdevice="$2"
			anetdevices+=("$netdevice")
			netchoosedriver=true
			msg_info "$(gettext 'Anexando placa de rede'), driver: ${yellow}$netdevice"
			shift
		else
			die "$(gettext 'Argumento inválido para') --network. $(gettext 'Use') virtio-net-pci,e1000,rtl8139,vmxnet3,ne2k_pci,ne2k_isa,pcnet,smc91c111,i82551,i82557b,i82559er" >&2
		fi
		;;
	-o | --output)
		output=true
		;;
	-d | --drive)
		if [[ -n $2 ]]; then
			drive=true
			drive_path=$2
			if lsblk $drive_path &>/dev/null; then
				log_msg "$(gettext 'Parametro') -d,--drive $(gettext 'detectado:') $drive_path"
			else
				die "${cyan}$(gettext 'Parametro') -d,--drive => ${red}$drive_path: $(gettext 'não é um dispositivo de bloco')"
			fi
			shift
		else
			die "$(gettext 'Argumento inválido para') --drive. $(gettext 'Use formato device, como /dev/sdX (por exemplo).')" >&2
		fi
		;;
	-m | --memory)
		if [[ $2 =~ ^[0-9]+[MGmg]$ ]]; then
			xmem=$2
			LPARAM_MEM=true
			log_msg "$(gettext 'Parametro') ${yellow}$1 ${rst}$(gettext 'detectado:') ${cyan}$2${rst}"
			shift
		else
			die "$(gettext 'Argumento inválido para') ${yellow}${1}${red}. $(gettext 'Use um formato como 16G (por exemplo).')" >&2
		fi
		;;
	--)
		shift
		break
		;;
	:)
		die "-$OPTARG $(gettext 'requer um argumento')" >&2
		;;
	*)
		break
		#die "$(gettext 'operação não suportada:') $1 $(gettext '(usar -h para ajuda')"
		;;
	esac
	shift
done

# perfil de máquina: aplicado depois das opções, que têm prioridade sobre ele
main::apply_machine_profile

audio="${audioserver:-$(detect_audio_server)}"
if $LPARAM_AUDIO; then
	msg_tick "Servidor audio informado: ${bcyan}${audio}${rst}"
else
	msg_tick "Servidor audio detectado: ${bcyan}${audio}${rst}"
fi

msg_tick "Servidor video configurado: ${bcyan}${videodevice}${rst}"

if $LPARAM_CACHE; then
	msg_tick "Cache informado: ${bcyan}${cache_type}${rst}"
else
	msg_tick "Cache padrão: ${bcyan}${cache_type}${rst}"
fi

if [[ $# -gt 0 || ${#aimages[@]} -gt 0 ]]; then
	# Configurar rede
	#random_mac_net0=$(python3 -c "import random; print(':'.join(['{:02x}'.format(random.randint(0, 255)) for _ in range(6)]))")
	#random_mac_net1=$(python3 -c "import random; print(':'.join(['{:02x}'.format(random.randint(0, 255)) for _ in range(6)]))")
	#mkdir -p $HOME/share &>/dev/null
	#qemu_options+=(-netdev bridge,id=net0,smb=$HOME)
	#qemu_options+=(-netdev bridge,id=net0)
	#qemu_options+=(-device e1000,netdev=net0)
	#qemu_options+=(-device e1000,netdev=net0,mac=$random_mac_net0)
	#qemu_options+=(-netdev bridge,id=net1,br=$iface_bridge)
	#qemu_options+=(-device e1000,netdev=net1,mac=$random_mac_net1)
	#qemu_options+=(-netdev tap,ifname=tap1,script=no,downscript=no,id=net0)
	#qemu_options+=(-device virtio-net-device,netdev=net0,mac=92:7b:15:c3:4d:ec)

	# intervalo de 555 a 560 → tamanho = 560−555+1 = 6
	#export GUEST_CID=$((RANDOM % 6 + 555))
	#export HOST_FWD=$((RANDOM % 10000 + 20000))
	#export HOST_FWD=$((RANDOM % 6 + 60022))
	#export HOST_GOTIFY=$((HOST_FWD + 1))

	# Função para verificar se a porta TCP está livre
	port_is_free() {
		! ss -tulpn | grep -q ":$1 "
	}

	# CID de vsock NÃO é porta TCP - checar contra QEMUs em execução
	cid_is_free() {
		! pgrep -f "guest-cid=$1" >/dev/null 2>&1
	}

	# 1. Sorteio inicial dos valores base
	CHECK_CID=$((RANDOM % 6 + 555))
	CHECK_FWD=$((RANDOM % 6 + 60022))

	# 2. Validação individual do CID
	until cid_is_free "$CHECK_CID"; do
		msg_warn "CID $CHECK_CID ocupado, tentando próximo..."
		((CHECK_CID++))
		# Opcional: resetar se passar do limite
		((CHECK_CID > 560)) && CHECK_CID=555
	done

	# 3. Validação da dupla de portas (FWD e GOTIFY)
	# Como GOTIFY depende de FWD (FWD + 1), verificamos o par
	while true; do
		CHECK_GOTIFY=$((CHECK_FWD + 1))

		if port_is_free "$CHECK_FWD" && port_is_free "$CHECK_GOTIFY"; then
			break
		fi
		#		msg_warn "${rst}Portas ${yellow}${CHECK_FWD}/${CHECK_GOTIFY}${rst} ocupadas, tentando próxima..."
		CHECK_FWD=$((CHECK_FWD + 1))

		# Opcional: resetar se passar do limite de segurança
		[ $CHECK_FWD -gt 65000 ] && CHECK_FWD=60022
	done

	export GUEST_CID=$CHECK_CID
	export HOST_FWD=$CHECK_FWD
	export HOST_GOTIFY=$CHECK_GOTIFY
	#msg "Portas selecionadas: SSH -> $HOST_FWD | Gotify -> $HOST_GOTIFY | CID -> $GUEST_CID"

	if ! $uefi; then
		msg_warn "$(gettext 'Parametro') ${cyan}--uefi${rst} $(gettext 'não informado, usando BIOS legacy')"
	fi

	if ! is_graphical; then
		msg_warn "$(gettext 'Nenhum ambiente gráfico detectado — forçando modo TTY.')"
		spice=false
		only_tty=true
	fi

	# disco que identifica a VM, de onde sai o MAC: o primeiro que nao e .iso,
	# para a mesma VM ter o mesmo MAC subindo pela iso de instalacao ou
	# direto pelo disco (e VMs diferentes com a mesma iso nao repetirem MAC).
	# Sem disco, a propria iso.
	boot_img=""
	for img in "${aimages[@]}" "$@"; do
		[[ "$img" == *.iso ]] && continue
		boot_img="$img"
		break
	done
	boot_img="${boot_img:-${aimages[0]:-$1}}"

	if $netchoosedriver; then
		for netdevice in "${anetdevices[@]}"; do
			((nId++))
			netdev_id="net$nId"

			# Verificar o tipo de rede (bridge ou user)
			if $bridge; then
				qemu_options+=(-netdev bridge,id="$netdev_id",br="$iface_bridge")
			else
				# Apenas o primeiro dispositivo recebe hostfwd e smb
				if ((nId == 1)); then
					#qemu_options+=(-netdev user,id="$netdev_id",hostfwd=tcp::$HOST_FWD-:22"$(add_smb_share)")
					qemu_options+=(-netdev user,id="$netdev_id",hostfwd=tcp::$HOST_FWD-:22,hostfwd=tcp::$HOST_GOTIFY-:8080"$(add_smb_share)")
				else
					qemu_options+=(-netdev user,id="$netdev_id")
				fi
			fi

			# Associar o dispositivo de rede
			mac=$(vm_mac "$boot_img" "$nId")
			msg_info "$(gettext 'Placa de rede') #${nId}: ${yellow}$netdevice${rst}, MAC ${cyan}$mac"
			qemu_options+=(-device "$netdevice",netdev="$netdev_id",mac="$mac")
		done
	else
		netdev_id="net0"
		if $bridge; then
			qemu_options+=(-netdev bridge,id="$netdev_id",br="$iface_bridge")
		else
			#        qemu_options+=(-netdev user,id="$netdev_id",hostfwd=tcp::$HOST_FWD-:22"$(add_smb_share)")
			qemu_options+=(-netdev user,id="$netdev_id",hostfwd=tcp::$HOST_FWD-:22,hostfwd=tcp::$HOST_GOTIFY-:8080"$(add_smb_share)")
		fi
		mac=$(vm_mac "$boot_img" 1)
		msg_info "$(gettext 'Placa de rede'): ${yellow}$netdevice${rst}, MAC ${cyan}$mac"
		qemu_options+=(-device "$netdevice",netdev="$netdev_id",mac="$mac")
	fi

	# Adicionando vhost-vsock
	qemu_options+=(-device vhost-vsock-pci,id=vhost-vsock-pci0,guest-cid="$GUEST_CID")
	print_summary_access_vm

	#windows
	#   if ! $spice; then
	# usb-tablet fornece dispositivo de apontamento absoluto.
	# Útil para GTK/VNC (evita mouse desalinhado).
	# Em SPICE com vdagent ativo, é desnecessário e pode ser omitido.
	qemu_options+=(-usb -device usb-tablet)
	#   fi

	if $drive; then
		msg_info "$(gettext 'Anexando disco/drive externo:') ${yellow}$drive_path"
		qemu_options+=(-drive file=$drive_path,format=raw,media=disk)
	fi
	main "$@"
else
	log_err "${red}Error${rst}: $(gettext 'Falta parâmetro de imagem/disco/device.') ${cyan}$(gettext 'Tente os vdisks listados abaixo.') ${yellow}$(gettext '(usar -h para ajuda)')"
	msg_ex_tab "${green}$ ${reset}${APP} ${params} ${rst}vda.img"
	msg_ex_tab "${green}$ ${rst}${APP} ${params} ${rst}/path/filename.img|qcow2|iso|raw"
	msg_ex_tab "${green}$ ${rst}${APP} ${params} ${rst}/dev/sdX"
	msg_ex_tab "${green}$ ${rst}${APP} ${params} ${rst}filename.iso /dev/sdX"
	sh_list_vdisks
	:
fi
