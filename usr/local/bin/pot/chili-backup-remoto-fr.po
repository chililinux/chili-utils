#: chili-backup-remoto:95 chili-backup-remoto:99 chili-backup-remoto:258
#: chili-backup-remoto:386
msgid "Aviso:"
msgstr "AVIS:"

#: chili-backup-remoto:95
msgid "elevando privilégios com sudo para preservar donos/permissões..."
msgstr "élever les privilèges avec sudo pour préserver les propriétaires/autorisations..."

#: chili-backup-remoto:99
msgid "rodando sem root; donos/grupos podem não ser preservados"
msgstr "fonctionner sans root ; les propriétaires/groupes peuvent ne pas être conservés"

#: chili-backup-remoto:117
msgid "Uso:"
msgstr "utiliser:"

#: chili-backup-remoto:117
msgid "ORIGEM"
msgstr "Origine"

#: chili-backup-remoto:117
msgid "DESTINO"
msgstr "Destination"

#: chili-backup-remoto:118
msgid "ou:"
msgstr "ou:"

#: chili-backup-remoto:120
msgid "Backup de servidor remoto via rsync + SSH."
msgstr "Sauvegarde du serveur distant via rsync + SSH."

#: chili-backup-remoto:121
msgid ""
"Parâmetros pela linha de comando; opcionalmente complementados por um JSON."
msgstr "Paramètres via la ligne de commande ; éventuellement complété par JSON."

#: chili-backup-remoto:123
msgid "Opções:"
msgstr "Possibilités :"

#: chili-backup-remoto:124
msgid "Host/IP do servidor (omita p/ backup local)"
msgstr "Hôte/IP du serveur (omita p/sauvegarde locale)"

#: chili-backup-remoto:125
msgid "Diretório a copiar (repita p/ vários)"
msgstr "Répertoire à copier (répéter pour plusieurs)"

#: chili-backup-remoto:126 chili-backup-remoto:153
msgid "Destino local dos backups (padrão: /backup)"
msgstr "Destination de sauvegarde locale (par défaut : /backup)"

#: chili-backup-remoto:127 chili-backup-remoto:148
msgid "Usuário SSH (padrão: root)"
msgstr "Utilisateur SSH (par défaut : root)"

#: chili-backup-remoto:128 chili-backup-remoto:150
msgid "Porta SSH (padrão: 22)"
msgstr "Port SSH (par défaut : 22)"

#: chili-backup-remoto:129
msgid "Chave privada SSH"
msgstr "Clé privée SSH"

#: chili-backup-remoto:130
msgid "Padrão rsync a excluir (repita p/ vários)"
msgstr "modèle rsync à supprimer (répéter pour plusieurs)"

#: chili-backup-remoto:131 chili-backup-remoto:154
msgid "Arquivo de log"
msgstr "Fichier journal"

#: chili-backup-remoto:132
msgid "Simula o backup, não altera nada no disco"
msgstr "Simule la sauvegarde, ne change rien sur le disque"

#: chili-backup-remoto:133
msgid "Modo silencioso (não mostra a saída do rsync)"
msgstr "Mode silencieux (n'affiche pas la sortie rsync)"

#: chili-backup-remoto:134
msgid "Gera o arquivo de configuração e explica como preencher"
msgstr "Génère le fichier de configuration et explique comment le remplir"

#: chili-backup-remoto:135
msgid ""
"Carrega valores de um JSON; opções da linha de\n"
"                              comando têm precedência"
msgstr "Charge les valeurs à partir de JSON ; options de ligne\nla commande a priorité"

#: chili-backup-remoto:137
msgid "Mostra esta ajuda"
msgstr "Afficher cette aide"

#: chili-backup-remoto:139
msgid "Exemplos:"
msgstr "Exemples :"

#: chili-backup-remoto:143
msgid "Configuração JSON:"
msgstr "Configuration JSON :"

#: chili-backup-remoto:144
msgid "Local: ~/.config/chili-backup-remoto.json (ou informe com -c/--config)"
msgstr "Emplacement : ~/.config/chili-backup-remoto.json (ou entrez avec -c/--config)"

#: chili-backup-remoto:145
msgid ""
"Gerado automaticamente se existir; opções da linha de comando têm precedência"
msgstr "Généré automatiquement s'il existe ; les options de ligne de commande sont prioritaires"

#: chili-backup-remoto:147
msgid "Parâmetros do JSON:"
msgstr "Paramètres JSON :"

#: chili-backup-remoto:149
msgid "Host/IP do servidor; omita ou deixe vazio para backup local"
msgstr "IP hôte/serveur ; omettre ou laisser vide pour la sauvegarde locale"

#: chili-backup-remoto:151
msgid "Chave privada SSH (padrão: chave do agente)"
msgstr "Clé privée SSH (par défaut : clé d'agent)"

#: chili-backup-remoto:152
msgid "Diretório/arquivo a copiar; string ou lista"
msgstr "Répertoire/fichier à copier ; chaîne ou liste"

#: chili-backup-remoto:155
msgid "Lista de padrões a excluir do rsync"
msgstr "Liste des modèles à exclure de rsync"

#: chili-backup-remoto:157
msgid "Exemplo completo: veja chili-backup-remoto.json.example"
msgstr "Exemple complet : voir chili-backup-remote.json.example"

#: chili-backup-remoto:226
msgid "Opção inválida:"
msgstr "Option invalide :"

#: chili-backup-remoto:249 chili-backup-remoto:325 chili-backup-remoto:329
#: chili-backup-remoto:333 chili-backup-remoto:377 chili-backup-remoto:472
#: chili-backup-remoto:476
msgid "Erro:"
msgstr "Erreur:"

#: chili-backup-remoto:249
msgid "use no máximo 2 argumentos: ORIGEM [DESTINO]"
msgstr "utilisez un maximum de 2 arguments : ORIGINE [DESTINATION]"

#: chili-backup-remoto:258
msgid "já existe:"
msgstr "existe déjà :"

#: chili-backup-remoto:258
msgid "nada foi alterado"
msgstr "rien n'a été changé"

#: chili-backup-remoto:259
msgid "Para usar outro arquivo: -c/--config ARQUIVO"
msgstr "Pour utiliser un autre fichier : -c/--config FILE"

#: chili-backup-remoto:283
msgid "Criado:"
msgstr "Créé :"

#: chili-backup-remoto:286
msgid "Como preencher:"
msgstr "Comment remplir :"

#: chili-backup-remoto:287
msgid "Usuário SSH do servidor (ex.: \"root\"); vazio = usa ~/.ssh/config"
msgstr "Nom d'utilisateur SSH du serveur (par exemple « root » ); vide = utilise ~/.ssh/config"

#: chili-backup-remoto:288
msgid "IP/nome do servidor; deixe vazio para backup local"
msgstr "IP/nom du serveur ; laisser vide pour la sauvegarde locale"

#: chili-backup-remoto:289
msgid "Porta SSH (22 é o padrão)"
msgstr "Port SSH (22 est la valeur par défaut)"

#: chili-backup-remoto:290
msgid "Chave PRIVADA (sem .pub); vazio = chave do agente/~/.ssh/config"
msgstr "Clé PRIVÉE (sans .pub) ; vide = clé d'agent/~/.ssh/config"

#: chili-backup-remoto:291
msgid "O que copiar: um caminho ou uma lista:"
msgstr "Que copier : un chemin ou une liste :"

#: chili-backup-remoto:294
msgid "Onde guardar (ex.: /backup) — os arquivos vão direto nele"
msgstr "Où le stocker (par exemple /backup) — les fichiers y vont directement"

#: chili-backup-remoto:295
msgid "Arquivo de log; vazio desativa"
msgstr "Fichier journal ; vide désactive"

#: chili-backup-remoto:296
msgid "Padrões rsync a excluir — já vem com os de praxe"
msgstr "rsync est par défaut exclu - est livré avec les habituels"

#: chili-backup-remoto:298
msgid "Depois de preencher, teste sem gravar nada:"
msgstr "Après avoir rempli, testez sans rien enregistrer :"

#: chili-backup-remoto:325
msgid "'jq' é necessário para ler a configuração JSON"
msgstr "'jq' est requis pour lire la configuration JSON"

#: chili-backup-remoto:329
msgid "sem permissão de leitura:"
msgstr "sans autorisation de lecture :"

#: chili-backup-remoto:333
msgid "JSON inválido em:"
msgstr "JSON invalide dans :"

#: chili-backup-remoto:377
msgid "--path-remoto é obrigatório (ou defina path_remoto no JSON)"
msgstr "--remote-path est requis (ou définissez remote_path dans JSON)"

#: chili-backup-remoto:386
msgid "sem permissão para escrever em"
msgstr "sans autorisation d'écrire dessus"

#: chili-backup-remoto:386
msgid "seguindo sem log"
msgstr "suivre sans journal"

#: chili-backup-remoto:431
msgid "backup falhou com código"
msgstr "la sauvegarde a échoué avec le code"

#: chili-backup-remoto:454
msgid "Simulando backup de"
msgstr "Simulation de sauvegarde"

#: chili-backup-remoto:456
msgid "Iniciando backup de"
msgstr "Démarrage de la sauvegarde"

#: chili-backup-remoto:465
msgid "Sincronizando:"
msgstr "Synchronisation :"

#: chili-backup-remoto:472
msgid "origem não encontrada:"
msgstr "source introuvable :"

#: chili-backup-remoto:476
msgid "origem não encontrada em"
msgstr "origine introuvable dans"

#: chili-backup-remoto:517
msgid "rsync retornou"
msgstr "rsync renvoyé"

#: chili-backup-remoto:517
msgid "em"
msgstr "dans"

#: chili-backup-remoto:517
msgid "alguns arquivos não foram copiados"
msgstr "certains fichiers n'ont pas été copiés"

#: chili-backup-remoto:525
msgid "Simulação concluída — nada foi gravado ou removido"
msgstr "Simulation terminée : rien n'a été enregistré ou supprimé"

#: chili-backup-remoto:531
msgid "Backup concluído com ressalvas:"
msgstr "Sauvegarde complétée avec des mises en garde :"

#: chili-backup-remoto:534
msgid "Backup concluído:"
msgstr "Sauvegarde terminée :"
