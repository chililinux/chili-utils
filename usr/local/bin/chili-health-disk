export TEXTDOMAINDIR=/usr/share/locale
export TEXTDOMAIN=chili-health-disk

#debug
export PS4='${red}${0##*/}${green}[$FUNCNAME]${pink}[$LINENO]${reset}'
#set -x
#set -e
#set -euo pipefail
shopt -s extglob

#system
declare APP="${0##*/}"
declare APPBASE="${APP%.*}"
declare _VERSION_="0.09.00-20260830"
declare APPVERSION_="0.09.00-20260830"
declare APPDESC="$APP - Wrapper for disk health diagnostic"
declare distro=""
declare DIALOG=dialog
declare USE_DIALOG=true
declare OPT_SPEED=false
declare OPT_ALL=false
declare OPT_MONITOR=false
declare HISTORY_DIR="/var/log/chili-health-disk"
