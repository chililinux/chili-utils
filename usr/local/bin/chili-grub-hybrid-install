    #: "${INFO="${cyan}[⛭]${rst}"}"
    : "${INFO="${clrkey}[${yellow}➜${clrkey}]${rst}"}"

    # dialog colors
    REVERSE="\Zr"
    UNDERLINE="\Zu"
    BOLD="\Zb"
    RESET="\Zn"
    BLACK="\Z0"
    YELLOW="\Z3"
    AMARELO="\Zb\Z3"
    WHITE="\Z7"
    BLUE="\Z4"
    AZUL="\Zb\Z4"
    CYAN="\Z6"
    RED="\Z1"
    GREEN="\Z2"
    MAGENTA="\Z5"
