  ${green}sudo $prog --device /dev/sdi --bootloader-id ChiliLinux${reset}
  ${green}sudo $prog --device /dev/sdi --id ChiliLinux${reset}
  ${green}sudo $prog --device /dev/sdi --id ChiliLinux --output${reset}

Sem parâmetros, abre a interface interativa com ${bold}dialog${reset}.

${bold}${yellow}ATENÇÃO:${reset} o GRUB BIOS será gravado diretamente no disco.
EOF
}

info() {
  printf '%s==>%s %s\n' "${bold}${blue}" "$reset" "$*"
}

success() {
  printf '%s==>%s %s\n' "${bold}${green}" "$reset" "$*"
}

warning() {
  printf '%sAVISO:%s %s\n' "${bold}${yellow}" "$reset" "$*"
}

error() {
  printf '%sERRO:%s %s\n' "${bold}${red}" "$reset" "$*" >&2
}

# Conta caracteres visuais de uma string UTF-8, sem depender da locale
# do sistema (evita o problema de printf '%-Ns' contar bytes em vez de
# caracteres quando há acentos como 'ç'/'ã').
utf8_len() {
  local s="$1"
  LC_ALL=C awk -v s="$s" 'BEGIN {
    n = length(s)
    cont = gsub(/[\x80-\xBF]/, "", s)
    print n - cont
  }'
}

# Imprime uma linha "rótulo : valor" alinhada em uma tabela de largura
# fixa, calculando o preenchimento pela largura visual real do rótulo
# (não pela contagem de bytes).
print_field() {
  local label="$1"
  local value="$2"
  local width="${3:-17}"
  local len pad

  len="$(utf8_len "$label")"
  pad=$(( width - len ))
  (( pad < 0 )) && pad=0

  printf '  %s%*s : %s\n' "$label" "$pad" "" "$value"
}

die() {
  local msg="$1"

  if [[ "$ui" == "dialog" ]] && command -v dialog >/dev/null 2>&1; then
    dialog \
      --colors \
      --title "\Z1\Zb ERRO \Zn" \
      --msgbox "\n\Z1$msg\Zn" \
      9 65
  else
    error "$msg"
  fi
  exit 1
}

cleanup() {
  if [[ -n "$tmpdir" && -d "$tmpdir" ]]; then
    if mountpoint -q "$tmpdir" 2>/dev/null; then
      umount "$tmpdir" 2>/dev/null || true
    fi
    rmdir "$tmpdir" 2>/dev/null || true
  fi

  if [[ -n "$tmprootdir" && -d "$tmprootdir" ]]; then
    if mountpoint -q "$tmprootdir" 2>/dev/null; then
      umount "$tmprootdir" 2>/dev/null || true
    fi
    rmdir "$tmprootdir" 2>/dev/null || true
  fi
}

select_device() {
  local -a menu=()
  local dev type size model

  while IFS= read -r dev; do
    [[ -n "$dev" ]] || continue

    type="$(lsblk -dn -o TYPE "$dev" 2>/dev/null || true)"
    [[ "$type" == "disk" ]] || continue

    size="$(lsblk -dn -o SIZE "$dev" 2>/dev/null || true)"
    model="$(lsblk -dn -o MODEL "$dev" 2>/dev/null || true)"

    model="${model#"${model%%[![:space:]]*}"}"
    model="${model%"${model##*[![:space:]]}"}"

    menu+=(
      "$dev"
      "\Z6${size}\Zn  ${model:-Sem modelo}"
    )
  done < <(lsblk -dpn -o NAME -e 7,11)

  ((${#menu[@]})) ||
    die "Nenhum disco disponível encontrado."

  dialog \
    --colors \
    --stdout \
    --title "\Z6\Zb Selecionar disco \Zn" \
    --menu "\n\ZbSelecione o disco de destino:\Zn" \
    18 76 10 \
    "${menu[@]}"
}

# Verifica se o disco tem onde o grub-install embutir o core.img:
# - GPT: exige partição dedicada com GUID bios_grub
#   (21686148-6449-6E6F-744E-656564454649)
# - MBR/dos: usa o espaço (gap) entre o MBR e a primeira partição,
#   que precisa ter pelo menos ~1 MiB (2048 setores de 512 bytes)
check_bios_boot_partition() {
  local device="$1"
  local pttype
  pttype="$(lsblk -dno PTTYPE "$device" 2>/dev/null || true)"

  case "${pttype,,}" in
    gpt)
      local has_biosboot=0
      local part parttype

      while read -r part parttype; do
        if [[ "${parttype,,}" == "21686148-6449-6e6f-744e-656564454649" ]]; then
          has_biosboot=1
          break
        fi
      done < <(lsblk -rpn -o NAME,PARTTYPE "$device" 2>/dev/null)

      if (( ! has_biosboot )); then
        die "O disco $device usa tabela GPT e não possui partição BIOS Boot (bios_grub).

Crie uma partição de ~1 MiB com a flag bios_grub antes de continuar, ex:
  sudo parted $device mkpart primary 1MiB 2MiB
  sudo parted $device set <N> bios_grub on"
      fi
      ;;
    dos|mbr|"")
      local first_start
      first_start="$(
        lsblk -rpno NAME,TYPE,START "$device" 2>/dev/null \
          | awk '$2=="part"{print $3}' \
          | sort -n \
          | head -1
      )"

      # Se a coluna START não estiver disponível (util-linux antigo),
      # apenas avisa e segue; não é motivo para travar a instalação.
      if [[ -n "$first_start" ]] && (( first_start < 2048 )); then
        warning "Pouco espaço entre o MBR e a primeira partição em $device (start=$first_start setores)."
        warning "grub-install pode falhar ao embutir o core.img; considere realocar a primeira partição."
      fi
      ;;
  esac
}

# Detecta automaticamente, entre as partições do disco de destino, qual
# delas contém o /boot do sistema cliente — seja a partição raiz (com
# /boot como subdiretório) ou uma partição /boot dedicada e separada.
# Isso é necessário porque o host pode estar rodando um sistema
# operacional diferente do cliente (ex: live-ISO instalando em outra
# máquina); sem essa detecção, o --boot-directory do grub-install
# apontaria para o /boot do host, não do disco de destino.
#
# Parâmetros: device, esp_part, strict (padrão 1)
#   strict=1 (GPT): aborta o script (die) se não conseguir identificar
#     a partição raiz/boot — a portabilidade entre hosts diferentes é
#     essencial nesse caso.
#   strict=0 (MBR): retorna 1 (sem abortar) se não conseguir
#     identificar — o chamador decide o que fazer (ex: instalar BIOS
#     usando o /boot do host mesmo assim). Ambiguidade (mais de uma
#     candidata) SEMPRE aborta, estrito ou não — não há decisão segura
#     possível nesse caso.
#
# Preenche as variáveis globais: boot_part e boot_kind (root|bootdir).
detect_boot_target() {
  local device="$1"
  local esp_part="$2"
  local strict="${3:-1}"
  local -a candidates=()
  local part parttype fstype

  while read -r part parttype fstype; do
    [[ -n "$part" ]] || continue
    [[ -n "$esp_part" && "$part" == "$esp_part" ]] && continue

    case "${parttype,,}" in
      21686148-6449-6e6f-744e-656564454649) continue ;; # bios_grub (GPT)
      0657fd6d-a4ab-43c4-84e5-0933c84b4f4f) continue ;; # swap (GPT)
      c12a7328-f81f-11d2-ba4b-00a0c93ec93b) continue ;; # ESP (GPT)
      82) continue ;; # swap (MBR)
      ef) continue ;; # ESP (MBR)
      5 | 85 | c5 | cf) continue ;; # partição estendida (MBR)
    esac

    case "${fstype,,}" in
      "" | swap | vfat | fat12 | fat16 | fat32 | ntfs | exfat | iso9660 | crypto_luks) continue ;;
    esac

    candidates+=("$part")
  done < <(lsblk -rpn -o NAME,PARTTYPE,FSTYPE "$device" 2>/dev/null)

  if ((${#candidates[@]} == 0)); then
    if (( strict )); then
      die "Nenhuma partição com sistema de arquivos Linux foi encontrada em $device.

O grub-install precisa de uma partição FORMATADA (ext4, btrfs, xfs
etc.) para gravar os módulos do GRUB e, futuramente, o grub.cfg —
uma partição vazia/sem filesystem não serve.

Formate a partição raiz antes de continuar, ex:
  sudo mkfs.ext4 ${device}1   (ajuste o número conforme o layout do disco)

Se a partição já foi formatada e o erro persistir, rode
'sudo partprobe $device' ou 'sudo udevadm settle' para atualizar o cache
de partições e tente novamente."
    fi
    return 1
  fi

  local -a root_hits=() boot_hits=()
  local c probe

  for c in "${candidates[@]}"; do
    probe="$(mktemp -d /tmp/grub-scan.XXXXXX)"

    if mount -o ro "$c" "$probe" 2>/dev/null; then
      if [[ -d "$probe/etc" && -d "$probe/boot/grub" ]]; then
        root_hits+=("$c")
      elif [[ -d "$probe/grub" && ! -d "$probe/etc" ]]; then
        boot_hits+=("$c")
      fi
      umount "$probe" 2>/dev/null || true
    fi

    rmdir "$probe" 2>/dev/null || true
  done

  if (( ${#root_hits[@]} == 1 )); then
    boot_part="${root_hits[0]}"
    boot_kind="root"
    return 0
  fi

  # Ambiguidade sempre aborta, independente de strict — não há decisão
  # segura possível quando mais de uma partição parece candidata.
  if (( ${#root_hits[@]} > 1 )); then
    die "Mais de uma partição raiz candidata foi encontrada em $device: ${root_hits[*]}
Não é possível decidir automaticamente qual usar. Verifique o layout do disco."
  fi

  if (( ${#boot_hits[@]} == 1 )); then
    boot_part="${boot_hits[0]}"
    boot_kind="bootdir"
    return 0
  fi

  if (( ${#boot_hits[@]} > 1 )); then
    die "Mais de uma partição /boot candidata foi encontrada em $device: ${boot_hits[*]}
Não é possível decidir automaticamente qual usar. Verifique o layout do disco."
  fi

  if (( strict )); then
    die "Não foi possível identificar automaticamente a partição raiz (ou /boot) em $device.

Este script detecta a partição certa procurando por um sistema
Linux JÁ INSTALADO nela (diretórios /etc e /boot/grub na raiz, ou
uma partição /boot dedicada com /grub). Ele não cria essa estrutura
do zero — se a partição está formatada mas vazia, instale o sistema
cliente nela antes de rodar este script."
  fi

  return 1
}

trap cleanup EXIT INT TERM

# Permite -h/--help sem root
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
  esac
done

# Todo o restante exige root
if (( EUID != 0 )); then
  error "Execute como root."
  exit 1
fi

# Parâmetros
while (($#)); do
  case "$1" in
    --device)
      (($# >= 2)) || {
        error "--device requer um argumento."
        exit 2
      }
      device="$2"
      shift 2
      ;;
    --device=*)
      device="${1#*=}"
      shift
      ;;
    --bootloader-id|--id)
      (($# >= 2)) || {
        error "$1 requer um argumento."
        exit 2
      }
      bootloader_id="$2"
      shift 2
      ;;
    --bootloader-id=*|--id=*)
      bootloader_id="${1#*=}"
      shift
      ;;
    -o|--output)
      dryrun=1
      shift
      ;;
    *)
      error "Opção/argumento inválido: $1"
      usage >&2
      exit 2
      ;;
  esac
done

# Parâmetros completos = terminal
# Sem parâmetros ou parâmetros incompletos = dialog
if [[ -n "$device" && -n "$bootloader_id" ]]; then
  ui="terminal"
fi

# Entrada via dialog
if [[ "$ui" == "dialog" ]]; then
  command -v dialog >/dev/null 2>&1 ||
    die "Comando 'dialog' não encontrado."

  first_dialog=1

  while :; do
    if (( first_dialog )); then
      form_device="${device:-/dev/sdX}"
      form_id="${bootloader_id:-ChiliLinux}"
      first_dialog=0
    else
      form_device="$device"
      form_id="$bootloader_id"
    fi

    result="$(
      dialog \
        --colors \
        --stdout \
        --title "\Z6\Zb Instalação do GRUB BIOS + UEFI \Zn" \
        --mixedform \
"\ZbInforme os parâmetros:\Zn

\Z3Dica:\Zn limpe o campo \Z6Disco destino\Zn para selecionar
      um dispositivo na lista de discos disponíveis." \
        14 74 2 \
        "Disco destino:" 1 2 "$form_device" \
          1 20 42 42 0 \
        "Bootloader ID:" 2 2 "$form_id" \
          2 20 42 42 0
    )" || exit 0

    mapfile -t fields <<< "$result"
    device="${fields[0]:-}"
    bootloader_id="${fields[1]:-}"

    # Device vazio = abre menu e retorna ao mixedform
    if [[ -z "$device" ]]; then
      device="$(select_device)" || exit 0
      continue
    fi

    # Device precisa existir e ser dispositivo de bloco
    if [[ ! -b "$device" ]]; then
      dialog \
        --colors \
        --title "\Z1\Zb ERRO \Zn" \
        --msgbox \
"\nDispositivo inválido:

  \Z3$device\Zn

Informe um dispositivo de bloco válido ou limpe
o campo para selecionar um disco na lista." \
        12 64
      continue
    fi

    # Device precisa ser um disco inteiro
    device_type="$(lsblk -ndo TYPE "$device" 2>/dev/null || true)"

    if [[ "$device_type" != "disk" ]]; then
      dialog \
        --colors \
        --title "\Z1\Zb ERRO \Zn" \
        --msgbox \
"\nO dispositivo informado não é um disco inteiro:

  \Z3$device\Zn

Informe um disco como \Z6/dev/sda\Zn ou
\Z6/dev/nvme0n1\Zn." \
        12 64
      continue
    fi

    # Device precisa já estar particionado
    device_part_count="$(
      lsblk -rpno NAME,TYPE "$device" 2>/dev/null \
        | awk '$2=="part"{c++} END{print c+0}'
    )"

    if (( device_part_count == 0 )); then
      dialog \
        --colors \
        --title "\Z1\Zb ERRO \Zn" \
        --msgbox \
"\nO disco \Z3$device\Zn não possui nenhuma partição.

Particione antes de continuar, ex:
  sudo parted $device mklabel gpt
  sudo parted $device mkpart root ext4 1MiB 100%

Ou selecione outro disco já particionado." \
        14 66
      continue
    fi

    # Bootloader ID obrigatório
    if [[ -z "$bootloader_id" ]]; then
      dialog \
        --colors \
        --title "\Z1\Zb ERRO \Zn" \
        --msgbox \
"\nO campo \Z3\ZbBootloader ID\Zn não pode ficar vazio.

Informe um ID para continuar." \
        10 58
      continue
    fi

    # Somente sai do mixedform quando tudo estiver válido
    break
  done
fi

# Dependências
for cmd in grub-install lsblk mount umount mountpoint mktemp; do
  command -v "$cmd" >/dev/null 2>&1 ||
    die "Comando não encontrado: $cmd"
done

# Validação geral
# Também protege o modo via parâmetros
[[ -n "$device" ]] ||
  die "Informe o disco destino."

[[ -b "$device" ]] ||
  die "Não é um dispositivo de bloco: $device"

device_type="$(lsblk -ndo TYPE "$device" 2>/dev/null || true)"

[[ "$device_type" == "disk" ]] ||
  die "Informe um disco inteiro, não uma partição: $device"

[[ -n "$bootloader_id" ]] ||
  die "Bootloader ID não pode ficar vazio."

# O disco precisa já estar particionado — sem partições não há onde
# detectar ESP nem partição raiz/boot, e o erro genérico de "sistema
# de arquivos não encontrado" mais adiante seria confuso.
device_part_count="$(
  lsblk -rpno NAME,TYPE "$device" 2>/dev/null \
    | awk '$2=="part"{c++} END{print c+0}'
)"

if (( device_part_count == 0 )); then
  die "O disco $device não possui nenhuma partição.

Particione o disco antes de continuar, ex:

  # GPT (recomendado, permite BIOS + UEFI):
  sudo parted $device mklabel gpt
  sudo parted $device mkpart bios_grub 1MiB 2MiB
  sudo parted $device set 1 bios_grub on
  sudo parted $device mkpart ESP fat32 2MiB 514MiB
  sudo parted $device set 2 esp on
  sudo parted $device mkpart root ext4 514MiB 100%

  # ou MBR (somente BIOS):
  sudo parted $device mklabel msdos
  sudo parted $device mkpart primary ext4 1MiB 100%

Depois formate as partições (mkfs.vfat/mkfs.ext4) e instale o
sistema cliente nelas antes de rodar este script."
fi

# Decide se o GRUB UEFI será instalado com base no tipo de tabela de
# partição do DISCO DE DESTINO — não no modo de boot do host que está
# executando este script. O host só executa o grub-install; quem vai
# efetivamente usar o disco depois é outra máquina, então o que importa
# é o que o disco suporta, não como o host foi iniciado.
device_pttype="$(lsblk -dno PTTYPE "$device" 2>/dev/null || true)"

if [[ "${device_pttype,,}" == "gpt" ]]; then
  gpt_disk=1
fi

# Localiza ESP somente em disco GPT
if (( gpt_disk )); then
  while read -r part parttype; do
    if [[ "${parttype,,}" == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ]]; then
      esp="$part"
      break
    fi
  done < <(lsblk -rpn -o NAME,PARTTYPE "$device")

  if [[ -z "$esp" ]]; then
    # Degrada graciosamente para BIOS-only em vez de abortar o script:
    # o disco é GPT, mas não tem ESP (ex: usuário não criou a partição).
    gpt_disk=0

    if [[ "$ui" == "dialog" ]]; then
      dialog \
        --colors \
        --title "\Z3\Zb ESP não encontrada \Zn" \
        --msgbox \
"\Z3\ZbAVISO\Zn

O disco \Z6$device\Zn usa tabela GPT, mas nenhuma partição
EFI System (ESP) foi encontrada nele.

\Z6Modo de instalação:\Zn
  GRUB BIOS : \Z2$device\Zn
  GRUB UEFI : \Z3não será instalado (sem ESP)\Zn" \
        14 66
    else
      warning "Disco $device usa GPT, mas nenhuma partição EFI (ESP) foi encontrada."
      warning "GRUB UEFI não será instalado; somente GRUB BIOS em $device."
    fi
  fi
else
  if [[ "$ui" == "dialog" ]]; then
    dialog \
      --colors \
      --title "\Z3\Zb UEFI não aplicável \Zn" \
      --msgbox \
"\Z3\ZbAVISO\Zn

O disco \Z6$device\Zn usa tabela \Z3MBR/dos\Zn (não GPT).

\Z6Modo de instalação:\Zn
  GRUB BIOS : \Z2$device\Zn
  GRUB UEFI : \Z3não será instalado (disco não é GPT)\Zn" \
      13 66
  else
    warning "Disco $device usa tabela MBR/dos (não GPT)."
    warning "GRUB UEFI não será instalado; somente GRUB BIOS em $device."
  fi
fi

# Detecta automaticamente a partição raiz (ou /boot dedicada) do
# sistema cliente no disco de destino
info "Detectando partição de boot do sistema cliente em $device..."

if (( gpt_disk )); then
  # GPT: detecção estrita — sem ela, o disco não seria portável entre
  # hosts diferentes (o propósito central deste script).
  detect_boot_target "$device" "$esp"
else
  # MBR: detecção não-estrita — se não achar, instala o GRUB BIOS
  # mesmo assim, usando o /boot padrão do HOST (aviso é dado abaixo).
  if ! detect_boot_target "$device" "$esp" 0; then
    boot_part=""
    boot_kind="none"
  fi
fi

if [[ "$boot_kind" == "root" ]]; then
  boot_kind_label="raiz (/boot como subdiretório)"
elif [[ "$boot_kind" == "bootdir" ]]; then
  boot_kind_label="dedicada (partição /boot separada)"
else
  boot_kind_label="usando /boot do host"
fi

boot_part_display="${boot_part:-nenhuma}"

if [[ "$boot_kind" == "none" ]]; then
  warning "Nenhuma partição raiz/boot detectada em $device (disco MBR)."
  warning "O GRUB BIOS será instalado usando o /boot deste HOST, não do"
  warning "disco de destino — o resultado só será válido enquanto o disco"
  warning "for usado com este host, ou até que o sistema cliente seja"
  warning "instalado nele e o script seja executado novamente."
else
  info "Partição de boot detectada: $boot_part_display ($boot_kind_label)"
fi

# Modo dry-run (-o/--output): mostra os comandos que seriam executados
# para todo o processo, sem gravar nada de fato.
if (( dryrun )); then
  # Mesma checagem que a instalação real faria — se o disco GPT não
  # tiver a partição bios_grub, o dry-run também deve avisar/abortar,
  # em vez de mostrar um comando que na prática falharia.
  check_bios_boot_partition "$device"

  if [[ "$boot_kind" == "none" ]]; then
    dry_boot_dir=""
  else
    dry_tmproot="$(mktemp -u /tmp/grub-root.XXXXXX)"

    if [[ "$boot_kind" == "root" ]]; then
      dry_boot_dir="$dry_tmproot/boot"
    else
      dry_boot_dir="$dry_tmproot"
    fi
  fi

  printf '\n'
  replicate '='
  printf '%s%sModo dry-run (--output): nenhuma alteração será feita.%s\n' "$bold" "$yellow" "$reset"
  replicate '='
  printf '\n'

  print_field "Disco" "$device"
  print_field "Partição de boot" "$boot_part_display ($boot_kind_label)"
  (( gpt_disk )) && print_field "Partição EFI" "$esp"
  print_field "Bootloader ID" "$bootloader_id"

  printf '\n%s%sComandos que seriam executados:%s\n\n' "$bold" "$cyan" "$reset"

  if [[ "$boot_kind" == "none" ]]; then
    printf '  %s$%s grub-install --target=i386-pc --recheck %s\n' "$cyan" "$reset" "$device"
    printf '  %s(sem --boot-directory: usaria o /boot deste host)%s\n' "$yellow" "$reset"
  else
    printf '  %s$%s mktemp -d %s\n' "$cyan" "$reset" "/tmp/grub-root.XXXXXX"
    printf '  %s$%s mount %s %s\n' "$cyan" "$reset" "$boot_part" "$dry_tmproot"
    printf '  %s$%s grub-install --target=i386-pc --boot-directory=%s --recheck %s\n' \
      "$cyan" "$reset" "$dry_boot_dir" "$device"
    printf '  %s$%s sync\n' "$cyan" "$reset"
    printf '  %s$%s umount %s\n' "$cyan" "$reset" "$dry_tmproot"
    printf '  %s$%s rmdir %s\n' "$cyan" "$reset" "$dry_tmproot"
  fi

  if (( gpt_disk )); then
    dry_tmpefi="$(mktemp -u /tmp/grub-efi.XXXXXX)"

    printf '\n'
    printf '  %s$%s mktemp -d %s\n' "$cyan" "$reset" "/tmp/grub-efi.XXXXXX"
    printf '  %s$%s mount %s %s\n' "$cyan" "$reset" "$esp" "$dry_tmpefi"
    printf '  %s$%s grub-install --target=x86_64-efi --efi-directory=%s --boot-directory=%s --bootloader-id=%s --removable --recheck\n' \
      "$cyan" "$reset" "$dry_tmpefi" "$dry_boot_dir" "$bootloader_id"
    printf '  %s$%s sync\n' "$cyan" "$reset"
    printf '  %s$%s umount %s\n' "$cyan" "$reset" "$dry_tmpefi"
    printf '  %s$%s rmdir %s\n' "$cyan" "$reset" "$dry_tmpefi"
  fi

  printf '\n'
  replicate '='
  printf '%s%sNenhum comando acima foi executado (modo --output).%s\n' "$bold" "$green" "$reset"
  replicate '='

  exit 0
fi

# Prepara confirmação
if (( gpt_disk )); then
  confirm="\Z6\ZbDestino\Zn

  Disco             : \Z2$device\Zn
  Partição de boot  : \Z2$boot_part_display\Zn ($boot_kind_label)
  Partição EFI      : \Z2$esp\Zn
  Bootloader ID     : \Z2$bootloader_id\Zn

\Z6\ZbInstalação\Zn

  GRUB BIOS     : \Z2$device\Zn
  GRUB UEFI     : \Z2$esp\Zn
  NVRAM         : \Z3não alterada (--removable)\Zn
  EFI fallback  : \Z2EFI/BOOT/BOOTX64.EFI\Zn"
else
  confirm="\Z6\ZbDestino\Zn

  Disco             : \Z2$device\Zn
  Partição de boot  : \Z2$boot_part_display\Zn ($boot_kind_label)
  Tabela de partição: \Z3MBR/dos\Zn

\Z6\ZbInstalação\Zn

  GRUB BIOS     : \Z2$device\Zn
  GRUB UEFI     : \Z3ignorado\Zn"
fi

# Confirmação obrigatória antes de qualquer gravação
if [[ "$ui" == "dialog" ]]; then
  dialog \
    --colors \
    --title "\Z3\Zb Confirmar instalação \Zn" \
    --yes-label "Instalar" \
    --no-label "Cancelar" \
    --defaultno \
    --yesno "$confirm" \
    20 74 || exit 0
else
  printf '\n%s%sConfirmar instalação%s\n\n' "$bold" "$yellow" "$reset"

  if (( gpt_disk )); then
    print_field "Disco" "$device"
    print_field "Partição de boot" "$boot_part_display ($boot_kind_label)"
    print_field "Partição EFI" "$esp"
    print_field "Bootloader ID" "$bootloader_id"
    print_field "GRUB BIOS" "$device"
    print_field "GRUB UEFI" "$esp"
    print_field "NVRAM" "não alterada (--removable)"
  else
    print_field "Disco" "$device"
    print_field "Partição de boot" "$boot_part_display ($boot_kind_label)"
    print_field "Tabela de partição" "MBR/dos"
    print_field "GRUB BIOS" "$device"
    print_field "GRUB UEFI" "ignorado"
  fi

  printf '\n'
  read -r -p "Deseja continuar? [s/N] " answer

  case "${answer,,}" in
    s|sim|y|yes) ;;
    *)
      warning "Operação cancelada."
      exit 0
      ;;
  esac
fi

# Monta a partição de boot detectada uma única vez — será usada tanto
# no grub-install BIOS quanto no EFI, para que ambos referenciem o
# /boot do disco de destino (e não o /boot do host).
check_bios_boot_partition "$device"

if [[ "$boot_kind" == "none" ]]; then
  # MBR sem partição raiz/boot detectada: instala mesmo assim, usando
  # o /boot padrão do host (já avisado ao usuário anteriormente).
  grub_boot_dir=""
else
  tmprootdir="$(mktemp -d /tmp/grub-root.XXXXXX)"

  info "Montando partição de boot detectada ($boot_part)..."

  mount "$boot_part" "$tmprootdir" ||
    die "Não foi possível montar $boot_part."

  if [[ "$boot_kind" == "root" ]]; then
    grub_boot_dir="$tmprootdir/boot"
  else
    grub_boot_dir="$tmprootdir"
  fi

  [[ -d "$grub_boot_dir" ]] ||
    die "Diretório de boot não encontrado em $boot_part (esperado: $grub_boot_dir)."
fi

# GRUB BIOS
declare -a grub_bios_boot_dir_arg=()
[[ -n "$grub_boot_dir" ]] && grub_bios_boot_dir_arg=(--boot-directory="$grub_boot_dir")

if [[ -n "$grub_boot_dir" ]]; then
  info "Instalando GRUB BIOS em $device (boot-directory: $grub_boot_dir)..."
else
  info "Instalando GRUB BIOS em $device (usando /boot deste host)..."
fi

if ! grub-install \
  --target=i386-pc \
  "${grub_bios_boot_dir_arg[@]}" \
  --recheck \
  "$device" \
  >/tmp/grub-bios.log 2>&1
then
  die "Falha ao instalar GRUB BIOS. Log: /tmp/grub-bios.log"
fi

success "GRUB BIOS instalado."

# GRUB UEFI
if (( gpt_disk )); then
  tmpdir="$(mktemp -d /tmp/grub-efi.XXXXXX)"

  info "Montando $esp..."

  mount "$esp" "$tmpdir" ||
    die "Não foi possível montar $esp."

  info "Instalando GRUB UEFI em $esp (boot-directory: $grub_boot_dir)..."

  if ! grub-install \
    --target=x86_64-efi \
    --efi-directory="$tmpdir" \
    --boot-directory="$grub_boot_dir" \
    --bootloader-id="$bootloader_id" \
    --removable \
    --recheck \
    >/tmp/grub-efi.log 2>&1
  then
    die "Falha ao instalar GRUB UEFI. Log: /tmp/grub-efi.log"
  fi

  success "GRUB UEFI instalado."

  sync

  umount "$tmpdir"
  rmdir "$tmpdir"
  tmpdir=""
fi

sync

if [[ -n "$tmprootdir" ]]; then
  umount "$tmprootdir"
  rmdir "$tmprootdir"
  tmprootdir=""
fi

# Resultado final
if [[ -n "$grub_boot_dir" ]]; then
  grub_boot_dir_note="boot-directory: $grub_boot_dir"
else
  grub_boot_dir_note="usando /boot do host"
fi

if [[ "$ui" == "dialog" ]]; then
  if (( gpt_disk )); then
    final="\Z2\ZbInstalação concluída com sucesso.\Zn

  GRUB BIOS         : \Z6$device\Zn ($grub_boot_dir_note)
  Partição de boot  : \Z6$boot_part_display\Zn ($boot_kind_label)
  GRUB UEFI         : \Z6$esp\Zn
  Bootloader ID     : \Z6$bootloader_id\Zn
  NVRAM             : \Z3não alterada (--removable)\Zn
  EFI fallback      : \Z6EFI/BOOT/BOOTX64.EFI\Zn"
  else
    final="\Z2\ZbInstalação concluída com sucesso.\Zn

  GRUB BIOS         : \Z6$device\Zn ($grub_boot_dir_note)
  Partição de boot  : \Z6$boot_part_display\Zn ($boot_kind_label)
  GRUB UEFI         : \Z3não instalado\Zn"
  fi

  dialog \
    --colors \
    --title "\Z2\Zb GRUB \Zn" \
    --msgbox "$final" \
    17 76
else
  success "Instalação concluída com sucesso."

  printf '\n'
  print_field "GRUB BIOS" "$device ($grub_boot_dir_note)"
  print_field "Partição de boot" "$boot_part_display ($boot_kind_label)"

  if (( gpt_disk )); then
    print_field "GRUB UEFI" "$esp"
    print_field "Bootloader ID" "$bootloader_id"
    print_field "NVRAM" "não alterada (--removable)"
    print_field "EFI fallback" "EFI/BOOT/BOOTX64.EFI"
  else
    print_field "GRUB UEFI" "não instalado"
  fi
fi

exit 0

