  cat <<EOF
Instala o ${bold}GRUB BIOS + UEFI${reset} no disco de destino.

${bold}${cyan}Uso:${reset} ${green}$prog${reset} [OPÇÕES]

${bold}${cyan}Opções:${reset}
  ${yellow}--device DISCO${reset}              Disco destino (ex: /dev/sdi)
  ${yellow}--bootloader-id ID, --id ID${reset} ID do bootloader EFI (ex: ChiliLinux)
