MostraErro() { echo "erro: ${red}$1${reset} => comando: ${cyan}'$2'${reset} => result=${yellow}$3${reset}"; }
trap 'MostraErro "${APP}[${FUNCNAME[0]}][$LINENO]" "$BASH_COMMAND" "$?"; exit 1' ERR
cleanup() {
	if ! $IS_ROOT_DISK; then
		if mount | grep -q "$MNT_TMP"; then
			msg "Desmontando a partição EFI..."
			run_cmd "umount -R $MNT_TMP" 2>/dev/null || true
		fi
	fi
	if [[ -n "$MNT_ROOT" ]] && mount | grep -q " $MNT_ROOT "; then
		umount -R "$MNT_ROOT" 2>/dev/null || true
		rmdir "$MNT_ROOT" 2>/dev/null || true
	fi
	# Desfaz o mapeamento das partições da LV, senão ela fica "em uso"
	# (trava lvremove/migração no Proxmox)
	if [[ "$DM_MAPPED" == true ]]; then
		local p
		for p in $(lsblk -lnp -o NAME,TYPE "$DISK" 2>/dev/null | awk '$2=="part"{print $1}'); do
			dmsetup remove "$p" >/dev/null 2>&1 || true
		done
	fi
	return 0
}
trap cleanup EXIT

