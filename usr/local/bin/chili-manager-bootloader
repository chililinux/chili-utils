		        Você pode ler instruções sobre como baixar e criar para você mesmo
		        o código fonte específico usado para criar esta cópia.
		        ${red}Este programa vem com absolutamente NENHUMA garantia.${reset}
	EOF
}

# Sistema iniciado em UEFI? (sem isso não há NVRAM para o efibootmgr)
is_efi_boot() {
	[[ -d /sys/firmware/efi ]]
}

# Nome do modo para exibir: uefi instala UEFI e BIOS, então aparece "uefi/bios"
mode_label() {
	[[ "${1:-$MODE}" == "uefi" ]] && echo "uefi/bios" || echo "bios"
}

# Converte o que foi digitado para o valor interno (uefi | bios); vazio se inválido
parse_mode() {
	case "${1,,}" in
	uefi/bios | uefi) echo "uefi" ;;
	bios) echo "bios" ;;
	esac
}

# Modo padrão: UEFI (+ BIOS) se o sistema iniciou em UEFI; senão, só BIOS
detect_mode() {
	if is_efi_boot; then
		MODE="uefi"
	else
		MODE="bios"
	fi
}

verificar_uefi() {
	if [[ ! -d /sys/firmware/efi ]]; then
		die "${red}O sistema não foi iniciado em modo UEFI!${reset}"
	fi
	log_ok "${green}O sistema foi iniciado em modo UEFI${reset}"
}

# ===================================================================
# Funções auxiliares
# ===================================================================
run_cmd() {
	local cmd="$*"
	if [[ $DRYRUN -eq 1 ]]; then
		# printf '%s' para o comando: echo -e interpretaria \E, \U etc. (ex: \EFI\UEFI)
		printf '%s %s\n' "${INFO} ${cyan}[DRY-RUN]${rst}" "$cmd"
		return 0
	fi

	printf '  [⚙  ] %s%s%s\n' "${cyan}" "$cmd" "${rst}"
	# umount -R é usado só na limpeza: erro ignorado
	if [[ "$cmd" =~ ^umount\ -R ]]; then
		eval "$cmd" &>/dev/null || true
		return 0
	fi
	# Executa e devolve o status real do comando
	if ! eval "$cmd"; then
		log_err "Falha ao executar: $cmd"
		return 1
	fi
	return 0
}

# Detecta se o disco passado contém a raiz montada
is_root_disk() {
	local disk="$1"
	local root_part root_disk

	# Pega a partição raiz
	root_part="$(get_root_part "$disk")"

	# Extrai o disco base (remove o sufixo da partição)
	if [[ "$root_part" =~ ^(/dev/(sd[a-z]|hd[a-z]|vd[a-z]|xvd[a-z]|nvme[0-9]+n[0-9]+|mmcblk[0-9]+|loop[0-9]+))p?[0-9]+$ ]]; then
		root_disk="${BASH_REMATCH[1]}"
	else
		root_disk="$root_part" # já é disco
	fi
	[[ "$disk" == "$root_disk" ]]
}

get_root_part() {
	local disk="$1"
	local root_part

	# Pega a partição raiz e remove subvolume
	root_part=$(findmnt -n -o SOURCE /)
	root_part="${root_part%%\[*}" # remove tudo a partir do '['
	echo "$root_part"
}

# ===================================================================
# Verifica se é um disco válido (não partição)
# ===================================================================
is_disk() {
	local dev="$1"

	# Precisa existir como bloco
	[[ -b "$dev" ]] || return 1

	# Tipo do dispositivo
	local type
	type=$(lsblk -dn -o TYPE "$dev" 2>/dev/null)

	# Aceita "disk", "loop" ou "lvm"
	if [[ "$type" == "disk" || "$type" == "loop" || "$type" == "lvm" ]]; then
		return 0
	else
		return 1
	fi
}

detect_fs_type() {
	local part="$1"
	lsblk -no FSTYPE "$part"
}

is_valid_fs() {
	local part="$1"
	local fs

	# Lista de FS aceitos (pode ampliar)
	local valid_fs=("ext2" "ext3" "ext4" "xfs" "btrfs" "vfat" "fat32" "ntfs" "f2fs" "reiserfs" "jfs" "exfat")

	# Captura o tipo de FS
	local fstype=$(detect_fs_type "$part" 2>/dev/null | tr -d '[:space:]')

	# Se não achou FS, não é válido
	[[ -z "$fstype" ]] && return 1

	# Verifica se o FS está na lista
	for fs in "${valid_fs[@]}"; do
		if [[ "$fstype" == "$fs" ]]; then
			return 0
		fi
	done
	return 1
}

is_valid_efi_fs() {
	local part="$1"
	local fstype
	fstype=$(detect_fs_type "$part")

	[[ "$fstype" =~ ^(vfat|fat32)$ ]]
}

get_disk_info() {
	local disk="$1"
	lsblk -dno MODEL,SIZE,PTTYPE "$disk"
}

get_part_num() {
	local part="$1"
	local disk partnum

	# remove eventual sufixo de subvolume ([/@]) ou algo similar
	part="${part%%\[*}"

	# Preferência: número da partição informado pelo kernel
	if [[ -r "/sys/class/block/${part##*/}/partition" ]]; then
		cat "/sys/class/block/${part##*/}/partition"
		return 0
	fi

	# Partição de LV (device-mapper): /dev/mapper/pve-xfce1 ou pve-vm--100--disk--0p1
	if [[ -n "$DISK" && "$part" == "$DISK"* ]]; then
		partnum="${part#"$DISK"}"
		partnum="${partnum#p}"
		if [[ "$partnum" =~ ^[0-9]+$ ]]; then
			echo "$partnum"
			return 0
		fi
	fi

	if [[ "$part" =~ ^/dev/(nvme[0-9]+n[0-9]+|mmcblk[0-9]+|loop[0-9]+)p([0-9]+)$ ]]; then
		# nvme0n1p2, mmcblk0p1 ou loop0p1
		partnum="${BASH_REMATCH[2]}"
	elif [[ "$part" =~ ^/dev/([a-z]+)([0-9]+)$ ]]; then
		# sda1, sdb2, etc
		partnum="${BASH_REMATCH[2]}"
	else
		# caso não seja partição (pode ser disco inteiro)
		partnum=""
	fi

	echo "$partnum"
}

# O kernel não cria os nós das partições de dentro de uma LV: a tabela está
# gravada nela, mas sem mapeamento em /dev/mapper o lsblk não lista filho.
# Mapeia só o disco escolhido (mesma lógica do void-install).
DM_MAPPED=false
map_dm_partitions() {
	local dev="$1"

	[[ -b "$dev" ]] || return 0
	[[ "$(lsblk -dno TYPE "$dev" 2>/dev/null)" == "lvm" ]] || return 0
	lsblk -lnpo TYPE "$dev" 2>/dev/null | grep -qx part && return 0
	[[ -n "$(blkid -p -s PTTYPE -o value "$dev" 2>/dev/null)" ]] || return 0

	msg "Mapeando as partições da LV ${yellow}${dev}${reset}..."
	# partprobe primeiro; kpartx só se o partprobe não criar nada
	partprobe "$dev" >/dev/null 2>&1
	udevadm settle 2>/dev/null
	if ! lsblk -lnpo TYPE "$dev" 2>/dev/null | grep -qx part && command -v kpartx >/dev/null 2>&1; then
		kpartx -a -s "$dev" >/dev/null 2>&1
		udevadm settle 2>/dev/null
	fi
	if lsblk -lnpo TYPE "$dev" 2>/dev/null | grep -qx part; then
		DM_MAPPED=true
		return 0
	fi
	log_warn "Não foi possível mapear as partições de $dev (verifique se o kpartx está instalado)"
	return 1
}

detect_parts() {
	local disk="$1"

	if [[ -n "$ROOT_PART" ]] && ! is_valid_fs "$ROOT_PART"; then
		die "$ROOT_PART não é uma partição válida"
	fi

	if [[ -n "$EFI_PART" ]] && ! is_valid_efi_fs "$EFI_PART"; then
		die "$EFI_PART não é uma ESP válida (precisa ser FAT32)"
	fi

	if [[ -z "$ROOT_PART" || -z "$EFI_PART" ]]; then
		# -p: caminho completo (partição de LV fica em /dev/mapper/..., não em /dev/<nome>)
		for p in $(lsblk -lnp -o NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part"{print $1}'); do
			local fstype
			fstype=$(detect_fs_type "$p")
			if [[ "$fstype" =~ ^(ext4|btrfs|xfs)$ ]]; then
				[[ -z "$ROOT_PART" ]] && ROOT_PART="$p"
			elif [[ "$fstype" =~ ^(vfat|fat32)$ ]]; then
				[[ -z "$EFI_PART" ]] && EFI_PART="$p"
			fi
		done
	fi
	[[ -z "$ROOT_PART" ]] && die "Não foi possível detectar partição ROOT em $disk"
	if [[ -z "$EFI_PART" ]]; then
		# no modo BIOS a partição FAT só é necessária para o Limine (verificado depois)
		[[ "$MODE" == "uefi" ]] && die "Não foi detectada partição EFI (FAT) em $disk. Informe com --efi_part"
		log_warn "Não foi detectada partição FAT em $disk"
	fi
	return 0
}

# Disco raiz: localiza a ESP montada em /boot/efi, /efi ou /boot
detect_root_esp() {
	local mp src

	for mp in /boot/efi /efi /boot; do
		src=$(findmnt -n -o SOURCE "$mp" 2>/dev/null) || continue
		src="${src%%\[*}"
		if [[ -n "$src" ]] && is_valid_efi_fs "$src"; then
			EFI_PART="$src"
			MNT_TMP="$mp"
			return 0
		fi
	done
	return 1
}

confirm_parts() {
	local msgread
	replicate
	msg "Partições detectadas/informadas:"
	msg "${cyan}DISCO       ==> ${yellow}${DISK:-<não detectado>}  ${azul}[$(get_disk_info $DISK)]"
	if $IS_ROOT_PART_USER; then
		msg "${cyan}ROOT_PART   ==> ${yellow}${ROOT_PART:-<não detectada>} ${black}(informada pelo usuário)"
	else
		msg "${cyan}ROOT_PART   ==> ${yellow}${ROOT_PART:-<não detectada>} ${black}(auto detectada)"
	fi
	if $IS_EFI_PART_USER; then
		msg "${cyan}EFI_PART    ==> ${yellow}${EFI_PART:-<não detectada>} ${black}(informada pelo usuário)"
	else
		msg "${cyan}EFI_PART    ==> ${yellow}${EFI_PART:-<não detectada>} ${black}(auto detectada)"
	fi
	msg "${cyan}NICK        ==> ${yellow}${NICK:-<não informado>}"
	msg "${cyan}MODO        ==> ${yellow}$(mode_label)"
	msg "${cyan}BOOTLOADER  ==> ${yellow}${BOOTLOADER}"
	msg "${cyan}CHANGE-GUID ==> ${yellow}${CHANGE_GUID:-<não informado>}"
	replicate

	if $USE_DIALOG; then
		dialog_confirm
		return 0
	fi

	msgread="${red}Deseja continuar com esses parâmetros?${reset}"
	if readconf "$msgread"; then
		msg "Continuando instalação..."
	else
		die "Instalação abortada pelo usuário."
	fi
}

check_grub_install() {
	local disk="$1"     # disco para checar MBR
	local efi_part="$2" # partição para checar UEFI

	# --- Checa BIOS/MBR no disco ---
  msg "Checando GRUB em $disk"
	if dd if="$disk" bs=512 count=1 2>/dev/null | strings | grep -q GRUB; then
		log_ok_tab "GRUB BIOS (MBR) encontrado em $disk"
		HAS_MBR=true
	fi

	# --- Checa UEFI na partição se informada ---
	if [[ -n "$efi_part" ]]; then
		local fstype
		#   fstype=$(lsblk -no FSTYPE "$efi_part" 2>/dev/null) # não funciona com device em loop/losetup
		fstype=$(blkid -o value -s TYPE "$efi_part" 2>/dev/null)

		# FS válidos para UEFI/GRUB
		if [[ "$fstype" =~ ^(vfat|fat|fat32|ext2)$ ]]; then
      if ! $IS_ROOT_DISK; then
      	local tmp=$(mktemp -d)
        mount "$efi_part" "$tmp" 2>/dev/null
				local grub_file=$(find "$tmp/EFI" -maxdepth 2 -type f -iname "grub*.efi" 2>/dev/null | head -n1)
  			umount "$tmp" 2>/dev/null
      	rmdir "$tmp"
      else
				local grub_file=$(find "$MNT_TMP/EFI" -maxdepth 2 -type f -iname "grub*.efi" 2>/dev/null | head -n1)
      fi
			if [[ -n "$grub_file" ]]; then
  			log_ok_tab "GRUB UEFI encontrado em $efi_part ($grub_file)"
	  		HAS_UEFI=true
			fi
		else
			log_err_tab "$efi_part não é um FS válido para UEFI/GRUB - (detectado: $fstype)"
		fi
	fi

	# --- Resultado final ---
	if [[ $HAS_UEFI = true && $HAS_MBR = true ]]; then
		msg_tab "GRUB encontrado em ambos: UEFI e BIOS/MBR."
		return 0
	elif $HAS_UEFI; then
		msg_tab "GRUB instalado apenas em UEFI."
		return 0
	elif $HAS_MBR; then
		msg_tab "GRUB instalado apenas em BIOS/MBR."
		return 0
	else
		msg_tab "✘ Nenhuma instalação do GRUB detectada."
		return 1
	fi
}

change_efi_guid() {
	local disk="$1"     # exemplo: /dev/sda
	local efi_part="$2" # exemplo: /dev/sda2
	local newguid="$3"  # exemplo: R para aleatório ou GUID específico
	local partnum="$(get_part_num $efi_part)"

	# define tipo da partição para EFI
	msg "Alterando tipo da partição $partnum em $disk para EFI System Partition..."
	run_cmd "sgdisk -t ${partnum}:ef00 $disk" || die "Falha ao alterar tipo para EFI"

	# altera GUID
	if [[ -z "$newguid" || "$newguid" == "R" ]]; then
		msg "Gerando GUID aleatório para partição $partnum..."
		run_cmd "sgdisk -u ${partnum}:R $disk" || die "Falha ao gerar GUID aleatório"
	else
		msg "Definindo GUID ${newguid} para partição $partnum..."
		run_cmd "sgdisk -u ${partnum}:${newguid} $disk" || die "Falha ao definir GUID"
	fi

	# avisa o kernel da nova tabela (o sgdisk pode não conseguir se o disco estiver em uso)
	run_cmd "partx -u $disk" || log_warn "Não foi possível atualizar a tabela no kernel; reinicie antes de usar o novo PARTUUID."

	log_ok "✔ Partição $partnum em $disk configurada como EFI com novo GUID."
	log_warn "Se o /etc/fstab desse sistema monta a ESP por PARTUUID, atualize-o com o novo valor."
}

# Verifica se o PARTUUID da ESP também existe em outra partição (ex: disco clonado).
# O firmware identifica a ESP das entradas de boot pelo PARTUUID; duplicado = boot ambíguo.
# Retorna 1 se encontrar duplicata.
check_duplicates() {
	local efi_part="$1"
	local uuid dev puuid found=0

	uuid=$(lsblk -dno PARTUUID "$efi_part" 2>/dev/null | tr -d '[:space:]')
	if [[ -z "$uuid" ]]; then
		log_warn "Não foi possível ler o PARTUUID de $efi_part"
		return 0
	fi

	while read -r dev puuid; do
		[[ -z "$puuid" || "$dev" == "$efi_part" ]] && continue
		if [[ "${puuid,,}" == "${uuid,,}" ]]; then
			log_err "PARTUUID $uuid de $efi_part duplicado em $dev"
			found=1
		fi
	done < <(lsblk -rno PATH,PARTUUID 2>/dev/null)

	if [[ $found -eq 0 ]]; then
		log_ok "Nenhum PARTUUID duplicado para $efi_part."
	fi
	return "$found"
}

# Remove entradas da NVRAM com o mesmo label, para não acumular duplicadas a cada execução
remove_entry_by_label() {
	local label="$1"
	local line bootnum name

	while read -r line; do
		if [[ "$line" =~ ^Boot([0-9A-Fa-f]{4})\*?[[:space:]]+(.*)$ ]]; then
			bootnum="${BASH_REMATCH[1]}"
			name="${BASH_REMATCH[2]%%$'\t'*}"
			if [[ "$name" == "$label" ]]; then
				msg_tab "Removendo entrada antiga Boot${bootnum} '${label}'"
				run_cmd "efibootmgr --quiet --bootnum $bootnum --delete-bootnum >/dev/null"
			fi
		fi
	done < <(efibootmgr 2>/dev/null)
	return 0
}

create_entry_efibootmgr() {
	replicate '-'
	# === Criar a entrada UEFI com efibootmgr ===
	msg "Criando a entrada UEFI com o efibootmgr..."
	remove_entry_by_label "$NICK"
	if run_cmd "efibootmgr --quiet --create --disk $DISK --part $(get_part_num $EFI_PART) --label $NICK --loader '\\EFI\\$NICK\\grubx64.efi' >/dev/null"; then
		log_ok_tab "Entrada ${yellow}'$NICK' ${reset}criada com sucesso!"

		#    	msg "Criando binario UEFI grubx64.efi..."
		#     run_cmd "grub-mkimage -O x86_64-efi -o $MNT_TMP/EFI/$NICK/grubx64.efi -p /EFI/$NICK part_gpt part_msdos fat ext2 normal chain linux configfile search echo"

		GRUB_FILE_EFI=$(find "$MNT_TMP/EFI/" -maxdepth 2 -type f -iname "grub*.efi" \
			! -path "$MNT_TMP/EFI/$NICK/grubx64.efi" -print -quit)

		# falha se não encontrou nenhum outro .efi
		if [[ -z "$GRUB_FILE_EFI" ]]; then
			die "Nenhum GRUB .efi encontrado em $MNT_TMP/EFI (excluído $MNT_TMP/EFI/$NICK/grubx64.efi)."
		fi

		# garante diretório destino (falha se mkdir falhar)
		run_cmd "mkdir -p $MNT_TMP/EFI/$NICK" || die "Falha ao criar diretório $MNT_TMP/EFI/$NICK"

		# copia e falha se cp falhar
		msg_tab "Copiando ${GRUB_FILE_EFI} para ${MNT_TMP}/EFI/${NICK}/grubx64.efi"
		run_cmd "cp -f ${GRUB_FILE_EFI} ${MNT_TMP}/EFI/${NICK}/grubx64.efi" ||
			die "Falha ao copiar ${GRUB_FILE_EFI} para ${MNT_TMP}/EFI/${NICK}/grubx64"
	fi
}

# Monta a ESP em $MNT_TMP (disco alternativo)
mount_efi_part() {
	# === Criar um diretório temporário para montagem da partição EFI ===
	[[ -b "$EFI_PART" ]] || die "Partição EFI inválida: '${EFI_PART}'"

	msg "Criando diretório temporário para montagem: $MNT_TMP"
	run_cmd "mkdir -p $MNT_TMP" || die "Falha ao criar diretório $MNT_TMP"

	# === Montar a partição EFI no diretório temporário ===
	msg "Montando a partição ${EFI_PART} em $MNT_TMP"
	if ! run_cmd "mount ${EFI_PART} $MNT_TMP"; then
		die "Não foi possível montar a partição EFI!"
	fi
	MNT_TMP_MOUNTED=true
}

create_entry_limine() {
	local dest_dir="$MNT_TMP/EFI/$NICK"

	replicate '-'
	msg "Configurando entrada UEFI para o ${yellow}Limine${reset}..."

	# Origem do .efi: pacote do sistema ou um BOOTX64.EFI do limine já presente na ESP
	if [[ -f "$LIMINE_EFI_SRC" ]]; then
		LIMINE_FILE_EFI="$LIMINE_EFI_SRC"
	else
		LIMINE_FILE_EFI=$(find "$MNT_TMP/EFI/" -maxdepth 2 -type f -iname "BOOTX64.EFI" \
			! -path "$dest_dir/*" -exec grep -l -a -i -m1 "limine" {} + 2>/dev/null | head -n1)
	fi

	if [[ -z "$LIMINE_FILE_EFI" ]]; then
		die "Nenhum .efi do Limine encontrado (${LIMINE_EFI_SRC} nem em $MNT_TMP/EFI). Instale o pacote limine."
	fi

	# Cria o diretório e copia o .efi
	run_cmd "mkdir -p $dest_dir" || die "Falha ao criar diretório $dest_dir"
	msg_tab "Copiando ${LIMINE_FILE_EFI} para ${dest_dir}/BOOTX64.EFI"
	run_cmd "cp -f ${LIMINE_FILE_EFI} ${dest_dir}/BOOTX64.EFI" ||
		die "Falha ao copiar ${LIMINE_FILE_EFI} para ${dest_dir}/BOOTX64.EFI"

	# Cria a entrada na NVRAM apontando para o .efi copiado
	msg "Criando a entrada UEFI com o efibootmgr..."
	remove_entry_by_label "$NICK"
	run_cmd "efibootmgr --quiet --create --disk $DISK --part $(get_part_num $EFI_PART) --label $NICK --loader '\\EFI\\$NICK\\BOOTX64.EFI' >/dev/null" ||
		die "Falha ao criar a entrada UEFI '$NICK'"
	log_ok_tab "Entrada ${yellow}'$NICK' ${reset}(Limine) criada com sucesso!"
}

# ===================================================================
# Modo BIOS (Legacy)
# ===================================================================
# No modo BIOS a falha é fatal; no modo UEFI (BIOS como extra) só avisa e pula
bios_fail() {
	if $BIOS_SOFT; then
		log_warn "$*"
		log_warn "Instalação BIOS ignorada (a UEFI já foi feita)."
		return 1
	fi
	die "$*"
}

get_pttype() {
	lsblk -dno PTTYPE "$1" 2>/dev/null | tr -d '[:space:]'
}

# Partição "BIOS boot" (ef02) do disco, necessária em GPT para GRUB e Limine
find_bios_boot_part() {
	lsblk -lnp -o NAME,PARTTYPE "$1" 2>/dev/null |
		awk -v g="$BIOS_BOOT_GUID" 'tolower($2)==g {print $1; exit}'
}

# Confere a tabela de partições para BIOS; em GPT devolve a partição BIOS boot
check_bios_table() {
	local disk="$1"
	local pttype bbp

	pttype=$(get_pttype "$disk")
	case "$pttype" in
	dos)
		log_ok_tab "Tabela MBR (dos) em $disk"
		BIOS_BOOT_PART=""
		;;
	gpt)
		bbp=$(find_bios_boot_part "$disk")
		if [[ -z "$bbp" ]]; then
			bios_fail "Disco GPT sem partição BIOS boot (tipo ef02).\nCrie uma de 1 MiB, ex: sgdisk -n 0:0:+1M -t 0:ef02 $disk"
			return 1
		fi
		log_ok_tab "Tabela GPT com partição BIOS boot: $bbp"
		BIOS_BOOT_PART="$bbp"
		;;
	*)
		bios_fail "$disk não tem tabela de partições (MBR ou GPT)"
		return 1
		;;
	esac
}

# Monta a raiz do disco alternativo e devolve o /boot dela em BIOS_BOOTDIR
mount_root_part() {
	[[ -b "$ROOT_PART" ]] || die "Partição raiz inválida: '${ROOT_PART}'"

	MNT_ROOT="/mnt/${APP}-root-$(date +'%H%M%S')"
	msg "Montando a partição raiz ${ROOT_PART} em $MNT_ROOT"
	run_cmd "mkdir -p $MNT_ROOT" || die "Falha ao criar diretório $MNT_ROOT"
	run_cmd "mount ${ROOT_PART} $MNT_ROOT" || die "Não foi possível montar a partição raiz!"

	# btrfs com subvolume @ (padrão do VoidBR) ou raiz comum
	if [[ -d "$MNT_ROOT/@/boot" ]]; then
		BIOS_BOOTDIR="$MNT_ROOT/@/boot"
	elif [[ -d "$MNT_ROOT/boot" ]]; then
		BIOS_BOOTDIR="$MNT_ROOT/boot"
	else
		die "Não achei o /boot em ${ROOT_PART} (procurei /boot e /@/boot)"
	fi
}

umount_root_part() {
	[[ -n "$MNT_ROOT" ]] || return 0
	msg "Desmontando a partição raiz..."
	if run_cmd "umount $MNT_ROOT"; then
		run_cmd "rmdir $MNT_ROOT"
		MNT_ROOT=""
	else
		log_warn "Não foi possível desmontar $MNT_ROOT; o diretório foi mantido."
	fi
}

install_grub_bios() {
	replicate '-'
	msg "Instalando o ${yellow}GRUB${reset} em modo ${yellow}BIOS${reset} no disco $DISK..."
	check_bios_table "$DISK" || return 0

	if $IS_ROOT_DISK; then
		BIOS_BOOTDIR="/boot"
	else
		mount_root_part
	fi

	if ! run_cmd "grub-install --target=i386-pc --boot-directory=$BIOS_BOOTDIR --recheck $DISK"; then
		$IS_ROOT_DISK || umount_root_part
		bios_fail "Falha na instalação do GRUB BIOS no disco $DISK!" || return 0
	fi
	log_ok_tab "GRUB BIOS instalado em $DISK (módulos em $BIOS_BOOTDIR/grub)"

	if [[ ! -f "$BIOS_BOOTDIR/grub/grub.cfg" ]]; then
		log_warn "Não existe $BIOS_BOOTDIR/grub/grub.cfg; gere com grub-mkconfig no sistema desse disco."
	fi

	$IS_ROOT_DISK || umount_root_part
}

install_limine_bios() {
	local dir dest_dir=""
	local num=""

	replicate '-'
	msg "Instalando o ${yellow}Limine${reset} em modo ${yellow}BIOS${reset} no disco $DISK..."
	command -v limine >/dev/null 2>&1 || { bios_fail "Comando limine não encontrado. Instale o pacote limine." || return 0; }
	[[ -f "$LIMINE_BIOS_SRC" ]] || { bios_fail "Não achei ${LIMINE_BIOS_SRC}. Instale o pacote limine." || return 0; }
	[[ -n "$EFI_PART" ]] || { bios_fail "O Limine BIOS precisa de uma partição FAT no disco (informe com --efi_part)" || return 0; }
	check_bios_table "$DISK" || return 0

	# limine-bios.sys vai para o mesmo diretório do limine.conf (boot/limine, boot, limine ou raiz)
	for dir in boot/limine boot limine .; do
		if [[ -f "$MNT_TMP/$dir/limine.conf" ]]; then
			dest_dir="$MNT_TMP/$dir"
			break
		fi
	done
	if [[ -z "$dest_dir" ]]; then
		dest_dir="$MNT_TMP/limine"
		log_warn "limine.conf não encontrado em ${EFI_PART}; crie ${dest_dir#"$MNT_TMP"}/limine.conf antes de reiniciar."
	fi
	dest_dir="${dest_dir%/.}"

	run_cmd "mkdir -p $dest_dir" || { bios_fail "Falha ao criar diretório $dest_dir" || return 0; }
	msg_tab "Copiando ${LIMINE_BIOS_SRC} para ${dest_dir}/limine-bios.sys"
	run_cmd "cp -f ${LIMINE_BIOS_SRC} ${dest_dir}/limine-bios.sys" ||
		{ bios_fail "Falha ao copiar ${LIMINE_BIOS_SRC} para ${dest_dir}" || return 0; }

	# GPT: o stage 2 vai na partição BIOS boot (número 1-based)
	[[ -n "$BIOS_BOOT_PART" ]] && num=$(get_part_num "$BIOS_BOOT_PART")
	run_cmd "limine bios-install $DISK $num" || { bios_fail "Falha no limine bios-install em $DISK!" || return 0; }
	log_ok_tab "Limine BIOS instalado em $DISK"
}

# ===================================================================
# Modo dialog
# ===================================================================
check_dialog() {
	command -v dialog >/dev/null 2>&1 || die "O dialog não está instalado (xbps-install -S dialog)"
	setup_dialog
}

# Igual ao void-install: as cores seguem o ~/.dialogrc;
# se ele não existir, é criado com o tema padrão do VoidBR.
setup_dialog() {
	[[ ! -e "$dialogRcFile" ]] && create_dialogrc

	# cabeçalho (backtitle) igual ao do void-install
	ccabec="${BOLD}${WHITE}${REVERSE}${APP} ${YELLOW}v${_VERSION_} ${BLUE}${APPURL} "
}

create_dialogrc() {
	cat >"$dialogRcFile" <<-'EOF'
		screen_color = (white,black,off)
		dialog_color = (white,black,off)
		title_color = (green,black,on)
		border_color = dialog_color
		shadow_color = (black,black,on)
		button_inactive_color = dialog_color
		button_key_inactive_color = dialog_color
		button_label_inactive_color = dialog_color
		button_active_color = (black,green,on)
		button_key_active_color = button_active_color
		button_label_active_color = (white,green,on)
		tag_key_selected_color = (white,green,on)
		item_selected_color = tag_key_selected_color
		form_text_color = (green,black,on)
		form_item_readonly_color = (cyan,black,on)
		itemhelp_color = (white,green,off)
		inputbox_color = dialog_color
		inputbox_border_color = dialog_color
		searchbox_color = dialog_color
		searchbox_title_color = title_color
		searchbox_border_color = border_color
		position_indicator_color = title_color
		menubox_color = dialog_color
		menubox_border_color = border_color
		item_color = dialog_color
		tag_color = title_color
		tag_selected_color = button_label_active_color
		tag_key_color = button_key_inactive_color
		check_color = dialog_color
		check_selected_color = button_active_color
		uarrow_color = screen_color
		darrow_color = screen_color
		form_active_text_color = button_active_color
		gauge_color = title_color
		border2_color = dialog_color
		searchbox_border2_color = dialog_color
		menubox_border2_color = dialog_color
		separate_widget = ''
		tab_len = 0
		visit_items = off
		use_shadow = off
		use_colors = on
	EOF
	export DIALOGRC="$dialogRcFile"
}

# dialog com o cabeçalho e as cores (\Z) do tema
dlg() {
	dialog --colors --backtitle "$ccabec" "$@"
}

trim() {
	local s="$1"
	s="${s#"${s%%[![:space:]]*}"}"
	s="${s%"${s##*[![:space:]]}"}"
	printf '%s' "$s"
}

dialog_msg() {
	dlg --title "${1^^}" --ok-label "OK" --msgbox "\n$2" 10 70
}

# Mapa tipo/pai de todos os dispositivos (mesma lógica do void-install)
declare -gA _kname_type=()
declare -gA _kname_pkname=()
populate_nested_lvm_map() {
	local line kn tp pk
	_kname_type=()
	_kname_pkname=()
	while IFS= read -r line; do
		[[ "$line" =~ KNAME=\"([^\"]*)\"\ TYPE=\"([^\"]*)\"\ PKNAME=\"([^\"]*)\" ]] || continue
		kn="${BASH_REMATCH[1]}"
		tp="${BASH_REMATCH[2]}"
		pk="${BASH_REMATCH[3]}"
		_kname_type["$kn"]="$tp"
		_kname_pkname["$kn"]="$pk"
	done < <(lsblk -Po KNAME,TYPE,PKNAME 2>/dev/null)
}

# LV que mora numa PARTIÇÃO de outra LV (instalação anterior em cascata) não é
# disco de verdade. LV filha direta de outra LV (pool thin) é normal e fica.
is_nested_lvm() {
	local kname="$1"
	local parent="${_kname_pkname[$kname]}"
	local grandparent depth=0

	while [[ -n "$parent" && $depth -lt 6 ]]; do
		if [[ "${_kname_type[$parent]}" == "part" ]]; then
			grandparent="${_kname_pkname[$parent]}"
			[[ "${_kname_type[$grandparent]}" == "lvm" ]] && return 0
		fi
		parent="${_kname_pkname[$parent]}"
		((depth++))
	done
	return 1
}

# Lista os discos (físicos e LVs) em colunas, no layout do void-install,
# e devolve o escolhido em stdout (status 1 = cancelado/nenhum)
dialog_select_disk() {
	local -a items=()
	local line type path size tran pttype model kname sis
	local sep="│"
	local nlen=0

	populate_nested_lvm_map

	# Sem -d: o lsblk -d não mostra LVs (elas ficam embaixo do disco físico na árvore).
	# Remove as LVs internas do thin pool e as repetidas (mesma LV aparece sob cada PV).
	while IFS= read -r line; do
		[[ "$line" =~ TYPE=\"([^\"]*)\"\ PATH=\"([^\"]*)\"\ SIZE=\"([^\"]*)\"\ TRAN=\"([^\"]*)\"\ PTTYPE=\"([^\"]*)\"\ MODEL=\"([^\"]*)\"\ KNAME=\"([^\"]*)\" ]] || continue
		type="${BASH_REMATCH[1]}"
		path="${BASH_REMATCH[2]}"
		size="${BASH_REMATCH[3]}"
		tran="${BASH_REMATCH[4]}"
		pttype="${BASH_REMATCH[5]}"
		model="${BASH_REMATCH[6]}"
		kname="${BASH_REMATCH[7]}"
		[[ "$path" == /dev/zram* ]] && continue
		[[ "$type" == "lvm" ]] && is_nested_lvm "$kname" && continue

		sis=" "
		is_root_disk "$path" && sis="*"
		((nlen < ${#path})) && nlen=${#path}
		items+=("$path" "$(printf "$sep%-4s$sep%-6s$sep%6s$sep%-6s$sep%-30s" \
			"$sis" "${tran:-$type}" "$size" "${pttype:--}" "${model:-$type device}")")
	done < <(lsblk -PAo TYPE,PATH,SIZE,TRAN,PTTYPE,MODEL,KNAME 2>/dev/null |
		grep -P 'TYPE="(disk|lvm)"' |
		grep -Pv 'PATH=".*(_tdata|-data|_tmeta|-tpool)"' |
		sort -u -t'"' -k2,2 -k4,4)

	if ((${#items[@]} == 0)); then
		dialog_msg "Discos" "Nenhum disco encontrado."
		return 1
	fi

	((nlen += 6))
	dlg --stdout \
		--default-item "$DISK" \
		--title "SELECIONE O DISCO" \
		--ok-label "Selecionar" \
		--cancel-label "Voltar" \
		--menu "Disco onde está (ou ficará) a partição EFI.  ${BOLD}${YELLOW}*${RESET} = disco do sistema\n\n\
$(printf "%${nlen}s$sep%-4s$sep%-6s$sep%6s$sep%-6s$sep%-30s" "DEVICE" "SIS" "TRAN" "SIZE" "PTTYPE" "MODEL")" \
		24 0 2 "${items[@]}"
}

# Lista os bootloaders válidos e devolve o escolhido em stdout (status 1 = Voltar)
dialog_select_bootloader() {
	local digitado="$1"
	local aviso=""

	[[ -n "$digitado" ]] && aviso="${BOLD}${RED}Bootloader inválido: '${digitado}'${RESET}\n\n"

	dlg --stdout \
		--default-item "$BOOTLOADER" \
		--title "BOOTLOADER" \
		--ok-label "Selecionar" \
		--cancel-label "Voltar" \
		--menu "${aviso}Escolha o bootloader da entrada UEFI:" 14 70 2 \
		"grub"   "GRUB 2  (grub-install / grubx64.efi)" \
		"limine" "Limine (copia o BOOTX64.EFI do pacote limine)"
}

# Lista os modos válidos e devolve o escolhido em stdout (status 1 = Voltar)
dialog_select_mode() {
	local digitado="$1"
	local aviso=""

	local -a items=()

	if is_efi_boot; then
		[[ -n "$digitado" ]] && aviso="${BOLD}${RED}Modo inválido: '${digitado}'${RESET}\n\n"
		items+=("uefi/bios" "UEFI + BIOS  (NVRAM com efibootmgr e início do disco)")
	elif [[ "$(parse_mode "$digitado")" == "uefi" ]]; then
		aviso="${BOLD}${RED}O sistema não foi iniciado em UEFI: só o modo BIOS está disponível.${RESET}\n\n"
	elif [[ -n "$digitado" ]]; then
		aviso="${BOLD}${RED}Modo inválido: '${digitado}'${RESET}\n\n"
	fi
	items+=("bios" "Só BIOS      (Legacy, gravado no início do disco)")

	dlg --stdout \
		--default-item "$(mode_label)" \
		--title "MODO" \
		--ok-label "Selecionar" \
		--cancel-label "Voltar" \
		--menu "${aviso}Escolha o modo de boot:" 14 70 2 \
		"${items[@]}"
}

# Formulário principal; repete até os campos estarem válidos
dialog_form() {
	local -a vals
	local disk efi nick boot guid mode modo_digitado rc

	disk="$DISK"
	efi="$EFI_PART"
	nick="$NICK"
	boot="$BOOTLOADER"
	mode="$MODE"
	$CHANGE_GUID && guid="s" || guid="n"

	while true; do
		mapfile -t vals < <(
			dlg --stdout --title "ENTRADA UEFI" \
				--ok-label "Continuar" --cancel-label "Sair" \
				--form "\n${BOLD}${WHITE}Deixe o ${YELLOW}Disco${WHITE} vazio para escolher numa lista.\nDeixe a ${YELLOW}Partição EFI${WHITE} vazia para detectar automaticamente.${RESET}\n" 18 72 6 \
				"Disco:"              1 1 "$disk" 1 22 44 0 \
				"Partição EFI:"       2 1 "$efi"  2 22 44 0 \
				"Nick:"               3 1 "$nick" 3 22 44 0 \
				"Bootloader:"         4 1 "$boot" 4 22 10 0 \
				"Alterar GUID (s/n):" 5 1 "$guid" 5 22 3 0 \
				"Modo:"               6 1 "$(mode_label "$mode")" 6 22 10 0
			echo "rc=$?"
		)
		rc="${vals[-1]#rc=}"
		unset 'vals[-1]'
		if [[ "$rc" != "0" ]]; then
			DIALOG_UI=false
			clear
			msg "Cancelado pelo usuário."
			exit 0
		fi

		# tira só os espaços das pontas (espaço no meio continua inválido)
		disk=$(trim "${vals[0]}")
		efi=$(trim "${vals[1]}")
		nick=$(trim "${vals[2]}")
		boot=$(trim "${vals[3],,}")
		guid=$(trim "${vals[4],,}")
		modo_digitado=$(trim "${vals[5],,}")
		mode=$(parse_mode "$modo_digitado")

		# Disco vazio: busca os discos e volta ao formulário com o escolhido
		if [[ -z "$disk" ]]; then
			disk=$(dialog_select_disk) || disk=""
			continue
		fi

		if [[ ! -b "$disk" ]] || ! is_disk "$disk"; then
			dialog_msg "Disco" "'$disk' não é um disco válido.\nUse o disco inteiro (ex: /dev/sda, /dev/nvme0n1)."
			continue
		fi
		if [[ -n "$efi" ]] && { [[ ! -b "$efi" ]] || ! is_valid_efi_fs "$efi"; }; then
			dialog_msg "Partição EFI" "'$efi' não é uma partição EFI válida (precisa ser FAT32)."
			continue
		fi
		if [[ ! "$nick" =~ ^[A-Za-z0-9._-]+$ ]]; then
			dialog_msg "Nick" "Nick inválido: '$nick'\nUse só letras, números, ponto, _ e -."
			continue
		fi
		# Bootloader vazio ou digitado errado: abre a lista dos válidos e volta ao formulário
		if [[ ! "$boot" =~ ^(grub|limine)$ ]]; then
			boot=$(dialog_select_bootloader "$boot") || boot="$BOOTLOADER"
			continue
		fi
		if [[ ! "$guid" =~ ^[sn]$ ]]; then
			dialog_msg "Alterar GUID" "Responda s ou n."
			continue
		fi
		# Modo vazio ou digitado errado: abre a lista dos válidos e volta ao formulário
		if [[ -z "$mode" ]] || { [[ "$mode" == "uefi" ]] && ! is_efi_boot; }; then
			mode=$(parse_mode "$(dialog_select_mode "$modo_digitado")") || mode=""
			[[ -z "$mode" ]] && mode="$MODE"
			continue
		fi
		break
	done

	DISK="$disk"
	if [[ -n "$efi" ]]; then
		EFI_PART="$efi"
		IS_EFI_PART_USER=true
	else
		EFI_PART=""
		IS_EFI_PART_USER=false
	fi
	NICK="$nick"
	BOOTLOADER="$boot"
	MODE="$mode"
	[[ "$guid" == "s" ]] && CHANGE_GUID=true || CHANGE_GUID=false
	return 0
}

# Confirmação final no dialog (substitui o readconf)
dialog_confirm() {
	local origem_efi="auto detectada"
	$IS_EFI_PART_USER && origem_efi="informada pelo usuário"

	if dlg --title "CONFIRMAR" \
		--yes-label "Continuar" --no-label "Cancelar" --defaultno \
		--yesno "\n\
${BOLD}${CYAN}DISCO      ${RESET} ${DISK}  [$(get_disk_info "$DISK")]\n\
${BOLD}${CYAN}ROOT_PART  ${RESET} ${ROOT_PART:-<não detectada>}\n\
${BOLD}${CYAN}EFI_PART   ${RESET} ${EFI_PART:-<não detectada>} (${origem_efi})\n\
${BOLD}${CYAN}NICK       ${RESET} ${NICK}\n\
${BOLD}${CYAN}MODO       ${RESET} $(mode_label)\n\
${BOLD}${CYAN}BOOTLOADER ${RESET} ${BOOTLOADER}\n\
${BOLD}${CYAN}CHANGE-GUID${RESET} ${CHANGE_GUID}\n\n\
${BOLD}${RED}Deseja continuar com esses parâmetros?${RESET}" 16 74; then
		DIALOG_UI=false
		clear
		msg "Continuando instalação..."
	else
		die "Instalação abortada pelo usuário."
	fi
}

usage() {
	echo -e "${yellow}Uso: ${APP} [opções]${rst}"
	echo -e "${yellow}     ${APP} --disk /dev/sdX${rst}"
	echo -e "${yellow}     ${APP} --disk /dev/sdX --efi_part /dev/sdX2 --nick UEFI${rst}"
	echo -e "${cyan}     ${APP} --disk /dev/sdX --bootloader grub --nick VoidBR${rst}"
	echo -e "${cyan}     ${APP} --disk /dev/nvme0n1 --efi_part /dev/nvme0n1p1 --bootloader limine --nick VoidBR${rst}"
	echo -e "${cyan}     ${APP} --disk /dev/sdX --mode bios --bootloader grub${rst}"
	echo -e "${cyan}     ${APP} --disk /dev/sdX --mode bios --bootloader limine${rst}"
	echo -e "${cyan}     ${APP} --dialog${rst}"
	echo
	echo -e "${yellow}Opções:${reset}"
	echo -e "   ${orange}--disk ${yellow}<dispositivo>    ${yellow}${cyan}Disco onde está a partição EFI (ex: /dev/nvme0n1)"
	echo -e "   ${orange}--efi_part ${yellow}<EFI_PART>   ${yellow}${cyan}Partição efi do disco  (ex: /dev/sda2 - padrão: autodetect)${rst}"
	echo -e "   ${orange}--nick ${yellow}<nome>           ${yellow}${cyan}Nome/label para a entrada EFI (padrão: UEFI)"
	echo -e "   ${orange}--bootloader ${yellow}<grub|limine> ${cyan}Bootloader da entrada EFI (padrão: grub)"
	echo -e "   ${orange}--mode ${yellow}<uefi/bios|bios> ${cyan}Modo de boot (padrão: detecta; uefi/bios = UEFI + BIOS, bios = só BIOS)"
	echo -e "   ${orange}--change-guid           ${yellow}${cyan}Alterar GUID da partição EFI se duplicada (padrão: Não altera)"
	echo -e "   ${orange}-D, --dialog            ${yellow}${cyan}Interface com dialog (padrão quando rodado sem argumentos)"
	echo -e "   ${orange}-V, --version           ${yellow}${cyan}Exibe a versão do app"
	echo -e "   ${orange}-h, --help              ${yellow}${cyan}Exibe esta ajuda${rst}"
	exit 1
}

# Garante que a opção recebeu valor (evita loop infinito no shift 2)
need_arg() {
	if [[ -z "$2" || "$2" == -* ]]; then
		log_err "A opção $1 precisa de um valor"
		usage
	fi
}

parse_args() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--disk)
			need_arg "$1" "$2"
			DISK="$2"
			shift 2
			;;
		--efi_part)
			need_arg "$1" "$2"
			EFI_PART="$2"
			IS_EFI_PART_USER=true
			shift 2
			;;
		--nick)
			need_arg "$1" "$2"
			# vira nome de pasta na ESP e label da NVRAM: sem espaços nem caracteres especiais
			[[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] || die "Nick inválido: '$2' (use só letras, números, ponto, _ e -)"
			NICK="$2"
			shift 2
			;;
		--bootloader)
			need_arg "$1" "$2"
			BOOTLOADER="${2,,}"
			[[ "$BOOTLOADER" =~ ^(grub|limine)$ ]] || die "Bootloader inválido: $2 (use grub ou limine)"
			shift 2
			;;
		--mode)
			need_arg "$1" "$2"
			MODE=$(parse_mode "$2")
			[[ -n "$MODE" ]] || die "Modo inválido: $2 (use uefi/bios ou bios)"
			shift 2
			;;
		--change-guid)
			CHANGE_GUID=true
			shift
			;;
		-D | --dialog)
			USE_DIALOG=true
			shift
			;;
		-h | --help)
			usage
			;;
		-V | --version)
			sh_version
			exit 0
			;;
		*)
			log_err "Parâmetro desconhecido: $1"
			usage
			;;
		esac
	done
}

# ===================================================================
# Main
# ===================================================================
main() {
	# Sem argumentos: abre o dialog (se estiver instalado)
	if [[ $# -eq 0 ]] && command -v dialog >/dev/null 2>&1; then
		USE_DIALOG=true
	fi
	parse_args "$@"
	[[ -z "$MODE" ]] && detect_mode

	# Opções da linha de comando (se houver) já vêm preenchidas no formulário
	if $USE_DIALOG; then
		check_dialog
		DIALOG_UI=true
		dialog_form
	fi

	# Entrada na NVRAM só é possível com o sistema iniciado em UEFI
	[[ "$MODE" == "uefi" ]] && verificar_uefi

	[[ -z "$DISK" ]] && die "Disco (--disk) é obrigatório. Use -h para ajuda"
	[[ ! -b "$DISK" ]] && die "$DISK não é um disco válido"

	if ! is_disk "$DISK"; then
		die "$DISK é uma partição. Passe o disco inteiro, ex: /dev/sdX ou /dev/loop0"
	fi

	if is_root_disk "$DISK"; then
		msg "Disco raiz detectado: ${yellow}${DISK}${reset}"
		ROOT_PART=$(get_root_part "$DISK")
		IS_ROOT_DISK=true
		if ! detect_root_esp; then
			# BIOS + GRUB não precisa de ESP; os outros casos precisam da FAT montada
			if [[ "$MODE" == "uefi" || "$BOOTLOADER" == "limine" ]]; then
				die "Partição FAT/ESP do disco raiz não está montada (procurei em /boot/efi, /efi e /boot). Monte-a e rode de novo."
			fi
		fi
	else
		msg "Disco alternativo detectado: ${yellow}${DISK}${reset}"
		map_dm_partitions "$DISK" || true
		detect_parts "$DISK"
		IS_ROOT_DISK=false
	fi
	confirm_parts # <- CONFIRMAÇÃO ANTES DE INSTALAR

	if [[ "$MODE" == "bios" ]]; then
		if [[ "$BOOTLOADER" == "limine" ]]; then
			[[ -n "$EFI_PART" ]] || die "O Limine BIOS precisa de uma partição FAT no disco para o limine-bios.sys e o limine.conf (informe com --efi_part)"
			if ! $IS_ROOT_DISK; then
				mount_efi_part
			fi
			install_limine_bios
		else
			install_grub_bios
		fi
		finish_main
		return 0
	fi

	if $CHANGE_GUID; then
		IS_GUID_DUPLICADO=false
		if ! check_duplicates "$EFI_PART"; then
			change_efi_guid "$DISK" "$EFI_PART" 'R'
			IS_GUID_DUPLICADO=true
		fi
	fi

	if [[ "$BOOTLOADER" == "limine" ]]; then
		if ! $IS_ROOT_DISK; then
			mount_efi_part
		fi
		create_entry_limine
	else
		check_grub_install "$DISK" "$EFI_PART"

		if ! $IS_ROOT_DISK; then
			mount_efi_part

			# === Criar o diretório onde o GRUB será instalado ===
			msg "Criando diretório $MNT_TMP/EFI/$NICK para o GRUB..."
			run_cmd "mkdir -p $MNT_TMP/EFI/$NICK" || die "Falha ao criar diretório $MNT_TMP/EFI/$NICK"

			if ! $HAS_UEFI || $IS_GUID_DUPLICADO; then
				# === Instalar o GRUB na pasta escolhida ===
				msg "Instalando GRUB no diretório $MNT_TMP/EFI/$NICK..."
				if ! run_cmd "grub-install --target=x86_64-efi --efi-directory=$MNT_TMP --bootloader-id=$NICK --recheck --root-directory=$MNT_TMP"; then
					die "Falha na instalação do GRUB UEFI!"
				fi
				log_ok "GRUB UEFI instalado com sucesso!"
			else
				# === Criar a entrada UEFI com efibootmgr ===
				create_entry_efibootmgr
			fi
		else
			# === Criar a entrada UEFI com efibootmgr ===
			create_entry_efibootmgr
		fi
	fi

	#remover entrada
	#efibootmgr -b 0011 -B

	# Modo UEFI instala também em BIOS (boot híbrido); falha no BIOS só avisa
	BIOS_SOFT=true
	if [[ "$BOOTLOADER" == "limine" ]]; then
		install_limine_bios
	else
		install_grub_bios
	fi

	finish_main
}

# Desmonta a ESP (se este script montou) e encerra
finish_main() {
	if $MNT_TMP_MOUNTED; then
		# === Desmontar a partição EFI após a instalação ===
		msg "Desmontando a partição EFI..."
		if run_cmd "umount $MNT_TMP"; then
			# Remover o diretório temporário de montagem
			# rmdir (e não rm -r): se ainda estiver montado, nunca apaga o conteúdo da ESP
			msg "Removendo o diretório temporário de montagem..."
			run_cmd "rmdir $MNT_TMP"
		else
			log_warn "Não foi possível desmontar $MNT_TMP; o diretório foi mantido."
		fi
	fi
	replicate '-'
	msg "Pronto!"
}

# ===================================================================
# Inicialização
# ===================================================================
set_varcolors
sh_checkroot "$@"
main "$@"
